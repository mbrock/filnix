#!/usr/bin/env python3
"""Judge prose readability and house style across pages, docs, blocks, and code modules.

Usage:
  scripts/prose-check FILE_OR_DIR...
  scripts/prose-check --verbose nanofil/rocq/glibc/zsys/OsWorld.v
  scripts/prose-check pages/index.html pages/explainers/index.html

Checks module preludes (.v, .pl, .nix), HTML pages (pages/), Markdown docs
(docs/, nanofil/docs/), and stream blocks (blocks/) using deterministic
structural checks plus TypeSafe's Jev System One API (POST /v1/systemone).

Detects two families of bad writing:
  1. Landing-page slop: verbless slogan fragments, portentous syntactic
     inversions, vague taglines, eyebrow labels, and CTA arrow buttons.
  2. Eyes-glaze-over prelude gibberish: verbless noun-phrase catalog openings,
     paragraphs stuffed with parenthetical lemma/identifier citations, and
     unmotivated inside-out proof/implementation plumbing.
"""

from __future__ import annotations

import argparse
from concurrent.futures import ThreadPoolExecutor
from html.parser import HTMLParser
import json
import os
from pathlib import Path
import re
import sys
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET

ENDPOINT = "https://api.typesafe.ai/v1/systemone"
MODEL = os.environ.get("TYPESAFE_MODEL", "jev-1.14.0")
FAULT_THRESHOLD = 0.65
READABILITY_FLOOR = 1.15

