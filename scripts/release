#!/usr/bin/env bash
# Tag origin/main as vYYYY.MM.DD (or .N for later releases that day) and push
# the tag; .github/workflows/release.yml then publishes the release. The
# commit's full distribution outputs must be in the public caches, beyond
# the foundation gate published by scripts/ship.
#
#   scripts/release --fleet-results FILE [TAG] [REV]
#
# REV (default origin/main) releases an earlier commit of origin/main, for a
# coherent point that later pushes have moved past.
set -euo pipefail
# shellcheck source=scripts/git-hooks/lib.sh
. "$(dirname "$0")/git-hooks/lib.sh"
cd "$filnix_root"

fleet_results=
if [ "${1:-}" = --fleet-results ] && [ $# -ge 2 ]; then
  fleet_results=$2
  shift 2
fi
[ -n "$fleet_results" ] || {
  echo "release: require --fleet-results FILE with the routine shard count and nanofil-rocq-full at the release SHA" >&2
  exit 2
}
git fetch -q --tags origin
sha=$(git rev-parse "${2:-origin/main}^{commit}")
git merge-base --is-ancestor "$sha" origin/main || {
  echo "release: ${sha:0:12} is not on origin/main" >&2
  exit 2
}
python3 scripts/nanofil-fleet verify "$fleet_results" --rev "$sha" --roots nanofil-rocq-full
tag=${1:-}
if [ -z "$tag" ]; then
  tag=v$(date -u +%Y.%m.%d)
  n=1
  while git rev-parse -q --verify "refs/tags/$tag" >/dev/null; do
    n=$((n + 1))
    tag=v$(date -u +%Y.%m.%d).$n
  done
fi
case "$tag" in v*) ;; *) echo "release: tags must start with v" >&2; exit 2 ;; esac

work=$(mktemp -d)
trap 'git worktree remove --force "$work/tree" 2>/dev/null; rm -rf "$work"' EXIT
git worktree add -q --detach "$work/tree" "$sha"
(cd "$work/tree" && python3 scripts/ci-cache-check.py) || {
  echo "release: ${sha:0:12} is not fully cached; finish distribution publication through the campaign first" >&2
  exit 1
}
# Machines switch to the release's toplevels, so the publisher keeps their
# closures in Cachix (scripts/publish-cache.py verify). Only where it runs.
publisher=/opt/filnix-cache/bin/filnix-publish-cache
if [ -x $publisher ] && sudo -n true 2>/dev/null; then
  roots=()
  for name in base demo-wiki; do
    roots+=(--extra-root "$(nix eval --raw "$work/tree#nixosConfigurations.$name.config.system.build.toplevel.outPath")")
  done
  sudo systemd-run --quiet --wait --pipe --collect -p User=filnix-cache -p Group=filnix-observe \
    -p LoadCredential=cachix.dhall:/etc/filnix-cache/cachix.dhall $publisher cachix "${roots[@]}" ||
    echo "release: could not register the toplevels with the publisher; pass them to it with --extra-root" >&2
fi
git tag -a "$tag" -m "Filnix $tag" "$sha"
git push origin "refs/tags/$tag"
echo "release: pushed $tag at ${sha:0:12}; https://github.com/mbrock/filnix/actions/workflows/release.yml"
