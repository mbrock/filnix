#!/usr/bin/env bash
# Push committed work to origin/main so that CI passes:
#
#   scripts/ship               rebase, publish the CI outputs, push
#   scripts/ship --no-publish  rebase and push; the campaign publishes later
#
# CI (.github/workflows/cache.yml) never builds Fil-C; it requires the
# outputs in scripts/ci-outputs.txt to be in the public caches. On the host
# that runs the cache publisher (swa), this builds them at the rebased
# commit, queues them with filnix-publish-cache for both caches, and waits
# until scripts/ci-cache-check.py passes before pushing. On other hosts that
# can ssh to the publisher host (FILNIX_PUBLISH_HOST, default swa.sh) and sudo
# there, it queues them with that host's publisher: igloo builds them locally
# and copies them there, and hosts that cannot build x86_64-linux, such as
# Macs, evaluate them locally and build them there. The pre-push hook
# then verifies the commits (see scripts/git-hooks/pre-push).
#
# Only commits are shipped: uncommitted changes to tracked files stop it.
set -euo pipefail
# shellcheck source=scripts/git-hooks/lib.sh
. "$(dirname "$0")/git-hooks/lib.sh"
cd "$filnix_root"

publish=1
case "${1:-}" in
  --no-publish) publish=0 ;;
  "") ;;
  *)
    sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//'
    exit 2
    ;;
esac

git config core.hooksPath scripts/git-hooks
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "ship: commit or stash changes to tracked files first; only commits are shipped" >&2
  exit 1
fi
git fetch -q origin
git rebase -q origin/main
sha=$(git rev-parse HEAD)
if [ "$sha" = "$(git rev-parse origin/main)" ]; then
  echo "ship: nothing to push"
  exit 0
fi

publisher=/opt/filnix-cache/bin/filnix-publish-cache
# Elsewhere (igloo), build here and publish through the publisher host.
publish_host=${FILNIX_PUBLISH_HOST:-swa.sh}
on=()
if [ $publish = 1 ] && { [ ! -x $publisher ] || ! sudo -n true 2>/dev/null; }; then
  if ssh -o BatchMode=yes -o ConnectTimeout=10 "$publish_host" "test -x $publisher && sudo -n true" 2>/dev/null; then
    on=(ssh -o BatchMode=yes "$publish_host")
  else
    echo "ship: no cache publisher here or on $publish_host; pushing without publishing (CI fails until a campaign publishes ${sha:0:12})" >&2
    publish=0
  fi
fi

if [ $publish = 1 ]; then
  gcroots=$(mktemp -d)
  trap 'rm -rf "$gcroots"' EXIT
  build=(nix build --print-out-paths)
  remote_build=0
  if [ ${#on[@]} -gt 0 ]; then
    # Outputs on the publisher host are rooted there until the caches have
    # them, as the out-links do here.
    remote_roots=$("${on[@]}" mktemp -d)
    trap 'rm -rf "$gcroots"; "${on[@]}" rm -rf "$remote_roots"' EXIT
    if [ "$(nix eval --impure --raw --expr builtins.currentSystem)" != x86_64-linux ]; then
      remote_build=1
      build+=(--no-link --eval-store auto --store "ssh-ng://$publish_host")
    fi
  fi
  roots=()
  i=0
  # Not a while-read loop: ssh in its body would read the remaining lines.
  mapfile -t attrs < <(grep -v -e '^#' -e '^$' scripts/ci-outputs.txt)
  for attr in "${attrs[@]}"; do
    i=$((i + 1))
    paths=()
    if [ $remote_build = 1 ]; then
      echo "ship: building $attr on $publish_host"
      out=$("${build[@]}" "git+file://$filnix_root?rev=$sha#$attr^*")
      mapfile -t paths <<<"$out"
      "${on[@]}" /nix/var/nix/profiles/default/bin/nix-store --realise --add-root "$remote_roots/$i" "${paths[@]}" >/dev/null
    else
      echo "ship: building $attr"
      # Out-links keep the outputs alive until they are published.
      out=$("${build[@]}" --out-link "$gcroots/$i" "git+file://$filnix_root?rev=$sha#$attr^*")
      mapfile -t paths <<<"$out"
    fi
    for path in "${paths[@]}"; do roots+=(--extra-root "$path"); done
  done
  if [ ${#on[@]} -gt 0 ] && [ $remote_build = 0 ]; then
    paths=()
    for ((j = 1; j < ${#roots[@]}; j += 2)); do paths+=("${roots[j]}"); done
    echo "ship: copying the outputs to $publish_host"
    # Built here, so unsigned; the publisher signs them for its caches.
    nix copy --no-check-sigs --to "ssh-ng://$publish_host" "${paths[@]}"
    "${on[@]}" /nix/var/nix/profiles/default/bin/nix-store --realise --add-root "$remote_roots/out" "${paths[@]}" >/dev/null
  fi
  for target in local cachix; do
    credential=()
    [ $target = cachix ] && credential=(-p LoadCredential=cachix.dhall:/etc/filnix-cache/cachix.dhall)
    # The publisher's timer may hold its lock; queued roots are durable, so
    # one successful run is enough and the timer finishes the upload.
    for attempt in $(seq 1 40); do
      if "${on[@]}" sudo systemd-run --quiet --wait --pipe --collect -p User=filnix-cache -p Group=filnix-observe \
        "${credential[@]}" $publisher $target --batches 32 "${roots[@]}"; then
        break
      fi
      [ "$attempt" = 40 ] && { echo "ship: could not queue roots for $target" >&2; exit 1; }
      sleep 15
    done
  done
  echo "ship: waiting for the caches"
  deadline=$((SECONDS + 3 * 3600))
  until python3 scripts/ci-cache-check.py >/dev/null; do
    [ $SECONDS -lt $deadline ] || { echo "ship: still not cached after 3 hours" >&2; exit 1; }
    sleep 30
  done
  export FILNIX_REQUIRE_CACHE=1
fi

git push origin HEAD:main
