#!/usr/bin/env bash
# Formats the staged files and fails if that changed them, so the commit is
# formatted; other files in the worktree, perhaps another agent's, are left
# alone.
set -euo pipefail
# shellcheck source=scripts/git-hooks/lib.sh
. "$(dirname "$0")/lib.sh"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=d)
[ ${#staged[@]} -gt 0 ] || exit 0
treefmt --fail-on-change --no-cache -- "${staged[@]}"
