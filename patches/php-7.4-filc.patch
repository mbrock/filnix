+#ifdef __FILC__
+/* A zend_type holds a type code or a tagged pointer to a class name or class
+ * entry. Fil-C drops a pointer's capability when it becomes an integer, so
+ * hold it as a pointer and tag with pointer arithmetic, like PHP 8's
+ * zend_type.ptr. Type codes are pointers without a capability. */
+typedef char *zend_type;
+
+#define ZEND_TYPE_BITS(t) ((uintptr_t) (t))
+
+#define ZEND_TYPE_IS_SET(t) \
+	(ZEND_TYPE_BITS(t) > Z_L(0x3))
+
+#define ZEND_TYPE_IS_CODE(t) \
+	((ZEND_TYPE_BITS(t) > Z_L(0x3)) && (ZEND_TYPE_BITS(t) <= Z_L(0x3ff)))
+
+#define ZEND_TYPE_IS_CLASS(t) \
+	(ZEND_TYPE_BITS(t) > Z_L(0x3ff))
+
+#define ZEND_TYPE_IS_CE(t) \
+	((ZEND_TYPE_BITS(t) & Z_L(0x2)) != 0)
+
+#define ZEND_TYPE_IS_NAME(t) \
+	(ZEND_TYPE_IS_CLASS(t) && !ZEND_TYPE_IS_CE(t))
+
+#define ZEND_TYPE_NAME(t) \
+	((zend_string*)((t) - (ZEND_TYPE_BITS(t) & Z_L(0x3))))
+
+#define ZEND_TYPE_CE(t) \
+	((zend_class_entry*)((t) - (ZEND_TYPE_BITS(t) & Z_L(0x3))))
+
+#define ZEND_TYPE_CODE(t) \
+	(ZEND_TYPE_BITS(t) >> Z_L(2))
+
+#define ZEND_TYPE_ALLOW_NULL(t) \
+	((ZEND_TYPE_BITS(t) & Z_L(0x1)) != 0)
+
+#define ZEND_TYPE_WITHOUT_NULL(t) \
+	((t) - (ZEND_TYPE_BITS(t) & Z_L(0x1)))
+
+#define ZEND_TYPE_ENCODE(code, allow_null) \
+	((zend_type) (((uintptr_t) (code) << Z_L(2)) | ((allow_null) ? Z_L(0x1) : Z_L(0x0))))
+
+#define ZEND_TYPE_ENCODE_CE(ce, allow_null) \
+	((char *)(ce) + ((allow_null) ? Z_L(0x3) : Z_L(0x2)))
+
+#define ZEND_TYPE_ENCODE_CLASS(class_name, allow_null) \
+	((char *)(class_name) + ((allow_null) ? Z_L(0x1) : Z_L(0x0)))
+#else
 typedef uintptr_t zend_type;
 
 #define ZEND_TYPE_IS_SET(t) \
@@ -162,6 +210,8 @@ typedef uintptr_t zend_type;
 #define ZEND_TYPE_ENCODE_CLASS(class_name, allow_null) \
 	(((uintptr_t)(class_name)) | ((allow_null) ? Z_L(0x1) : Z_L(0x0)))
 
+#endif
+
 #define ZEND_TYPE_ENCODE_CLASS_CONST_0(class_name) \
 	((zend_type) class_name)
 #define ZEND_TYPE_ENCODE_CLASS_CONST_1(class_name) \
@@ -388,6 +438,19 @@ typedef struct {
 	struct _zend_property_info *ptr[1];
 } zend_property_info_list;
 
+#ifdef __FILC__
+/* Fil-C drops a pointer's capability when the pointer becomes an integer, so
+ * tag the list pointer with pointer arithmetic instead. */
+typedef union {
+	struct _zend_property_info *ptr;
+	char *list;
+} zend_property_info_source_list;
+
+#define ZEND_PROPERTY_INFO_SOURCE_FROM_LIST(list) ((char *) (list) + 0x1)
+#define ZEND_PROPERTY_INFO_SOURCE_TO_LIST(list) \
+	((zend_property_info_list *) ((list) - ((uintptr_t) (list) & 0x1)))
+#define ZEND_PROPERTY_INFO_SOURCE_IS_LIST(list) ((uintptr_t) (list) & 0x1)
+#else
 typedef union {
 	struct _zend_property_info *ptr;
 	uintptr_t list;
@@ -396,6 +459,7 @@ typedef union {
 #define ZEND_PROPERTY_INFO_SOURCE_FROM_LIST(list) (0x1 | (uintptr_t) (list))
 #define ZEND_PROPERTY_INFO_SOURCE_TO_LIST(list) ((zend_property_info_list *) ((list) & ~0x1))
 #define ZEND_PROPERTY_INFO_SOURCE_IS_LIST(list) ((list) & 0x1)
+#endif
 
