 #define PAGE_HEADER_MASK (static_cast<size_t>(-1) - 1)
 
+// The header is the previous page with the default-page flag in bit 0. It
+// is kept as a pointer, not a size_t, so that it keeps its capability
+// under Fil-C; the flag is added and removed with pointer arithmetic.
 inline char * prev_page(char * page) {
-    size_t tagged_ptr = reinterpret_cast<size_t *>(page)[-1];
-    return reinterpret_cast<char *>(tagged_ptr & PAGE_HEADER_MASK);
+    char * tagged_ptr = reinterpret_cast<char **>(page)[-1];
+    return tagged_ptr - (reinterpret_cast<size_t>(tagged_ptr) & 1);
 }
 inline bool is_default_page(char * page) {
-    size_t tagged_ptr = reinterpret_cast<size_t *>(page)[-1];
-    return static_cast<bool>(tagged_ptr & 1);
+    char * tagged_ptr = reinterpret_cast<char **>(page)[-1];
+    return static_cast<bool>(reinterpret_cast<size_t>(tagged_ptr) & 1);
 }
 inline char * end_of_default_page(char * p) { return p + DEFAULT_PAGE_SIZE; }
 void del_pages(char * page);
