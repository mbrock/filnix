+/*
+ * Retain the manager, message, EDE context and query of an existing client,
+ * but zero everything else except the send buffer, which every response is
+ * rendered into before it is read. Zero around them in place: a compound
+ * literal of the whole client is, under Fil-C, a 7 KiB heap temporary for
+ * every query, copied with its capabilities.
+ */
+static void
+client_reuse(ns_client_t *client) {
+	ns_clientmgr_t *manager = client->manager;
+	dns_message_t *message = client->message;
+	size_t edectx_end = offsetof(ns_client_t, edectx) +
+			    sizeof(client->edectx);
+	size_t query_end = offsetof(ns_client_t, query) + sizeof(client->query);
+
+	STATIC_ASSERT(offsetof(ns_client_t, edectx) <
+				      offsetof(ns_client_t, query) &&
+			      offsetof(ns_client_t, query) <
+				      offsetof(ns_client_t, sendbuf),
+		      "client_reuse() expects edectx, query, sendbuf in order");
+
+	memset(client, 0, offsetof(ns_client_t, edectx));
+	memset((char *)client + edectx_end, 0,
+	       offsetof(ns_client_t, query) - edectx_end);
+	memset((char *)client + query_end, 0,
+	       offsetof(ns_client_t, sendbuf) - query_end);
+	client->manager = manager;
+	client->message = message;
+}
