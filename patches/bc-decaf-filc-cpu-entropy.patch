spongerng's CPU entropy probe saves %rbx around cpuid by hand for PIC,
which FilPizlonator rejects (cpuid's ebx output is not covered by a
constraint), so every nondeterministic RNG read trapped. Fil-C accepts the
plain "=b" form. Fil-C also cannot lower __builtin_readcyclecounter, while
the rdtsc asm fallback works.

diff --git a/src/spongerng.c b/src/spongerng.c
index c44d446..c18f018 100644
--- a/src/spongerng.c
+++ b/src/spongerng.c
@@ -47,7 +47,7 @@ static void get_cpu_entropy(uint8_t *entropy, size_t len) {
         __asm__("mov %%ebx, %[not_ebx]\n\t"
                 "cpuid\n\t"
                 "xchg %%ebx, %[not_ebx]" : "=a"(a), [not_ebx]"=r"(b), "=c"(c), "=d"(d) : "0"(1));
-#elif defined(__x86_64__) && defined(__PIC__)
+#elif defined(__x86_64__) && defined(__PIC__) && !defined(__FILC__)
         /* Don't clobber rbx.  The compiler doesn't like when when __PIC__ */
         uint64_t b64;
         __asm__("mov %%rbx, %[not_rbx]\n\t"
@@ -81,7 +81,7 @@ static void get_cpu_entropy(uint8_t *entropy, size_t len) {
 #ifndef __has_builtin
 #define __has_builtin(X) 0
 #endif
-#if defined(__clang__) && __has_builtin(__builtin_readcyclecounter)
+#if defined(__clang__) && __has_builtin(__builtin_readcyclecounter) && !defined(__FILC__)
         *(uint64_t*) entropy ^= __builtin_readcyclecounter();
 #elif defined(__x86_64__)
         uint32_t lobits, hibits;
diff --git a/test/bench_decaf.cxx b/test/bench_decaf.cxx
index 7c04ef6..9298199 100644
--- a/test/bench_decaf.cxx
+++ b/test/bench_decaf.cxx
@@ -52,7 +52,7 @@ static double now(void) {
 #ifndef __has_builtin
 #define __has_builtin(X) 0
 #endif
-#if defined(__clang__) && __has_builtin(__builtin_readcyclecounter)
+#if defined(__clang__) && __has_builtin(__builtin_readcyclecounter) && !defined(__FILC__)
 #define rdtsc __builtin_readcyclecounter
 #else
 static inline uint64_t rdtsc(void) {
