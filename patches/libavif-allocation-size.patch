Reject objects larger than PTRDIFF_MAX before calling the allocator. Such
objects cannot support C pointer differences; Fil-C traps on these impossible
requests rather than returning NULL. Preserve libavif's allocation-failure
contract and its existing extreme-size test, adding a boundary check.

--- a/src/mem.c
+++ b/src/mem.c
@@ -3,6 +3,7 @@
 
 #include "avif/avif.h"
 
+#include <stdint.h>
 #include <stdlib.h>
 
 void * avifAlloc(size_t size)
@@ -14,6 +15,9 @@
     if (size == 0) {
         return NULL;
     }
+    if (size > PTRDIFF_MAX) {
+        return NULL;
+    }
     return malloc(size);
 }
 
--- a/tests/gtest/avifallocationtest.cc
+++ b/tests/gtest/avifallocationtest.cc
@@ -203,6 +203,7 @@
   void* p1 = avifAlloc(1);
   EXPECT_NE(p1, nullptr);
   avifFree(p1);
 
+  EXPECT_EQ(avifAlloc(static_cast<size_t>(PTRDIFF_MAX) + 1), nullptr);
   EXPECT_EQ(avifAlloc(std::numeric_limits<size_t>::max()), nullptr);
 }
