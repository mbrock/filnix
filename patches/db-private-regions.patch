diff --git a/src/dbinc/region.h b/src/dbinc/region.h
index acba84c..d64f951 100644
--- a/src/dbinc/region.h
+++ b/src/dbinc/region.h
@@ -293,16 +293,29 @@ struct __db_reginfo_t {		/* __env_region_attach IN parameters. */
 	u_int32_t   flags;
 };
 
+/*
+ * ENV_HEAP_REGIONS --
+ *	Whether regions use the process-private heap layout, in which every
+ *	allocation is a separate malloc, offsets are pointers stored as
+ *	integers and mutex IDs are mutex addresses.
+ *
+ * Fil-C: an integer cast back to a pointer has no capability, and a shared
+ * queue offset from one malloc'd object cannot reach another.  Give private
+ * environments the shared-memory layout instead: each region is a single
+ * heap block, addressed by offsets from its base.
+ */
+#define	ENV_HEAP_REGIONS(env)	0
+
 /*
  * R_ADDR	Return a per-process address for a shared region offset.
  * R_OFFSET	Return a shared region offset for a per-process address.
  */
 #define	R_ADDR(reginfop, offset)					\
-	(F_ISSET((reginfop)->env, ENV_PRIVATE) ?			\
+	(ENV_HEAP_REGIONS((reginfop)->env) ?			\
 	    ROFF_TO_P(offset) :						\
 	    (void *)((u_int8_t *)((reginfop)->addr) + (offset)))
 #define	R_OFFSET(reginfop, p)						\
-	(F_ISSET((reginfop)->env, ENV_PRIVATE) ?			\
+	(ENV_HEAP_REGIONS((reginfop)->env) ?			\
 	    P_TO_ROFF(p) :						\
 	    (roff_t)((u_int8_t *)(p) - (u_int8_t *)(reginfop)->addr))
 
