+/* Fil-C keeps pointer capabilities only in pointer-aligned memory. Pad every
+ * entry, including byte opcodes and integer blocks, so memcpy can preserve
+ * pointers in subsequent entries. Counts and saved stack positions stay in
+ * bytes; only the storage occupied by each entry changes.
+ */
+Py_LOCAL_INLINE(size_t) ByteStack_entry_size(size_t count) {
+#ifdef __FILC__
+    return (count + sizeof(void*) - 1) & ~(sizeof(void*) - 1);
+#else
+    return count;
+#endif
+}
