         self.assertEqual(regex.match("a.*b", "a\n\nb", regex.DOTALL)[0],
           "a\n\nb")
 
+    def test_backtracking_stack_alignment(self):
+        # Mix byte opcodes, integer fields and pointer-bearing records. Greedy
+        # repeats must give back an 'a', while lazy repeats must grow to it.
+        # The long input grows the stack; the next match reuses cached storage.
+        for pattern, tail in [(r"(?:x|y)(a*)ab", "b"),
+          (r"(?:x|y)(a*?)ab", "b"),
+          (r"(?:x|y)((?:a|ab)*)ac", "c")]:
+            compiled = regex.compile(pattern)
+            for count in (3, 4096, 4):
+                text = "x" + "a" * count + tail
+                with self.subTest(pattern=pattern, count=count):
+                    match = compiled.fullmatch(text)
+                    self.assertIsNotNone(match)
+                    self.assertEqual(match.span(), (0, count + 2))
+                    self.assertEqual(match.span(1), (1, count))
+                    self.assertEqual(match.group(1), "a" * (count - 1))
+                    self.assertIsNone(compiled.fullmatch(text[:-1] + "d"))
+
     def test_non_consuming(self):
         self.assertEqual(regex.match(r"(a(?=\s[^a]))", "a b")[1], 'a')
         self.assertEqual(regex.match(r"(a(?=\s[^a]*))", "a b")[1], 'a')
