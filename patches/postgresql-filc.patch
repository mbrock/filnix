diff --git a/src/include/lib/sort_template.h b/src/include/lib/sort_template.h
index 11e136c..c4ae66e 100644
--- a/src/include/lib/sort_template.h
+++ b/src/include/lib/sort_template.h
@@ -281,8 +281,32 @@ ST_SWAP(ST_POINTER_TYPE * a, ST_POINTER_TYPE * b)
 static inline void
 ST_SWAPN(ST_POINTER_TYPE * a, ST_POINTER_TYPE * b, size_t n)
 {
+#ifdef __FILC__
+	/*
+	 * Swapped byte by byte, each pointer in an element would keep its old
+	 * capability with the other element's address, which Fil-C refuses.
+	 * memcpy moves whole pointers with their capabilities.
+	 */
+	char		tmp[64] __attribute__((aligned(16)));
+	char	   *pa = (char *) a;
+	char	   *pb = (char *) b;
+	size_t		left = n * sizeof(*a);
+
+	while (left > 0)
+	{
+		size_t		k = left < sizeof(tmp) ? left : sizeof(tmp);
+
+		memcpy(tmp, pa, k);
+		memcpy(pa, pb, k);
+		memcpy(pb, tmp, k);
+		pa += k;
+		pb += k;
+		left -= k;
+	}
+#else
 	for (size_t i = 0; i < n; ++i)
 		ST_SWAP(&a[i], &b[i]);
+#endif
 }
 
