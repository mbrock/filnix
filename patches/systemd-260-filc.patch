@@ -20,6 +21,10 @@ int reset_all_signal_handlers(void) {
                 if (IN_SET(sig, SIGKILL, SIGSTOP))
                         continue;
 
+                /* Fil-C's runtime owns these signals and refuses to let them be reset. */
