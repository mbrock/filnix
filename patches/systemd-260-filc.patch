+#endif
 #include <sys/mman.h>
 
 #include "memory-util.h"
@@ -125,6 +128,14 @@ void sigbus_install(void) {
         * it is not guaranteed to be async-signal-safe since POSIX.1-2008 */
         (void) page_size();
 
+#ifdef __FILC__
+        /* Fil-C's runtime owns SIGBUS: sigaction() fails with ENOSYS, and the handler's MAP_FIXED
