 #include <stdint.h>
+#include <sys/reboot.h>
 #include <sys/syscall.h>
 #include <unistd.h>
 
@@ -28,7 +29,18 @@
 #include "virt.h"
 
 int raw_reboot(int cmd, const void *arg) {
+#ifdef __FILC__
+        /* Fil-C's syscall() stops the program on reboot. glibc's reboot() takes no argument, so with
+         * one (LINUX_REBOOT_CMD_RESTART2's string) report ENOSYS; the callers fall back to plain
+         * reboot(). */
+        if (arg) {
+                errno = ENOSYS;
+                return -1;
+        }
+        return reboot(cmd);
+#else
         return syscall(SYS_reboot, LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2, cmd, arg);
+#endif
 }
 
