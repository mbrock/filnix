diff --git a/src/basic/raw-clone.c b/src/basic/raw-clone.c
index 5f56017..fbfa1e0 100644
--- a/src/basic/raw-clone.c
+++ b/src/basic/raw-clone.c
@@ -6,6 +6,8 @@
 
 #include <errno.h>                      /* IWYU pragma: keep */
 #include <sched.h>
+#include <signal.h>
+#include <stdlib.h>
 #include <sys/syscall.h>                /* IWYU pragma: keep */
 #include <unistd.h>
 
@@ -73,6 +75,23 @@ pid_t raw_clone(unsigned long flags) {
                 } else
                         ret = in_child ? 0 : child_pid;
         }
+#elif defined(__FILC__)
+        /* Fil-C's syscall() stops the program on clone, and a raw clone would bypass the runtime's
+         * fork handling anyway. So fork(), then move the child into the new namespaces with
+         * unshare(). A child cannot become PID 1 of a new PID namespace that way: refuse
+         * CLONE_NEWPID. */
+        {
+                const unsigned long ns = CLONE_NEWNS|CLONE_NEWUSER|CLONE_NEWNET|CLONE_NEWIPC|CLONE_NEWUTS|CLONE_NEWCGROUP;
+
+                if ((flags & CSIGNAL) != SIGCHLD || (flags & ~(ns|CSIGNAL)) != 0) {
+                        errno = EOPNOTSUPP;
+                        return -1;
+                }
+
+                ret = fork();
+                if (ret == 0 && (flags & ns) != 0 && unshare((int) (flags & ns)) < 0)
+                        _exit(EXIT_FAILURE);
+        }
 #else
         ret = (pid_t) syscall(__NR_clone, flags, NULL);
 #endif
diff --git a/src/basic/sigbus.c b/src/basic/sigbus.c
