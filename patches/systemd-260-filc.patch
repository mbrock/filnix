+#ifdef __FILC__
+/* Fil-C's glibc stops the program in pidfd_spawn() ("assertion !use_pidfd failed" in __spawnix())
+ * rather than returning an error, so use the posix_spawn() path. */
+#  undef HAVE_PIDFD_SPAWN
