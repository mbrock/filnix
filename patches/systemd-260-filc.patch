--- a/src/shared/osc-context.c
+++ b/src/shared/osc-context.c
@@ -103,7 +103,11 @@ static void osc_context_default_id(sd_id128_t *ret_id) {
 
         assert(ret_id);
 
+#ifndef __FILC__
+        /* Under Fil-C, getauxval() returns AT_RANDOM's address as a plain integer, which cannot be
+         * dereferenced. The pid and pidfd ID still identify the process. */
         memcpy(data.auxval, ULONG_TO_PTR(getauxval(AT_RANDOM)), sizeof(data.auxval));
+#endif
         (void) pidfd_get_inode_id_self_cached(&data.pidfdid);
 
         *ret_id = id128_digest(&data, sizeof(data));
