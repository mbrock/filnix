  */
@@ -1330,6 +1337,12 @@ pid_t clone_with_nested_stack(int (*fn)(void *), int flags, void *userdata) {
          * forwards we'll allocate one more and place the stack address in the middle. Except that we also
          * want it page aligned, hence we'll allocate one page more. Makes 3. */
 
+#ifdef __FILC__
+        /* glibc's clone() stops a Fil-C program ("clone not implemented"). Callers fall back to doing
+         * the work themselves. */
+        return -ENOSYS;
