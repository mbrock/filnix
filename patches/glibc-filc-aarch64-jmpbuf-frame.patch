Subject: aarch64: identify jmp_buf frames through the Fil-C runtime
Origin: Filnix
Upstream-Status: Not yet submitted to pizlonator/fil-c

Upstream ported x86_64/jmpbuf-unwind.h to zget_jmp_buf_frame, but
aarch64 still read JB_SP, which Fil-C does not store. Forced unwinding
then reached a pthread_cleanup_push frame before inner C++ frames and
ran cleanups out of order.

diff -ru a/sysdeps/aarch64/jmpbuf-offsets.h b/sysdeps/aarch64/jmpbuf-offsets.h
--- a/sysdeps/aarch64/jmpbuf-offsets.h	2026-09-27 20:12:59.246454618 +0200
+++ b/sysdeps/aarch64/jmpbuf-offsets.h	2026-09-27 20:13:08.046553805 +0200
@@ -106,13 +106,15 @@
 #include <stdint.h>
 #include <sysdep.h>
 #include <pointer_guard.h>
+#include <stdfil.h>
 
+/* Fil-C's jmp_buf does not hold a machine stack pointer. Identify the
+   frame as x86_64/jmpbuf-unwind.h does, so forced unwinding compares it
+   with the unwinder's CFA. */
 static inline uintptr_t __attribute__ ((unused))
 _jmpbuf_sp (__jmp_buf jmpbuf)
 {
-  uintptr_t sp = jmpbuf[JB_SP];
-  PTR_DEMANGLE (sp);
-  return sp;
+  return (uintptr_t) zget_jmp_buf_frame (jmpbuf);
 }
 #endif
 
