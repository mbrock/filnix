@@ -570,7 +570,16 @@ void lttng_ust_dl_update(void *ip)
 	 * done in the iteration over libraries, and sweeping is
 	 * performed by iter_end().
 	 */
+#ifdef __FILC__
+	/*
+	 * Fil-C provides no dl_iterate_phdr: program headers and raw
