Subject: Handle pointer-valued GTypes in signal defs and container traits
Origin: Filnix
Upstream-Status: Not submitted

generate_extra_defs strips G_SIGNAL_TYPE_STATIC_SCOPE from signal return
and parameter types with integer AND. GType is a pointer under Fil-C GLib,
so that does not compile, and an integer round trip would drop the type's
capability. Clear the bit with stdfil's zandptr instead.

Container_Helpers::TypeTraits has a partial specialization for T*, meant
for GObject wrapper pointers. A pointer GType matches it, so consumers
converting GType arrays (gtkmm 4's Gdk::ContentFormats) fail on
T::BaseObjectType. Add an identity TypeTraits<GType> for Fil-C.

The patch is Fil-C only; the rest of glibmm builds against pointer GTypes.

diff --git a/tools/extra_defs_gen/generate_extra_defs.cc b/tools/extra_defs_gen/generate_extra_defs.cc
index 23300c8..1cdb66e 100644
--- a/tools/extra_defs_gen/generate_extra_defs.cc
+++ b/tools/extra_defs_gen/generate_extra_defs.cc
@@ -20,6 +20,8 @@
 #include <algorithm>
 #include <regex>
 #include <sstream>
+#include <cstdint>
+#include <stdfil.h>
 
 namespace
 {
@@ -34,6 +36,14 @@ void add_signal_flag_if(std::string& strFlags, const char* strFlag,
   }
 }
 
+// Signal types are mangled with G_SIGNAL_TYPE_STATIC_SCOPE. GType is a
+// pointer under Fil-C, so clear the flag with a capability-preserving mask.
+GType unmangle_signal_type(GType gtype)
+{
+  return static_cast<GType>(
+    zandptr(gtype, ~static_cast<unsigned long>((uintptr_t)G_SIGNAL_TYPE_STATIC_SCOPE)));
+}
+
 } // anonymous namespace
 
 std::string
@@ -269,7 +279,7 @@ get_signals(GType gtype, GTypeIsAPointerFunc is_a_pointer_func)
 
       // Return type:
       std::string strReturnTypeName =
-        get_type_name_signal(signalQuery.return_type & ~G_SIGNAL_TYPE_STATIC_SCOPE,
+        get_type_name_signal(unmangle_signal_type(signalQuery.return_type),
           is_a_pointer_func); // The type is mangled with a flag. Hacky.
       // bool bReturnTypeHasStaticScope = (signalQuery.return_type & G_SIGNAL_TYPE_STATIC_SCOPE) ==
       // G_SIGNAL_TYPE_STATIC_SCOPE;
@@ -312,7 +322,7 @@ get_signals(GType gtype, GTypeIsAPointerFunc is_a_pointer_func)
 
           // Just like above, for the return type:
           std::string strTypeName =
-            get_type_name_signal(typeParamMangled & ~G_SIGNAL_TYPE_STATIC_SCOPE,
+            get_type_name_signal(unmangle_signal_type(typeParamMangled),
               is_a_pointer_func); // The type is mangled with a flag. Hacky.
           // bool bTypeHasStaticScope = (typeParamMangled & G_SIGNAL_TYPE_STATIC_SCOPE) ==
           // G_SIGNAL_TYPE_STATIC_SCOPE;
diff --git a/glib/glibmm/containerhandle_shared.h b/glib/glibmm/containerhandle_shared.h
index e8bfd7b..8887743 100644
--- a/glib/glibmm/containerhandle_shared.h
+++ b/glib/glibmm/containerhandle_shared.h
@@ -282,6 +282,26 @@ struct TypeTraits<bool>
   static void release_c_type(CType) {}
 };
 
+#ifdef __FILC__
+/** Specialization for GType.
+ * Fil-C GLib makes GType a pointer to an opaque struct, which would
+ * otherwise select the GObject pointer specialization above. GTypes are
+ * plain values, so convert them unchanged.
+ * @ingroup ContHelpers
+ */
+template <>
+struct TypeTraits<GType>
+{
+  using CppType = GType;
+  using CType = GType;
+  using CTypeNonConst = GType;
+
+  static CType to_c_type(CppType item) { return item; }
+  static CppType to_cpp_type(CType item) { return item; }
+  static void release_c_type(CType) {}
+};
+#endif
+
 /** Specialization for Glib::VariantBase.
  * @ingroup ContHelpers
  */
