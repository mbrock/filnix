diff --git a/libpas/src/libpas/filc_cancel_syscall.S b/libpas/src/libpas/filc_cancel_syscall.S
new file mode 100644
index 000000000000..fe908466c636
--- /dev/null
+++ b/libpas/src/libpas/filc_cancel_syscall.S
@@ -0,0 +1,42 @@
+/* The final request check and syscall instruction must share one PC window.
+   In particular, the instruction immediately after syscall is outside it:
+   Linux resumes there when returning a completed/partial result, and at the
+   syscall instruction when restarting an interrupted operation. */
+#if defined(__x86_64__)
+    .text
+    .p2align 4
+    .globl filc_cancel_syscall
+    .hidden filc_cancel_syscall
+    .type filc_cancel_syscall,@function
+filc_cancel_syscall:
+    .cfi_startproc
+    .globl filc_cancel_syscall_begin
+    .hidden filc_cancel_syscall_begin
+filc_cancel_syscall_begin:
+    movl (%rdi), %eax
+    andl $25, %eax                /* pending, enabled, not exiting */
+    cmpl $8, %eax
+    je filc_cancel_syscall_abort
+    movq %rsi, %rax               /* syscall number */
+    movq %rdx, %rdi               /* argument 1 */
+    movq %rcx, %rsi               /* argument 2 */
+    movq %r8, %rdx                /* argument 3 */
+    movq %r9, %r10                /* argument 4 */
+    movq 8(%rsp), %r8             /* argument 5 */
+    movq 16(%rsp), %r9            /* argument 6 */
+    syscall
+    .globl filc_cancel_syscall_end
+    .hidden filc_cancel_syscall_end
+filc_cancel_syscall_end:
+    xorl %edx, %edx               /* result.canceled = false */
+    ret
+    .globl filc_cancel_syscall_abort
+    .hidden filc_cancel_syscall_abort
+filc_cancel_syscall_abort:
+    xorl %eax, %eax               /* no kernel result */
+    movl $1, %edx                 /* result.canceled = true */
+    ret
+    .cfi_endproc
+    .size filc_cancel_syscall, .-filc_cancel_syscall
+    .section .note.GNU-stack,"",@progbits
+#endif
diff --git a/libpas/src/libpas/filc_cancel_syscall.h b/libpas/src/libpas/filc_cancel_syscall.h
new file mode 100644
index 000000000000..f68dedc2ffcf
--- /dev/null
+++ b/libpas/src/libpas/filc_cancel_syscall.h
@@ -0,0 +1,28 @@
+/* Native Linux cancellation gate. The signal handler may redirect execution
+   from [filc_cancel_syscall_begin, filc_cancel_syscall_end) to
+   filc_cancel_syscall_abort. All paths return normally to the native caller.
+   The gate never invokes Fil-C or unwinds a native signal frame. */
+#ifndef FILC_CANCEL_SYSCALL_H
+#define FILC_CANCEL_SYSCALL_H
+
+#ifndef __ASSEMBLER__
+typedef struct {
+    long value;
+    long canceled;
+} filc_cancel_syscall_result;
+
+/* State bits match the glibc cancellation control word. Other bits are ignored.
+   This is an internal native interface, not an unchecked Fil-C syscall API. */
+#define FILC_CANCEL_DISABLED 1u
+#define FILC_CANCEL_ASYNC 2u
+#define FILC_CANCEL_PENDING 8u
+#define FILC_CANCEL_EXITING 16u
+
+extern filc_cancel_syscall_result filc_cancel_syscall(
+    const unsigned* state, long number,
+    long arg1, long arg2, long arg3, long arg4, long arg5, long arg6);
+extern const char filc_cancel_syscall_begin[], filc_cancel_syscall_end[];
+extern const char filc_cancel_syscall_abort[];
+#endif
+
+#endif
