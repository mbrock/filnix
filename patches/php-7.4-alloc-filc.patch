-#if ZEND_MM_CUSTOM
+#if defined(__FILC__) && ZEND_MM_CUSTOM
+/* PHP 7.4's tracked allocator only remembers addresses, so it has no
+ * memory_limit and memory_get_usage() reports 0. It is the default here, so
+ * keep each allocation's size as PHP 8 does and enforce the limit, and also
+ * record peaks for memory_get_peak_usage(). */
+static zval *tracked_find(zend_mm_heap *heap, const void *ptr)
+{
+	if (heap->custom_heap.std._malloc != tracked_malloc) {
+		return NULL;
+	}
+	return zend_hash_index_find(heap->tracked_allocs, ((uintptr_t) ptr) >> ZEND_MM_ALIGNMENT_LOG2);
+}
+
+static void tracked_add(zend_mm_heap *heap, void *ptr, size_t size)
+{
+	zval size_zv;
+	ZVAL_LONG(&size_zv, size);
+	zend_hash_index_add_new(heap->tracked_allocs, ((uintptr_t) ptr) >> ZEND_MM_ALIGNMENT_LOG2, &size_zv);
+#if ZEND_MM_STAT
+	heap->size += size;
+	heap->real_size = heap->size;
+	if (heap->size > heap->peak) {
+		heap->peak = heap->real_peak = heap->size;
+	}
+#endif
+}
+
+static void tracked_remove(zend_mm_heap *heap, zval *size_zv)
+{
+#if ZEND_MM_STAT
+	heap->size -= Z_LVAL_P(size_zv);
+	heap->real_size = heap->size;
+#endif
+	zend_hash_del_bucket(heap->tracked_allocs, (Bucket *) size_zv);
+}
+
+static void tracked_check_limit(zend_mm_heap *heap, size_t add_size)
+{
+#if ZEND_MM_LIMIT
+	if (add_size > heap->limit - heap->size && !heap->overflow) {
+#if ZEND_DEBUG
+		zend_mm_safe_error(heap,
+			"Allowed memory size of %zu bytes exhausted at %s:%d (tried to allocate %zu bytes)",
+			heap->limit, "file", 0, add_size);
+#else
+		zend_mm_safe_error(heap,
+			"Allowed memory size of %zu bytes exhausted (tried to allocate %zu bytes)",
+			heap->limit, add_size);
+#endif
+	}
+#endif
+}
+
+static void *tracked_malloc(size_t size)
+{
+	zend_mm_heap *heap = AG(mm_heap);
+	void *ptr;
+
+	tracked_check_limit(heap, size);
+	ptr = __zend_malloc(size);
+	tracked_add(heap, ptr, size);
+	return ptr;
+}
+
+static void tracked_free(void *ptr)
+{
+	zend_mm_heap *heap = AG(mm_heap);
+	zval *size_zv;
+
+	if (!ptr) {
+		return;
+	}
+	size_zv = tracked_find(heap, ptr);
+	ZEND_ASSERT(size_zv && "Trying to free pointer not allocated through ZendMM");
+	tracked_remove(heap, size_zv);
+	free(ptr);
+}
+
+static void *tracked_realloc(void *ptr, size_t new_size)
+{
+	zend_mm_heap *heap = AG(mm_heap);
+	zval *old_size_zv = NULL;
+	size_t old_size = 0;
+
+	if (ptr) {
+		old_size_zv = tracked_find(heap, ptr);
+		ZEND_ASSERT(old_size_zv && "Trying to reallocate pointer not allocated through ZendMM");
+		old_size = Z_LVAL_P(old_size_zv);
+	}
+	if (new_size > old_size) {
+		tracked_check_limit(heap, new_size - old_size);
+	}
+	/* Forget the old allocation only after checking the memory limit. */
+	if (old_size_zv) {
+		tracked_remove(heap, old_size_zv);
+	}
+	ptr = __zend_realloc(ptr, new_size);
+	tracked_add(heap, ptr, new_size);
+	return ptr;
+}
+
+static void tracked_free_all()
+{
+	/* The keys are addresses, and an integer cast back to a pointer has no
+	 * capability, so free() would trap. Fil-C's collector reclaims the
+	 * request's leftover allocations once nothing refers to them. */
+}
+#elif ZEND_MM_CUSTOM
