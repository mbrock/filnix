Two Fil-C problems in the x86_64 code:

- spongerng's CPU entropy probe saves %rbx around cpuid by hand for PIC,
  which FilPizlonator rejects (cpuid's ebx output is not covered by a
  constraint), so every nondeterministic RNG read trapped. Fil-C accepts
  the plain "=b" form. It also cannot lower __builtin_readcyclecounter,
  while the rdtsc asm fallback works.
- The arch_x86_64 field arithmetic uses inline asm with memory operands,
  which Fil-C does not support. Use the portable arch_ref64 code.

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 1ad102a..a688cd8 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -39,9 +39,18 @@ set(TARGET_ARCH_DIR_P448 arch_32)
 
 if((${CMAKE_SYSTEM_PROCESSOR} MATCHES "x86_64" OR ${CMAKE_SYSTEM_PROCESSOR} MATCHES "amd64") AND NOT MSVC)#Decaf doesn't support 64bits on MSVC yet
 	message("Target architecture is x86_64")
-	set(TARGET_ARCH_DIR arch_x86_64)
-	set(TARGET_ARCH_DIR_P25519 arch_x86_64)
-	set(TARGET_ARCH_DIR_P448 arch_x86_64)
+	include(CheckSymbolExists)
+	check_symbol_exists(__FILC__ "" DECAF_FILC)
+	if(DECAF_FILC)
+		# Fil-C rejects the field arithmetic's inline asm with memory operands.
+		set(TARGET_ARCH_DIR arch_ref64)
+		set(TARGET_ARCH_DIR_P25519 arch_ref64)
+		set(TARGET_ARCH_DIR_P448 arch_ref64)
+	else()
+		set(TARGET_ARCH_DIR arch_x86_64)
+		set(TARGET_ARCH_DIR_P25519 arch_x86_64)
+		set(TARGET_ARCH_DIR_P448 arch_x86_64)
+	endif()
 elseif(${CMAKE_SYSTEM_PROCESSOR} MATCHES "arch64") # shall be arm64 bits, stick to ref64.
 	message("Target architecture is 64 bits general purpose(arm64 shall use this)")
 	set(TARGET_ARCH_DIR arch_ref64)
diff --git a/src/spongerng.c b/src/spongerng.c
index c44d446..c18f018 100644
--- a/src/spongerng.c
+++ b/src/spongerng.c
@@ -47,7 +47,7 @@ static void get_cpu_entropy(uint8_t *entropy, size_t len) {
         __asm__("mov %%ebx, %[not_ebx]\n\t"
                 "cpuid\n\t"
                 "xchg %%ebx, %[not_ebx]" : "=a"(a), [not_ebx]"=r"(b), "=c"(c), "=d"(d) : "0"(1));
-#elif defined(__x86_64__) && defined(__PIC__)
+#elif defined(__x86_64__) && defined(__PIC__) && !defined(__FILC__)
         /* Don't clobber rbx.  The compiler doesn't like when when __PIC__ */
         uint64_t b64;
         __asm__("mov %%rbx, %[not_rbx]\n\t"
@@ -81,7 +81,7 @@ static void get_cpu_entropy(uint8_t *entropy, size_t len) {
 #ifndef __has_builtin
 #define __has_builtin(X) 0
 #endif
-#if defined(__clang__) && __has_builtin(__builtin_readcyclecounter)
+#if defined(__clang__) && __has_builtin(__builtin_readcyclecounter) && !defined(__FILC__)
         *(uint64_t*) entropy ^= __builtin_readcyclecounter();
 #elif defined(__x86_64__)
         uint32_t lobits, hibits;
