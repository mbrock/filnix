+/*
+ * Set REMOVED_FLAG with a pointer-typed compare-and-swap loop rather than
+ * an integer uatomic_or: under Fil-C, atomic pointer loads of the word
+ * (uatomic_load, rcu_dereference) do not see an integer atomic's update,
+ * so the flag appeared unset.
+ */
+static
+void set_removed_flag(struct cds_lfht_node **next)
+{
+	struct cds_lfht_node *old_next, *ret_next;
+
+	old_next = uatomic_load(next);
+	for (;;) {
+		ret_next = uatomic_cmpxchg(next, old_next,
+			flag_removed(old_next));
+		if (ret_next == old_next)
+			break;
+		old_next = ret_next;
+	}
+}
