  * so no benefit in data structure padding and applying packed saves the space in the buffer  */
+#ifdef __FILC__
+/* Fil-C loads a pointer only from an 8-byte-aligned address, and bulkStrRef
+ * keeps a robj pointer in the buffer, so there every chunk starts aligned. */
+#define REPLY_PAYLOAD_ALIGN 8
+typedef struct payloadHeader {
+    size_t payload_len;   /* payload length in a reply buffer */
+    uint8_t payload_type; /* one of payloadType */
+} payloadHeader;
+#else
+#define REPLY_PAYLOAD_ALIGN 1
 typedef struct __attribute__((__packed__)) payloadHeader {
     size_t payload_len;   /* payload length in a reply buffer */
     uint8_t payload_type; /* one of payloadType */
 } payloadHeader;
+#endif
+/* Space a payload of `len` bytes takes in an encoded buffer, after its header. */
+#define REPLY_PAYLOAD_SPACE(len) \
+    (((size_t)(len) + REPLY_PAYLOAD_ALIGN - 1) & ~(size_t)(REPLY_PAYLOAD_ALIGN - 1))
 static_assert(offsetof(payloadHeader, payload_len) == 0, "payload_len must be at offset 0 to avoid unaligned access");
 
