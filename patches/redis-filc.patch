+/* Some tables use client pointers as parts of rax keys, that is, as bytes.
+ * Under Fil-C a pointer read back from bytes has no capability, so clients
+ * are registered in an exact pointer table when created, and pointers read
+ * from keys are looked up there; the table maps an address back to the same
+ * pointer. */
+#ifdef __FILC__
+#include <stdfil.h>
+extern zexact_ptrtable *clientPointerTable;
+static inline void registerClientPointer(client *c) {
+    zexact_ptrtable_encode(clientPointerTable, c);
+}
+static inline client *clientFromBytes(const unsigned char *p) {
+    client *c;
+    memcpy(&c, p, sizeof(c));
+    return zexact_ptrtable_decode(clientPointerTable, (size_t)c);
+}
+#else
+static inline void registerClientPointer(client *c) { UNUSED(c); }
+static inline client *clientFromBytes(const unsigned char *p) {
+    client *c;
+    memcpy(&c, p, sizeof(c));
+    return c;
+}
+#endif
 extern struct sharedObjectsStruct shared;
