 struct dns_qpnode {
-#if WORDS_BIGENDIAN
+#if defined(__FILC__)
+	/*
+	 * Fil-C keeps a pointer's capability only in a pointer-typed,
+	 * 8-byte-aligned slot, so the 64-bit word is a pointer here; branch
+	 * index words are stored in it as integers without a capability.
+	 */
+	void *big;
+	uint32_t small;
+#elif WORDS_BIGENDIAN
 	uint32_t bighi, biglo, small;
 #else
 	uint32_t biglo, bighi, small;
@@ -560,9 +568,13 @@ struct dns_qpmulti {
  */
 static inline uint64_t
 node64(dns_qpnode_t *n) {
+#if defined(__FILC__)
+	return (uintptr_t)n->big;
+#else
 	uint64_t lo = n->biglo;
 	uint64_t hi = n->bighi;
 	return lo | (hi << 32);
+#endif
 }
 
