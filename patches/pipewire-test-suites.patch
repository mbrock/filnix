Subject: Discover PipeWire test suites through C registration
Origin: Filnix
Upstream-Status: Not submitted

The test harness also enumerates ELF sections. Preserve suite order and
all test cases with constructor registration, without forged linker bounds.

--- a/test/pwtest-implementation.h
+++ b/test/pwtest-implementation.h
@@ -109,9 +109,15 @@
 		 ...) SPA_SENTINEL;
 
 struct pwtest_suite_decl {
+#ifdef __FILC__
+	struct pwtest_suite_decl *next;
+#endif
 	const char *name;
 	enum pwtest_result (*setup)(struct pwtest_context *, struct pwtest_suite *);
 };
 
+#ifdef __FILC__
+void pwtest_register_suite(struct pwtest_suite_decl *suite);
+#endif
 
