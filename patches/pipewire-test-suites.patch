--- a/test/pwtest.h
+++ b/test/pwtest.h
@@ -472,6 +472,17 @@
  *
  * Test suites are automatically discovered at build-time.
  */
+#ifdef __FILC__
+#define PWTEST_SUITE(cname) \
+	static enum pwtest_result (cname##__setup)(struct pwtest_context *ctx, struct pwtest_suite *suite); \
+	static struct pwtest_suite_decl _test_suite = { \
+		.name = #cname, .setup = cname##__setup, \
+	}; \
+	static void __attribute__((constructor)) cname##__register(void) { \
+		pwtest_register_suite(&_test_suite); \
+	} \
+	static enum pwtest_result (cname##__setup)(struct pwtest_context *ctx, struct pwtest_suite *suite)
+#else
 #define PWTEST_SUITE(cname) \
 	static enum pwtest_result (cname##__setup)(struct pwtest_context *ctx, struct pwtest_suite *suite); \
 	__attribute__((used)) \
@@ -483,6 +494,7 @@
 	   .setup = cname##__setup, \
 	}; \
 	static enum pwtest_result (cname##__setup)(struct pwtest_context *ctx, struct pwtest_suite *suite)
+#endif
 
