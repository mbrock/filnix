--- a/test/pwtest.c
+++ b/test/pwtest.c
@@ -534,8 +534,19 @@
 	spa_list_append(&suite->tests, &t->link);
 }
 
+#ifdef __FILC__
+static struct pwtest_suite_decl *registered_suites;
+static struct pwtest_suite_decl **registered_suites_tail = &registered_suites;
+
+void pwtest_register_suite(struct pwtest_suite_decl *suite)
+{
+	*registered_suites_tail = suite;
+	registered_suites_tail = &suite->next;
+}
+#else
 extern const struct pwtest_suite_decl __start_pwtest_suite_section;
 extern const struct pwtest_suite_decl __stop_pwtest_suite_section;
+#endif
 
 static void add_suite(struct pwtest_context *ctx,
