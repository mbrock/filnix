--- /dev/null
+++ b/spa/filc-pointers.c
@@ -0,0 +1,43 @@
+/* PipeWire */
+/* SPDX-License-Identifier: MIT */
+#include <errno.h>
+#include <inttypes.h>
+#include <pthread.h>
+#include <stdfil.h>
+#include <string.h>
+#include <spa/utils/ptr-string.h>
+
+static pthread_once_t table_once = PTHREAD_ONCE_INIT;
+static zexact_ptrtable *table;
+
+static void init_table(void)
+{
+    /* Do not retain otherwise unreachable objects via a property string. */
+    table = zexact_ptrtable_new_weak();
+}
+
+size_t spa_filc_pointer_encode(void *pointer)
+{
+    pthread_once(&table_once, init_table);
+    return zexact_ptrtable_encode(table, pointer);
+}
+
+int spa_filc_pointer_parse(const char *text, void **pointer)
+{
+    char *end;
+    uintmax_t token;
+    void *decoded;
+    if (!text || strncmp(text, "pointer:", 8) != 0 ||
+        !strchr("0123456789abcdefABCDEF", text[8]) || text[8] == '\0')
+        return 0;
+    errno = 0;
+    token = strtoumax(text + 8, &end, 16);
+    if (*end != '\0' || errno == ERANGE || token > SIZE_MAX)
+        return 0;
+    pthread_once(&table_once, init_table);
+    decoded = zexact_ptrtable_decode(table, token);
+    if (token != 0 && !zhasvalidcap(decoded))
+        return 0;
+    *pointer = decoded;
+    return 1;
+}
--- /dev/null
+++ b/spa/include/spa/utils/ptr-string.h
@@ -0,0 +1,38 @@
+/* PipeWire */
+/* SPDX-License-Identifier: MIT */
+#ifndef SPA_PTR_STRING_H
+#define SPA_PTR_STRING_H
+
+#include <stddef.h>
+#include <stdio.h>
+
+#ifdef __FILC__
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* One shared table for the application and all independently loaded SPA DSOs.
+ * Tokens borrow the original pointer's lifetime, just as native pointer strings
+ * do. They cannot create capabilities for pointers never registered here. */
+__attribute__((visibility("default")))
+size_t spa_filc_pointer_encode(void *pointer);
+__attribute__((visibility("default")))
+int spa_filc_pointer_parse(const char *text, void **pointer);
+#ifdef __cplusplus
+}
+#endif
+#define SPA_POINTER_FORMAT "pointer:%zx"
+#define SPA_POINTER_VALUE(p) spa_filc_pointer_encode((void *)(p))
+#define spa_pointer_parse(text, destination) ({ \
+    __typeof__(destination) _spa_destination = (destination); \
+    void *_spa_pointer; \
+    int _spa_result = spa_filc_pointer_parse((text), &_spa_pointer); \
+    if (_spa_result == 1) \
+        *_spa_destination = (__typeof__(*_spa_destination))_spa_pointer; \
+    _spa_result; \
+})
+#else
+#define SPA_POINTER_FORMAT "pointer:%p"
+#define SPA_POINTER_VALUE(p) (p)
+#define spa_pointer_parse(text, destination) sscanf((text), "pointer:%p", (destination))
+#endif
+#endif
