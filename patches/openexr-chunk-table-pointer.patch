Subject: Keep the chunk table in an atomic pointer
Origin: Filnix
Upstream-Status: Not submitted

The chunk table pointer lived in an atomic_uintptr_t, so every load turned
an integer back into a pointer. Under Fil-C such a pointer has no
capability, and reading the chunk table or freeing it trapped. Use an
atomic pointer with C11 and C++ atomics; the MSVC fallback is not
adapted.

--- a/src/lib/OpenEXRCore/chunk.c
+++ b/src/lib/OpenEXRCore/chunk.c
@@ -537,11 +537,12 @@
     *chunkminoffset = chunkoff + chunkbytes;
 
     ctable = (uint64_t*) atomic_load (
-        EXR_CONST_CAST (atomic_uintptr_t*, &(part->chunk_table)));
+        EXR_CONST_CAST (exr_atomic_chunk_table_t*, &(part->chunk_table)));
     if (ctable == NULL)
     {
         int64_t      nread = 0;
-        uintptr_t    eptr = 0, nptr = 0;
+        uint64_t*    eptr = NULL;
+        uint64_t*    nptr = NULL;
         int          complete = 1;
         uint64_t     maxoff   = ((uint64_t) -1);
         exr_result_t rv;
@@ -615,15 +616,15 @@
         }
         else { priv_to_native64 (ctable, part->chunk_count); }
 
-        nptr = (uintptr_t) ctable;
+        nptr = ctable;
         // see if we win or not
         if (!atomic_compare_exchange_strong (
-                EXR_CONST_CAST (atomic_uintptr_t*, &(part->chunk_table)),
+                EXR_CONST_CAST (exr_atomic_chunk_table_t*, &(part->chunk_table)),
                 &eptr,
                 nptr))
         {
-            if (nptr != UINTPTR_MAX) ctxt->free_fn (ctable);
-            ctable = (uint64_t*) eptr;
+            if ((uintptr_t) nptr != UINTPTR_MAX) ctxt->free_fn (ctable);
+            ctable = eptr;
             if (ctable == NULL)
                 return ctxt->standard_error (ctxt, EXR_ERR_OUT_OF_MEMORY);
         }
@@ -644,25 +645,26 @@
 
     /* we have the lock, but to access the type, we'll use the atomic function anyway */
     ctable = (uint64_t*) atomic_load (
-        EXR_CONST_CAST (atomic_uintptr_t*, &(part->chunk_table)));
+        EXR_CONST_CAST (exr_atomic_chunk_table_t*, &(part->chunk_table)));
     if (ctable == NULL)
     {
         uint64_t  chunkbytes = sizeof (uint64_t) * (uint64_t) part->chunk_count;
-        uintptr_t eptr = 0, nptr = 0;
+        uint64_t* eptr = NULL;
+        uint64_t* nptr = NULL;
 
         ctable = (uint64_t*) ctxt->alloc_fn (chunkbytes);
         if (ctable == NULL)
             return ctxt->standard_error (ctxt, EXR_ERR_OUT_OF_MEMORY);
         memset (ctable, 0, chunkbytes);
 
-        nptr = (uintptr_t) ctable;
+        nptr = ctable;
         if (!atomic_compare_exchange_strong (
-                EXR_CONST_CAST (atomic_uintptr_t*, &(part->chunk_table)),
+                EXR_CONST_CAST (exr_atomic_chunk_table_t*, &(part->chunk_table)),
                 &eptr,
                 nptr))
         {
             ctxt->free_fn (ctable);
-            ctable = (uint64_t*) eptr;
+            ctable = eptr;
             if (ctable == NULL)
                 return ctxt->standard_error (ctxt, EXR_ERR_OUT_OF_MEMORY);
         }
--- a/src/lib/OpenEXRCore/internal_structs.c
+++ b/src/lib/OpenEXRCore/internal_structs.c
@@ -159,7 +159,7 @@
     cur->chunk_table = 0;
 #else
     ctable = (uint64_t*) atomic_load (&(cur->chunk_table));
-    atomic_store (&(cur->chunk_table), (uintptr_t) (0));
+    atomic_store (&(cur->chunk_table), NULL);
 #endif
     if (ctable && ((uintptr_t) ctable) != UINTPTR_MAX) dofree (ctable);
 
--- a/src/lib/OpenEXRCore/internal_structs.h
+++ b/src/lib/OpenEXRCore/internal_structs.h
@@ -37,6 +37,7 @@
 #ifdef __cplusplus
 #    include <atomic>
 using atomic_uintptr_t = std::atomic_uintptr_t;
+using exr_atomic_chunk_table_t = std::atomic<uint64_t*>;
 #else
 /* msvc, from version 19.31, evaluate __has_include(<stdatomic.h>) to true but
  * doesn't actually support it yet. Ignoring msvc for now, once we know minimal
@@ -51,11 +52,13 @@
 
 #    ifdef EXR_HAS_STD_ATOMICS
 #        include <stdatomic.h>
+typedef _Atomic (uint64_t*) exr_atomic_chunk_table_t;
 #    elif defined(_MSC_VER)
 /* msvc w/ c11 support is only very new, until we know what the preprocessor checks are, provide defaults */
 #        include <stdint.h>
 #        include <windows.h>
 typedef uintptr_t volatile atomic_uintptr_t;
+typedef atomic_uintptr_t exr_atomic_chunk_table_t;
 
 static inline uintptr_t
 atomic_load (
@@ -139,7 +142,7 @@
 
     int32_t          chunk_count;
     uint64_t         chunk_table_offset;
-    atomic_uintptr_t chunk_table;
+    exr_atomic_chunk_table_t chunk_table;
 };
 
 typedef struct _priv_exr_part_t*       exr_priv_part_t;
