Subject: IndexedPointInAreaLocator: tag SegmentView without an integer round trip
Origin: Filnix
Upstream-Status: Not submitted

SegmentView packs p1's offset into the low bits of p0 and keeps the
result in a std::size_t. Under Fil-C the pointer rebuilt from that
integer has no capability, so every point-in-area query stopped the
program in RayCrossingCounter::countSegment (110 of 508 tests). Keep a
const char* and add or subtract the tag with pointer arithmetic; the
struct stays 8 bytes.

--- a/include/geos/algorithm/locate/IndexedPointInAreaLocator.h
+++ b/include/geos/algorithm/locate/IndexedPointInAreaLocator.h
@@ -21,6 +21,7 @@
 #include <geos/index/ItemVisitor.h> // inherited
 #include <geos/index/strtree/TemplateSTRtree.h>
 
+#include <cstdint>
 #include <memory>
 #include <vector> // composition
 
@@ -62,24 +63,30 @@
             // By packing this offset into the least significant bits of p0,
             // we can retrieve both p0 and p1 while only using 8 bytes.
             std::size_t os = static_cast<std::size_t>(reinterpret_cast<const double*>(p1) - reinterpret_cast<const double*>(p0)) - 2u;
-            m_p0 = reinterpret_cast<std::size_t>(p0) | os;
+            // Tag by pointer arithmetic, so that the pointer keeps its
+            // provenance (Fil-C drops it on an integer round trip).
+            m_p0 = reinterpret_cast<const char*>(p0) + os;
 
             assert(&this->p0() == p0);
             assert(&this->p1() == p1);
         }
 
         const geom::CoordinateXY& p0() const {
-            auto ret = reinterpret_cast<const geom::CoordinateXY*>(m_p0 >> 2 << 2);
+            auto ret = reinterpret_cast<const geom::CoordinateXY*>(m_p0 - tag());
             return *ret;
         }
 
         const geom::CoordinateXY& p1() const {
-            auto offset = (m_p0 & 0x03) + 2;
-            auto ret = reinterpret_cast<const geom::CoordinateXY*>(reinterpret_cast<double*>(m_p0 >> 2 << 2) + offset);
+            auto offset = tag() + 2;
+            auto ret = reinterpret_cast<const geom::CoordinateXY*>(reinterpret_cast<const double*>(m_p0 - tag()) + offset);
             return *ret;
         }
 
-        std::size_t m_p0;
+        std::size_t tag() const {
+            return reinterpret_cast<std::uintptr_t>(m_p0) & 0x03;
+        }
+
+        const char* m_p0;
     };
 
     class IntervalIndexedGeometry {
