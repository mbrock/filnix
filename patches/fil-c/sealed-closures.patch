diff --git a/libpas/src/libpas/filc_runtime.h b/libpas/src/libpas/filc_runtime.h
index e14eb2100a8..2011d77c5e7 100644
--- a/libpas/src/libpas/filc_runtime.h
+++ b/libpas/src/libpas/filc_runtime.h
@@ -705,8 +705,16 @@ struct filc_function {
     filc_signature signature;
 };
 
+#define FILC_CLOSURE_FLAG_SEALED ((uintptr_t)1) /* zclosure_get_data and zclosure_set_data refuse
+                                                  the closure, and zclosure_new refuses to rebind
+                                                  it. Only zcallee_closure_data, which reads the
+                                                  data of the function that is running, sees it. */
+
 struct filc_closure {
     filc_function base;
+    uintptr_t closure_flags; /* Set at creation, never changed. Occupies what the compiler's
+                                filc_closure type treats as padding, so data_ptr stays where
+                                zcallee_closure_data loads it. */
     filc_ptr data_ptr; /* Used by closures. */
 };
 
