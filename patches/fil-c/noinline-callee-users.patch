 using namespace llvm;
 
+namespace {
+
+// zcallee() and zcallee_closure_data() read the closure that the function containing them was
+// called through. Inlined into a caller, they would read the caller's closure instead, and anyone
+// who can make a closure of the caller could run the callee's code on data of their choosing,
+// bypassing a sealed closure. So functions that use them are never inlined.
+struct NoInlineCalleeUsersPass : PassInfoMixin<NoInlineCalleeUsersPass> {
+  PreservedAnalyses run(Module& M, ModuleAnalysisManager&) {
+    bool Changed = false;
+    for (Function& F : M) {
+      if (F.isDeclaration())
+        continue;
+      bool UsesCallee = false;
+      for (Instruction& I : instructions(F)) {
+        if (CallBase* CI = dyn_cast<CallBase>(&I)) {
+          if (Function* Callee = dyn_cast<Function>(CI->getCalledOperand())) {
+            if (Callee->getName() == "zcallee" || Callee->getName() == "zcallee_closure_data") {
+              UsesCallee = true;
+              break;
+            }
+          }
+        }
+      }
+      if (!UsesCallee || F.hasFnAttribute(Attribute::NoInline))
+        continue;
+      F.removeFnAttr(Attribute::AlwaysInline);
+      F.addFnAttr(Attribute::NoInline);
+      Changed = true;
+    }
+    return Changed ? PreservedAnalyses::none() : PreservedAnalyses::all();
+  }
+  static bool isRequired() { return true; }
+};
+
+} // anonymous namespace
