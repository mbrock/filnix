 yyc_init:
 	yych = *data;
-	if (yybm_init[0+yych] & 8) {
+	if (yybm_init[0+(unsigned char)yych] & 8) {
 		goto yy4;
 	}
 	if (yych <= '#') {
@@ -372,7 +372,7 @@
