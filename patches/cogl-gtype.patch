Subject: Keep GType once storage pointer-valued
Origin: Filnix
Upstream-Status: Not submitted

GType is a pointer under Fil-C. Cogl's get_gtype macros and its
glib-mkenums templates kept type IDs in gsize/size_t once storage and
returned them as GType, which clang rejects and which would drop the
capability. Use GType storage with GLib 2.80's pointer once functions;
Cogl sets no GLib API ceiling.

diff --git a/cogl-path/cogl-path-enum-types.c.in b/cogl-path/cogl-path-enum-types.c.in
index 5474607..794c3e0 100644
--- a/cogl-path/cogl-path-enum-types.c.in
+++ b/cogl-path/cogl-path-enum-types.c.in
@@ -23,9 +23,9 @@
 GType
 @enum_name@_get_type (void)
 {
-  static volatile gsize g_enum_type_id__volatile = 0;
+  static GType g_enum_type_id__volatile = 0;
 
-  if (g_once_init_enter (&g_enum_type_id__volatile))
+  if (g_once_init_enter_pointer (&g_enum_type_id__volatile))
     {
       static const G@Type@Value values[] = {
 /*** END value-header ***/
@@ -42,7 +42,7 @@ GType
       g_enum_type_id =
         g_@type@_register_static (g_intern_static_string ("@EnumName@"), values);
 
-      g_once_init_leave (&g_enum_type_id__volatile, g_enum_type_id);
+      g_once_init_leave_pointer (&g_enum_type_id__volatile, g_enum_type_id);
     }
 
   return g_enum_type_id__volatile;
