Subject: Omit explicit AVX register cleanup under Fil-C
Origin: Filnix
Upstream-Status: Not submitted

The four explicit zeroupper calls are register-transition performance hints at
function return, not codec operations. Fil-C currently rejects the LLVM intrinsic.
Keep the AVX2 C kernels and let code generation manage machine registers. The
full FLAC suite exercises these kernels on the AVX2 build host.

--- a/src/libFLAC/lpc_intrin_avx2.c
+++ b/src/libFLAC/lpc_intrin_avx2.c
@@ -399,7 +399,9 @@
 			residual[i] = data[i] - (sum >> lp_quantization);
 		}
 	}
+#ifndef __FILC__
 	_mm256_zeroupper();
+#endif
 }
 
 FLAC__SSE_TARGET("avx2")
@@ -754,7 +756,9 @@
 			residual[i] = data[i] - (sum >> lp_quantization);
 		}
 	}
+#ifndef __FILC__
 	_mm256_zeroupper();
+#endif
 }
 
 static FLAC__int32 pack_arr[8] = { 0, 2, 4, 6, 1, 3, 5, 7 };
@@ -1113,7 +1117,9 @@
 			residual[i] = data[i] - (FLAC__int32)(sum >> lp_quantization);
 		}
 	}
+#ifndef __FILC__
 	_mm256_zeroupper();
+#endif
 }
 
 #endif /* FLAC__AVX2_SUPPORTED */
--- a/src/libFLAC/stream_encoder_intrin_avx2.c
+++ b/src/libFLAC/stream_encoder_intrin_avx2.c
@@ -138,7 +138,9 @@
 			}
 		}
 	}
+#ifndef __FILC__
 	_mm256_zeroupper();
+#endif
 }
 
 #endif /* FLAC__AVX2_SUPPORTED */
