Subject: Register built-in PulseAudio modules using C pointers
Origin: Filnix
Upstream-Status: Not submitted

Keep all compiled modules discoverable without relying on ELF section
boundaries. Constructors append static registration nodes in link order;
module metadata and public module behavior remain unchanged.

--- a/src/modules/module-protocol-pulse/module.c
+++ b/src/modules/module-protocol-pulse/module.c
@@ -298,6 +298,29 @@ void audioinfo_to_properties(struct spa_audio_info_raw *info, struct pw_properti
 	}
 }
 
+#ifdef __FILC__
+static struct module_registration *registered_modules;
+static struct module_registration **registered_modules_tail = &registered_modules;
+
+void module_register(struct module_registration *entry)
+{
+	*registered_modules_tail = entry;
+	registered_modules_tail = &entry->next;
+}
+
+const struct module_info *module_info_next(struct impl *impl, const struct module_info *info)
+{
+	const struct module_registration *entry = registered_modules;
+
+	if (info != NULL) {
+		while (entry != NULL && entry->info != info)
+			entry = entry->next;
+		if (entry != NULL)
+			entry = entry->next;
+	}
+	return entry != NULL ? entry->info : NULL;
+}
+#else
 const struct module_info *module_info_next(struct impl *impl, const struct module_info *info)
 {
 	extern const struct module_info __start_pw_mod_pulse_modules[];
@@ -311,6 +334,7 @@ const struct module_info *module_info_next(struct impl *impl, const struct modul
 		return NULL;
 	return info;
 }
+#endif
 
 const struct module_info *module_info_find(struct impl *impl, const char *name)
 {
--- a/src/modules/module-protocol-pulse/module.h
+++ b/src/modules/module-protocol-pulse/module.h
@@ -32,12 +32,27 @@ struct module_info {
 	size_t data_size;
 };
 
+#ifdef __FILC__
+struct module_registration {
+	const struct module_info *info;
+	struct module_registration *next;
+};
+void module_register(struct module_registration *entry);
+#define DEFINE_MODULE_INFO(name) \
+	extern const struct module_info name; \
+	static struct module_registration name##__entry = { .info = &name }; \
+	static void __attribute__((constructor)) name##__register(void) { \
+		module_register(&name##__entry); \
+	} \
+	const struct module_info name
+#else
 #define DEFINE_MODULE_INFO(name)					\
 	__attribute__((used))						\
 	__attribute__((retain))						\
 	__attribute__((section("pw_mod_pulse_modules")))		\
 	__attribute__((aligned(__alignof__(struct module_info))))	\
 	const struct module_info name
+#endif
 
 struct module_events {
 #define VERSION_MODULE_EVENTS	0
