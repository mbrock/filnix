Keep pointer metadata in the SPI transfer's integer-sized ABI slots. The wire
layout and pointer addresses remain unchanged; memcpy also carries Fil-C's
capabilities, unlike a pointer-to-integer store and subsequent integer load.
The mocked ioctl reads the slots the same way, retaining all payload checks.
This does not establish physical SPI device support by the runtime ioctl layer.

--- a/src/tss2-tcti/tcti-spidev.c
+++ b/src/tss2-tcti/tcti-spidev.c
@@ -85,8 +85,15 @@ platform_spi_transfer (void *user_data, const void *data_out, void *data_in, size_t
     };
 
     tr.len = cnt;
+#ifdef __FILC__
+    _Static_assert(sizeof(tr.tx_buf) == sizeof(data_out), "SPI pointer slot size");
+    _Static_assert(sizeof(tr.rx_buf) == sizeof(data_in), "SPI pointer slot size");
+    memcpy(&tr.tx_buf, &data_out, sizeof(data_out));
+    memcpy(&tr.rx_buf, &data_in, sizeof(data_in));
+#else
     tr.tx_buf = (unsigned long) data_out;
     tr.rx_buf = (unsigned long) data_in;
+#endif
 	int ret = ioctl(platform_data->fd, SPI_IOC_MESSAGE(1), &tr);
     if (ret < 0) {
         LOG_ERROR("SPI acquire failed: %s", strerror(errno));
--- a/test/unit/tcti-spidev.c
+++ b/test/unit/tcti-spidev.c
@@ -110,9 +110,16 @@ int __wrap_ioctl(int fd, unsigned long request, struct spi_ioc_transfer *tr)
 
     size_t len = tr->len;
 
+#ifdef __FILC__
+    uint8_t *tx_buf;
+    uint8_t *rx_buf;
+    memcpy(&tx_buf, &tr->tx_buf, sizeof(tx_buf));
+    memcpy(&rx_buf, &tr->rx_buf, sizeof(rx_buf));
+#else
     /* Use size_t to cast 64 bit number to pointer (needed for 32 bit systems) */
     uint8_t *tx_buf = (uint8_t *)(size_t) tr->tx_buf;
     uint8_t *rx_buf = (uint8_t *)(size_t) tr->rx_buf;
+#endif
 
     static tpm_state_t tpm_state = TPM_DID_VID_HEAD;
 
