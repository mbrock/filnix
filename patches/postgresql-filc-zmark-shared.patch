+/*
+ * Fil-C: an IO on local (temporary) buffers puts pointers to backend-private
+ * memory in its iovecs, and only the issuing backend executes it, so its
+ * iovecs live in backend-private memory. Pointers stored in the zmark_shared
+ * main segment carry only the segment's capability.
+ */
+static struct iovec *pgaio_local_iovecs;
+
+static struct iovec *
+pgaio_io_iovecs(PgAioHandle *ioh)
+{
+	if (ioh->flags & PGAIO_HF_REFERENCES_LOCAL)
+	{
+		if (pgaio_local_iovecs == NULL)
+			pgaio_local_iovecs = MemoryContextAllocZero(TopMemoryContext,
+														sizeof(struct iovec) * pgaio_ctl->iovec_count);
+		return &pgaio_local_iovecs[ioh->iovec_off];
+	}
+	return &pgaio_ctl->iovecs[ioh->iovec_off];
+}
+
