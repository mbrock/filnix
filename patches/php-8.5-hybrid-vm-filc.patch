+// Fil-C (no global registers): only these hot handlers are inlined into
+// execute_ex. FilPizlonator keeps every pointer live across the dispatch
+// loop in the Fil-C frame, so a large execute_ex costs more than it saves.
+function is_filc_inline_handler($name) {
+    return preg_match('/^ZEND_(ADD|SUB|MUL|IS_SMALLER(_OR_EQUAL)?|IS_EQUAL|IS_NOT_EQUAL|PRE_INC|PRE_DEC|POST_INC|POST_DEC|QM_ASSIGN|JMP|JMPZ|JMPNZ|JMP_FORWARD|FETCH_DIM_R_INDEX|BW_OR|BW_AND|BW_XOR|TYPE_CHECK|ISSET_ISEMPTY_CV|NOP|EXT_NOP)(_LONG|_DOUBLE|_LONG_NO_OVERFLOW|_NOREF)?$/', $name) === 1;
+}
+
 function is_inline_hybrid_handler($name, $hot, $op1, $op2, $extra_spec) {
     return ($hot === 'INLINE_');
 }
