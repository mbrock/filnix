Subject: Resolve add_cpp_test executables when an emulator is configured
Origin: Filnix
Upstream-Status: Not submitted

Nixpkgs sets CMAKE_CROSSCOMPILING_EMULATOR=env for Fil-C. Ada's helper then
registers basic_fuzzer as "env basic_fuzzer"; env searches PATH and the test
fails with "No such file or directory". The NAME/COMMAND form resolves the
target to its built path and CMake prepends the emulator itself.

--- a/cmake/add-cpp-test.cmake
+++ b/cmake/add-cpp-test.cmake
@@ -42,11 +42,7 @@
     )
     set_target_properties(${TEST_NAME} PROPERTIES EXCLUDE_FROM_ALL TRUE EXCLUDE_FROM_DEFAULT_BUILD TRUE)
   else()
-    if (CMAKE_CROSSCOMPILING_EMULATOR)
-      add_test(${TEST_NAME} ${CMAKE_CROSSCOMPILING_EMULATOR} ${TEST_NAME})
-    else()
-      add_test(${TEST_NAME} ${TEST_NAME})
-    endif()
+    add_test(NAME ${TEST_NAME} COMMAND ${TEST_NAME})
 
     # Add to <label>_tests make targets
     foreach(label ${ARGS_LABELS})
