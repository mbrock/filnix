 -- Compile one parsed input into output assembly text. `debug` (from -g) makes origins
 -- carry source file/line/column (pointing at the input assembly) for runtime diagnostics.
+-- `.rept N` ... `.endr`: GNU as assembles the enclosed statements N times. Expand
+-- the block before any other analysis, so the repeated statements are seen exactly
+-- as if they were written out. (Treated as an ordinary structural directive,
+-- `.rept` ended a data block: a label before it named an empty object, and the
+-- repeated data fell into an unlabeled block that the dead-content rule dropped
+-- without a diagnostic.) Each copy is a fresh statement, since later passes key
+-- per-statement state on statement identity.
+local function copyStmt(v)
+	if type(v) ~= "table" then return v end
+	local c = {}
+	for k, x in pairs(v) do c[k] = copyStmt(x) end
+	return c
+end
+
+local function reptCount(st)
+	if st.annotation then
+		err.at(st, "annotation '" .. st.annotation .. "' on a directive ('.rept') is"
+			.. " not supported")
+	end
+	-- Same constant folding as a data initializer (see numArg).
+	if st.file then err.beginParse(st.file); err.atParseLine(st.line) end
+	local e = x86_64_parse.parseDispExpr(st.args or "", "displacement")
+	err.endParse()
+	local n = e.const
+	if e.sym or n == nil or n ~= math.floor(n) or n < 0 then
+		err.at(st, ".rept count is not a non-negative integer constant: "
+			.. (st.raw or st.name))
+	end
+	return n
+end
+
+local function expandRept(stmts)
+	local function walk(i, open)
+		local out = {}
+		while i <= #stmts do
+			local st = stmts[i]
+			if st.kind == "directive" and st.name == ".rept" then
+				local n = reptCount(st)
+				local inner, j = walk(i + 1, st)
+				for _ = 1, n do
+					for _, s in inner do table.insert(out, copyStmt(s)) end
+				end
+				i = j
+			elseif st.kind == "directive" and st.name == ".endr" then
+				if not open then
+					err.at(st, "`.endr` without a matching `.rept`")
+				end
+				return out, i + 1
+			else
+				table.insert(out, st)
+				i += 1
+			end
+		end
+		if open then err.at(open, "`.rept` without a matching `.endr`") end
+		return out, i
+	end
+	return (walk(1, nil))
+end
+
 function sarcasm.compile(stmts, fileDirective, debug, target)
 	target = target or makeTarget("arm64", nil)
+	stmts = expandRept(stmts)
