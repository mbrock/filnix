diff --git a/src/bif_tabling.c b/src/bif_tabling.c
index 413b447f..20b817b4 100644
--- a/src/bif_tabling.c
+++ b/src/bif_tabling.c
@@ -850,7 +850,7 @@ typedef struct {
 	// Bumped by abolish; the worklist enumerations carry the generation
 	// they started in and stop cleanly if the tables were pulled out from
 	// under them. Answer enumerations keep their tables (tbl_abolish()).
-	// int64_t (not uint64_t) to match q->st.v2, where they stash it.
+	// int64_t (not uint64_t) to match q->st.table_generation, where they stash it.
 
 	int64_t generation;
 
@@ -3369,7 +3369,7 @@ static bool bif_tbl_get_answer_2(query *q)
 	if (!t)
 		return throw_error(q, p1, p1_ctx, "type_error", "table_handle");
 
-	tbl_ans *a = q->retry ? (tbl_ans*)(size_t)q->st.v1 : t->first_ans;
+	tbl_ans *a = q->retry ? (tbl_ans*)q->st.table_cursor : t->first_ans;
 
 	if (!a)
 		return false;
@@ -3382,7 +3382,7 @@ static bool bif_tbl_get_answer_2(query *q)
 	// and either would silently drop answers here.
 
 	if (a->next) {
-		q->st.v1 = (uint64_t)(size_t)a->next;
+		q->st.table_cursor = a->next;
 		CHECKED(tbl_note_reader(s, q));
 		CHECKED(push_choice(q));
 		t->enumerated = true;		// see tbl_revalidate()
@@ -3608,17 +3608,17 @@ static bool bif_tbl_wkl_work_3(query *q)
 	if (!t)
 		return throw_error(q, p1, p1_ctx, "type_error", "table_handle");
 
-	if (q->retry && (q->st.v2 != s->generation))
+	if (q->retry && (q->st.table_generation != s->generation))
 		return false;
 
-	tbl_pair *p = q->retry ? (tbl_pair*)(size_t)q->st.v1 : t->pending;
+	tbl_pair *p = q->retry ? (tbl_pair*)q->st.table_cursor : t->pending;
 
 	if (!p)
 		return false;
 
 	if (p->next) {
-		q->st.v1 = (uint64_t)(size_t)p->next;
-		q->st.v2 = s->generation;
+		q->st.table_cursor = p->next;
+		q->st.table_generation = s->generation;
 		CHECKED(push_choice(q));
 	}
 
@@ -3688,17 +3688,17 @@ static bool tbl_neg_work(query *q, tbl_state *s, cell *p1, pl_ctx p1_ctx)
 	if (!s->scc_depth)
 		return false;
 
-	if (q->retry && (q->st.v2 != s->generation))
+	if (q->retry && (q->st.table_generation != s->generation))
 		return false;
 
-	tbl_susp *sp = q->retry ? (tbl_susp*)(size_t)q->st.v1 : s->scc[s->scc_depth-1].negs;
+	tbl_susp *sp = q->retry ? (tbl_susp*)q->st.table_cursor : s->scc[s->scc_depth-1].negs;
 
 	if (!sp)
 		return false;
 
 	if (sp->next) {
-		q->st.v1 = (uint64_t)(size_t)sp->next;
-		q->st.v2 = s->generation;
+		q->st.table_cursor = sp->next;
+		q->st.table_generation = s->generation;
 		CHECKED(push_choice(q));
 	}
 
