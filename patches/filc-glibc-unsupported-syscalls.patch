Subject: Report brk, fail sched_setattr and pidfd_spawn instead of stopping
Origin: Filnix
Upstream-Status: Not submitted

These stopped the program. brk and sched_setattr made raw inline-asm
syscalls, which Fil-C refuses at run time. pidfd_spawn hit
ZASSERT (!use_pidfd) in __spawnix.

__brk now asks the runtime for the break (zsys_brk, from
patches/filc-runtime-brk-query.patch), which only queries it, and __sbrk
asks on every call, since the runtime's native allocator moves the break
without this libc seeing it; so sbrk (0) returns the break as it does
natively; moving the break fails with
ENOMEM, since Fil-C allocates from the GC heap. The break is an integer,
so __curbrk carries no capability. sched_setattr, which the runtime has
no wrapper for, fails with ENOSYS. pidfd_spawn and pidfd_spawnp return
ENOSYS, the value __spawnix already returns without pidfd support, so
callers may fall back to posix_spawn. e2fsck calls sbrk (0) at startup;
systemd uses pidfd_spawn for every service and sched_setattr for
CPUSchedulingPolicy=. The regression check is
tests/glibc-syscall-fallbacks.nix.

--- a/misc/sbrk.c
+++ b/misc/sbrk.c
@@ -37,7 +37,9 @@
 {
   /* Controls whether __brk (0) is called to read the brk value from
      the kernel.  */
-  bool update_brk = __curbrk == NULL;
+  /* Under Fil-C the runtime's native allocator moves the break behind
+     this libc's back, so __curbrk goes stale: always ask.  */
+  bool update_brk = true;
 
 #if defined (SHARED) && ! IS_IN (rtld)
   if (!__libc_initial)
--- a/sysdeps/unix/sysv/linux/brk.c
+++ b/sysdeps/unix/sysv/linux/brk.c
@@ -19,7 +19,7 @@
 #include <errno.h>
 #include <unistd.h>
 #include <sysdep.h>
-#include <brk_call.h>
+#include <pizlonated_syscalls.h>
 
 /* This must be initialized data because commons can't have aliases.  */
 void *__curbrk = NULL;
@@ -34,8 +34,11 @@
 int
 __brk (void *addr)
 {
-  __curbrk = __brk_call (addr);
-  if (__curbrk < addr)
+  /* Fil-C programs allocate from the GC heap.  The runtime reports the
+     break but never moves it, and its answer is an integer, so __curbrk
+     has no capability.  */
+  __curbrk = (void *) zsys_brk ();
+  if (addr != NULL && addr != __curbrk)
     {
       __set_errno (ENOMEM);
       return -1;
--- a/sysdeps/unix/sysv/linux/sched_setattr.c
+++ b/sysdeps/unix/sysv/linux/sched_setattr.c
@@ -17,10 +17,16 @@
    <https://www.gnu.org/licenses/>.  */
 
 #include <sched.h>
+#include <errno.h>
 #include <sysdep.h>
 
 int
 sched_setattr (pid_t pid, struct sched_attr *attr, unsigned int flags)
 {
-  return INLINE_SYSCALL_CALL (sched_setattr, pid, attr, flags);
+  /* The Fil-C runtime has no wrapper for sched_setattr.  */
+  (void) pid;
+  (void) attr;
+  (void) flags;
+  __set_errno (ENOSYS);
+  return -1;
 }
--- a/sysdeps/unix/sysv/linux/spawni.c
+++ b/sysdeps/unix/sysv/linux/spawni.c
@@ -338,8 +338,12 @@
