Subject: Keep Fil-C cancellation signals separate from native libc
Origin: Filnix
Upstream-Status: Not submitted

The runtime forbids sending or installing handlers on the native libc's
reserved signals. Sharing SIGCANCEL=32 caused pthread_cancel to return
ENOSYS once the target enabled asynchronous cancellation. Use signals 34-36
for the Fil-C libc and report public SIGRTMIN=37, preserving the native
reservation too. Propagate handler-installation errors instead of marking
initialization complete after a rejected sigaction.

--- a/sysdeps/unix/sysv/linux/internal-signals.h
+++ b/sysdeps/unix/sysv/linux/internal-signals.h
@@ -29,35 +29,49 @@
 #include <pizlonated_syscalls.h>
 
 /* The signal used for asynchronous cancelation.  */
-#define SIGCANCEL       __SIGRTMIN
+#ifdef __FILC__
+/* The native libc under the Fil-C runtime already owns signals 32 and 33.
+   Reserve a separate range for this libc; public SIGRTMIN remains computed
+   at run time from RESERVED_SIGRT. */
+# define SIGCANCEL      (__SIGRTMIN + 2)
+#else
+# define SIGCANCEL      __SIGRTMIN
+#endif
 
 
 /* Signal used to implement the setuid et.al. functions.  */
-#define SIGSETXID       (__SIGRTMIN + 1)
+#define SIGSETXID       (SIGCANCEL + 1)
 
 
 /* Signal needed for the kernel-supported POSIX timer implementation.
    We can reuse the cancellation signal since we can distinguish
    cancellation from timer expirations.  */
-#define SIGTIMER        (__SIGRTMIN + 2)
+#define SIGTIMER        (SIGCANCEL + 2)
 
 
-/* How many signal numbers need to be reserved for libpthread's private uses
-   (SIGCANCEL and SIGSETXID).  */
-#define RESERVED_SIGRT  3
+/* Reserve both libcs' private signals, including the timer signal. */
+#ifdef __FILC__
+# define RESERVED_SIGRT 5
+#else
+# define RESERVED_SIGRT 3
+#endif
 
 
 /* Return is sig is used internally.  */
 static inline bool
 is_internal_signal (int sig)
 {
-  return (sig == SIGCANCEL) || (sig == SIGSETXID) || (sig == SIGTIMER);
+  return sig >= __SIGRTMIN && sig < __SIGRTMIN + RESERVED_SIGRT;
 }
 
 /* Remove internal glibc signal from the mask.  */
 static inline void
 clear_internal_signals (sigset_t *set)
 {
+#ifdef __FILC__
+  __sigdelset (set, __SIGRTMIN);
+  __sigdelset (set, __SIGRTMIN + 1);
+#endif
   __sigdelset (set, SIGCANCEL);
   __sigdelset (set, SIGSETXID);
   __sigdelset (set, SIGTIMER);
--- a/nptl/pthread_cancel.c
+++ b/nptl/pthread_cancel.c
@@ -89,7 +89,8 @@
 	 target thread.  */
       sa.sa_flags = SA_SIGINFO | SA_RESTART;
       __sigemptyset (&sa.sa_mask);
-      __libc_sigaction (SIGCANCEL, &sa, NULL);
+      if (__libc_sigaction (SIGCANCEL, &sa, NULL) != 0)
+        return errno;
       atomic_store_relaxed (&init_sigcancel, 1);
     }
 
