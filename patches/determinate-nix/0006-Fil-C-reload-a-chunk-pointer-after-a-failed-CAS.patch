From 067c8993a41a0f36c5c38391b44f6543f81d1f45 Mon Sep 17 00:00:00 2001
From: t <a@b>
Date: Sun, 27 Sep 2026 21:47:09 +0000
Subject: [PATCH] Fil-C: reload a chunk pointer after a failed CAS

Amp-Thread-ID: https://ampcode.com/threads/T-01a0e3d7-ab8a-71e7-a00f-992fc7832185
Co-authored-by: Mikael Brockman <mikael@brockman.se>
---
 src/libutil/include/nix/util/chunked-vector.hh | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/libutil/include/nix/util/chunked-vector.hh b/src/libutil/include/nix/util/chunked-vector.hh
index f345213..5abfc91 100644
--- a/src/libutil/include/nix/util/chunked-vector.hh
+++ b/src/libutil/include/nix/util/chunked-vector.hh
@@ -68,6 +68,11 @@ private:
 
         /* Somebody beat us to it. */
         ::operator delete(newChunk);
+#ifdef __FILC__
+        /* Under contention, Fil-C's failed pointer CAS can write back the
+           winner's address without its capability; a fresh load has it. */
+        expected = (*chunks)[chunkIdx].load(std::memory_order_acquire);
+#endif
         assert(expected);
         return expected;
     }
