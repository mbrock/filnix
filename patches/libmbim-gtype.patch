diff --git a/src/libmbim-glib/mbim-message.c b/src/libmbim-glib/mbim-message.c
index 96566ff..0eec409 100644
--- a/src/libmbim-glib/mbim-message.c
+++ b/src/libmbim-glib/mbim-message.c
@@ -99,22 +99,7 @@ set_error_from_status (GError          **error,
 
 /*****************************************************************************/
 
-GType
-mbim_message_get_type (void)
-{
-    static gsize g_define_type_id_initialized = 0;
-
-    if (g_once_init_enter (&g_define_type_id_initialized)) {
-        GType g_define_type_id =
-            g_boxed_type_register_static (g_intern_static_string ("MbimMessage"),
-                                          (GBoxedCopyFunc) mbim_message_ref,
-                                          (GBoxedFreeFunc) mbim_message_unref);
-
-        g_once_init_leave (&g_define_type_id_initialized, g_define_type_id);
-    }
-
-    return g_define_type_id_initialized;
-}
+G_DEFINE_BOXED_TYPE (MbimMessage, mbim_message, mbim_message_ref, mbim_message_unref)
 
 /*****************************************************************************/
 
