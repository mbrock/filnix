Subject: Keep GType once storage pointer-valued
Origin: Filnix
Upstream-Status: Not submitted

GType is a pointer under Fil-C. The boxed and enum get_type functions kept
the type in gsize once storage and returned it as GType, which clang
rejects and which would drop the capability. The boxed types use
G_DEFINE_BOXED_TYPE, whose GLib helpers are pointer-valued at every API
ceiling. The mkenums templates use pointer once initialization; libmbim's
GLib 2.56 ceiling hides it, so, as in Meson's enum template, the calls are
parenthesized and wrapped to silence availability warnings.

diff --git a/build-aux/templates/mbim-enum-types.c.template b/build-aux/templates/mbim-enum-types.c.template
index 0fa59a6..6d24625 100644
--- a/build-aux/templates/mbim-enum-types.c.template
+++ b/build-aux/templates/mbim-enum-types.c.template
@@ -18,20 +18,22 @@ static const G@Type@Value @enum_name@_values[] = {
 
 /* Define type-specific symbols */
 
+G_GNUC_BEGIN_IGNORE_DEPRECATIONS
 GType
 @enum_name@_get_type (void)
 {
-    static gsize g_define_type_id_initialized = 0;
+    static GType g_define_type_id_initialized = 0;
 
-    if (g_once_init_enter (&g_define_type_id_initialized)) {
+    if ((g_once_init_enter_pointer) (&g_define_type_id_initialized)) {
         GType g_define_type_id =
             g_@type@_register_static (g_intern_static_string ("@EnumName@"),
                                       @enum_name@_values);
-        g_once_init_leave (&g_define_type_id_initialized, g_define_type_id);
+        (g_once_init_leave_pointer) (&g_define_type_id_initialized, g_define_type_id);
     }
 
     return g_define_type_id_initialized;
 }
+G_GNUC_END_IGNORE_DEPRECATIONS
 
