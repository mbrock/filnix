[Unit]
Description=Mirror committed Filnix analytics to the unlisted share prefix
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/filnix-analytics/share.json

[Service]
Type=oneshot
User=filnix-analytics
Group=filnix-observe
UMask=0077
WorkingDirectory=/var/lib/filnix-analytics
LoadCredential=aws:/etc/filnix-analytics/aws-credentials
LoadCredential=share:/etc/filnix-analytics/share.json
Environment=AWS_SHARED_CREDENTIALS_FILE=%d/aws
Environment=AWS_EC2_METADATA_DISABLED=true
ExecStart=/opt/filnix-analytics/bin/filnix-analytics-share --config %d/share
TimeoutStartSec=2h
MemoryMax=1G
CPUQuota=200%
Nice=19
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/filnix-analytics
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
