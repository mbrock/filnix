[Unit]
Description=Publish read-only Filnix campaign observations and logs to private S3
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=filnix-analytics
Group=filnix-observe
UMask=0077
WorkingDirectory=/var/lib/filnix-analytics
LoadCredential=aws:/etc/filnix-analytics/aws-credentials
Environment=AWS_SHARED_CREDENTIALS_FILE=%d/aws
Environment=AWS_EC2_METADATA_DISABLED=true
ExecStart=/opt/filnix-analytics/bin/filnix-analytics --config /etc/filnix-analytics/config.json
TimeoutStartSec=2h
MemoryMax=3G
CPUQuota=200%
Nice=19
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/filnix-experiment
ReadWritePaths=/var/lib/filnix-analytics
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
