#!/usr/bin/env bash
# Install separately from the controller/dashboard. Credentials stay root-private.
set -euo pipefail
if [[ $EUID != 0 || $# != 2 || $1 != /nix/store/* || ! -x $1/bin/filnix-analytics ]]; then
  echo 'Usage: sudo deploy/analytics/install /nix/store/...-filnix-analytics BUCKET' >&2
  exit 2
fi
test -s /etc/filnix-analytics/aws-credentials
deploy_dir=$(cd -- "$(dirname -- "$0")" && pwd)
getent group filnix-observe >/dev/null
id filnix-analytics >/dev/null 2>&1 || useradd --system --gid filnix-observe --home-dir /var/lib/filnix-analytics --shell /usr/sbin/nologin filnix-analytics
install -d -o filnix-analytics -g filnix-observe -m 0700 /var/lib/filnix-analytics
install -d -m 0755 /etc/filnix-analytics
chmod 0600 /etc/filnix-analytics/aws-credentials
chown root:root /etc/filnix-analytics/aws-credentials
python3 - "$2" <<'PY'
import json, sys
from pathlib import Path
p = Path('/etc/filnix-analytics/config.json')
if p.exists() and json.loads(p.read_text())['bucket'] != sys.argv[1]:
    raise SystemExit('Existing checkpoint belongs to a different bucket; review before moving it')
if not p.exists():
    p.write_text(json.dumps(dict(
        bucket=sys.argv[1], region='eu-central-1', prefix='campaign/v1',
        experiment='/var/lib/filnix-experiment', state='/var/lib/filnix-analytics',
        log_bytes=1024**3, reserve_bytes=20*1024**3,
    ), indent=2)+'\n')
    p.chmod(0o644)
PY
ln -sfn "$1" /opt/filnix-analytics
ln -sfn /opt/filnix-analytics /nix/var/nix/gcroots/filnix-analytics-application
install -m 0644 "$deploy_dir/filnix-analytics.service" "$deploy_dir/filnix-analytics.timer" /etc/systemd/system/
systemctl daemon-reload
echo 'Installed. Run filnix-analytics.service, verify the first dataset, then enable filnix-analytics.timer.'
