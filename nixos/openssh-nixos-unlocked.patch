NixOS writes "!" as the password of every user that has none, so without
PAM sshd took them all for locked accounts and refused even their keys.
With PAM, as NixOS's own sshd runs, sshd never makes this check; the Fil-C
sshd runs without PAM, so it skips it too.

--- a/auth.c
+++ b/auth.c
@@ -105,12 +105,6 @@
 	if (!pw || !pw->pw_name)
 		return 0;
 
-	if (!options.use_pam && platform_locked_account(pw)) {
-		logit("User %.100s not allowed because account is locked",
-		    pw->pw_name);
-		return 0;
-	}
-
 	/*
 	 * Deny if shell does not exist or is not executable unless we
 	 * are chrooting.
