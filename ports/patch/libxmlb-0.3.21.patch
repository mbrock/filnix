index 379375d..bdec108 100644
--- a/meson.build
+++ b/meson.build
@@ -147,7 +147,9 @@ endif
 # available in Debian Stable. Use of more modern API has to be optional and
 # protected by GLIB_CHECK_VERSION.
 add_project_arguments('-DGLIB_VERSION_MIN_REQUIRED=GLIB_VERSION_2_46', language: 'c')
-add_project_arguments('-DGLIB_VERSION_MAX_ALLOWED=GLIB_VERSION_2_58', language: 'c')
+# Fil-C: GLIB_VERSION_MAX_ALLOWED must be >= 2.80 so that G_DEFINE_TYPE
+# uses g_once_init_enter_pointer (GType is a pointer under Fil-C).
+add_project_arguments('-DGLIB_VERSION_MAX_ALLOWED=GLIB_VERSION_2_80', language: 'c')
 
 libxmlb_deps = [
   gio,
diff --git a/src/generate-version-script.py b/src/generate-version-script.py
index a8a3825..225e9bf 100644
--- a/src/generate-version-script.py
+++ b/src/generate-version-script.py
@@ -113,6 +113,9 @@ class LdVersionScript:
             symbols = sorted(self.releases[version])
             verout += "\n%s_%s {\n" % (self.library_name, version)
             verout += "  global:\n"
+            # Fil-C: the pizlonator renames symbols with a pizlonated_
+            # prefix, so the wildcard has to be exported as well.
+            verout += "    pizlonated*;\n"
             for symbol in symbols:
                 verout += "    %s;\n" % symbol
             verout += "  local: *;\n"
