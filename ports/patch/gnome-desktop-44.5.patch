diff --git a/libgnome-desktop/base-symbol.map b/libgnome-desktop/base-symbol.map
index 9a0a60d..532af8f 100644
--- a/libgnome-desktop/base-symbol.map
+++ b/libgnome-desktop/base-symbol.map
@@ -1,6 +1,10 @@
 {
 global:
   gnome_*;
+  /* Fil-C: the pizlonator renames symbol references with a pizlonated_
+     prefix; the thunks must stay exported for the sibling libraries
+     (libgnome-bg-4, libgnome-rr-4) to link. */
+  pizlonated*;
 local:
   gnome_desktop_thumbnail_script_exec;
   *;
