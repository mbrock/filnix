diff --git a/libgnome-desktop/gnome-rr/gnome-rr-screen.c b/libgnome-desktop/gnome-rr/gnome-rr-screen.c
index 90914d1..9e8eb7b 100644
--- a/libgnome-desktop/gnome-rr/gnome-rr-screen.c
+++ b/libgnome-desktop/gnome-rr/gnome-rr-screen.c
@@ -2445,9 +2445,13 @@ gnome_rr_output_get_tile_info (const GnomeRROutput *output,
 GType
 gnome_rr_dpms_mode_get_type (void)
 {
+  /* Fil-C port: etype is a GType (a capability pointer under Fil-C), so the
+     pointer variants of g_once_init_enter/leave must be used — the plain
+     variants pass the value through a gsize, which strips the capability and
+     makes every later use of GNOME_RR_TYPE_DPMS_MODE panic. */
   static GType etype = 0;
 
-  if (g_once_init_enter (&etype)) {
+  if (g_once_init_enter_pointer (&etype)) {
     static const GEnumValue values[] = {
       { GNOME_RR_DPMS_ON, "GNOME_RR_DPMS_ON", "on" },
       { GNOME_RR_DPMS_STANDBY, "GNOME_RR_DPMS_STANDBY", "standby" },
@@ -2458,7 +2462,7 @@ gnome_rr_dpms_mode_get_type (void)
     };
     GType g_define_type = g_enum_register_static ("GnomeRRDpmsModeType", values);
 
-    g_once_init_leave (&etype, g_define_type);
+    g_once_init_leave_pointer (&etype, g_define_type);
   }
   return etype;
 }
