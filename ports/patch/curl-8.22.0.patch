+#ifndef HEADER_CURL_CA_BUNDLE_H
+#define HEADER_CURL_CA_BUNDLE_H
+/***************************************************************************
+ *                                  _   _ ____  _
+ *  Project                     ___| | | |  _ \| |
+ *                             / __| | | | |_) | |
+ *                            | (__| |_| |  _ <| |___
