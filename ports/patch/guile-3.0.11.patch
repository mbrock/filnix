+   STRONG, the object stays alive until it is freed, as C memory whose
+   address a program keeps as an integer would; this is for
+   pointer-address.  Otherwise it is recorded weakly (object-address).  */
+uintptr_t
+scm_i_pointer_to_address (void *ptr, int strong)
+{
+#ifdef __FILC__
+  if (zhasvalidcap (ptr))
+    {
+      if (!strong)
+        return zexact_ptrtable_encode (scm_i_weak_refs, ptr);
+      scm_i_pthread_once (&address_refs_once, init_address_refs);
+      return zexact_ptrtable_encode (address_refs, ptr);
+    }
+#endif
+  return (uintptr_t) ptr;
