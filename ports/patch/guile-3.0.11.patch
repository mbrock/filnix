+/* Turn a code address that Scheme has as an integer back into a pointer
+   into the arena that holds it, or NULL.  Under Fil-C an integer has no
+   capability, so the pointer is derived from the arena itself.  */
+const uint32_t *
+scm_i_primitive_code_from_address (uintptr_t addr)
+{
+  const uint32_t *ret = NULL;
+  struct code_arena *arena;
+
+  scm_i_pthread_mutex_lock (&admin_mutex);
+  for (arena = code_arena; arena; arena = arena->next)
+    if ((uintptr_t) &arena->data[0] <= addr
+        && addr < (uintptr_t) &arena->data[arena->used])
+      {
+        ret = (const uint32_t *)
+          &arena->data[addr - (uintptr_t) &arena->data[0]];
+        break;
+      }
+  scm_i_pthread_mutex_unlock (&admin_mutex);
+
+  return ret;
+}
