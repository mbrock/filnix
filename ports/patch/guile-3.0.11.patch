+/* Scheme code sometimes turns an object's address, as an integer, back
+   into a pointer or an SCM (make-pointer, pointer->scm).  Under Fil-C
+   an integer has no capability, so derive the pointer from the ELF
+   image that contains the address, or from the tables in which
+   scm_i_pointer_to_address records the objects whose addresses it
+   hands out.  Otherwise the result has no capability, and using it
+   traps.  */
+#ifdef __FILC__
+static zexact_ptrtable *address_refs;
+static scm_i_pthread_once_t address_refs_once = SCM_I_PTHREAD_ONCE_INIT;
+static void
+init_address_refs (void)
+{
+  address_refs = zexact_ptrtable_new ();
+}
+#endif
+
+void *
+scm_i_pointer_from_address (uintptr_t addr)
+{
+#ifdef __FILC__
+  void *ret = NULL;
+
+  scm_i_pthread_mutex_lock (&scm_i_misc_mutex);
+  {
+    struct mapped_elf_image *img = find_mapped_elf_image_unlocked ((char *) addr);
+    if (img)
+      ret = img->start + (addr - (uintptr_t) img->start);
+  }
+  scm_i_pthread_mutex_unlock (&scm_i_misc_mutex);
+
+  if (!ret)
+    {
+      scm_i_pthread_once (&address_refs_once, init_address_refs);
+      ret = zexact_ptrtable_decode (address_refs, addr);
+    }
+  if (!zhasvalidcap (ret))
+    ret = zexact_ptrtable_decode (scm_i_weak_refs, addr);
+  return ret;
+#else
+  return (void *) addr;
+#endif
