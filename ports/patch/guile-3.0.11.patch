+/* Weak references.  Boehm keeps weak references in memory that it does
+   not trace (atomic objects or typed objects with a bitmap).  Fil-C's
+   collector traces every pointer-typed word precisely, and a pointer
+   stored as an integer loses its capability.  So under Fil-C a weak
+   slot holds an integer that has no capability (the collector ignores
+   it), obtained from a weak exact pointer table, and reading the slot
+   turns it back into a pointer through that table.  If the object has
+   died, the table gives NULL, as if its disappearing link had already
+   been cleared.  Without Fil-C both operations are the identity.  */
+#ifdef __FILC__
+#include <stdfil.h>
+#include "libguile/scm.h"
+
+SCM_INTERNAL zexact_ptrtable *scm_i_weak_refs;
+
+static inline SCM
+scm_i_weak_hide (SCM x)
+{
+  if (SCM_UNPACK (x) && SCM_HEAP_OBJECT_P (x))
+    return SCM_PACK ((scm_t_bits) zexact_ptrtable_encode (scm_i_weak_refs,
+                                                          SCM_UNPACK_POINTER (x)));
+  return x;
+}
+
+static inline SCM
+scm_i_weak_reveal (SCM x)
+{
+  if (SCM_UNPACK (x) && SCM_HEAP_OBJECT_P (x) && !zhasvalidcap (x))
+    {
+      void *p = zexact_ptrtable_decode (scm_i_weak_refs, SCM_UNPACK (x));
+      /* A dead object decodes to its address without a capability.  */
+      return zhasvalidcap (p) ? SCM_PACK_POINTER (p) : SCM_PACK (0);
+    }
+  return x;
+}
+#else
+#define scm_i_weak_hide(x) (x)
+#define scm_i_weak_reveal(x) (x)
+#endif
