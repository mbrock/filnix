diff --git a/src/pulsecore/atomic.h b/src/pulsecore/atomic.h
index b5036ad..31274b8 100644
--- a/src/pulsecore/atomic.h
+++ b/src/pulsecore/atomic.h
@@ -103,6 +103,34 @@ static inline bool pa_atomic_cmpxchg(pa_atomic_t *a, int old_i, int new_i) {
     return __sync_bool_compare_and_swap(&a->value, old_i, new_i);
 }
 
+/* Fil-C: keep the atomic slot a real pointer, not a uintptr_t.  Upstream
+ * round-trips pointers through an integer slot, which under Fil-C strips the
+ * pointer's object metadata; loading such a value back into a pa_mutex* (via
+ * pa_static_mutex_get) and dereferencing it panics ("cannot read pointer with
+ * null object" in pa_mutex_unlock).  A void* slot with the same __atomic/
+ * __sync builtins keeps the metadata; the struct stays 8 bytes / same
+ * alignment, so all the embedded uses (pa_static_mutex, pa_flist, asyncq
+ * cells, pa_memblock data, semaphores) are layout-identical. */
+#if defined(__FILC__)
+typedef struct pa_atomic_ptr {
+    void *volatile value;
+} pa_atomic_ptr_t;
+
+#define PA_ATOMIC_PTR_INIT(v) { .value = (v) }
+
+static inline void* pa_atomic_ptr_load(const pa_atomic_ptr_t *a) {
+    return __atomic_load_n(&a->value, __ATOMIC_SEQ_CST);
+}
+
+static inline void pa_atomic_ptr_store(pa_atomic_ptr_t *a, void* p) {
+    __atomic_store_n(&a->value, p, __ATOMIC_SEQ_CST);
+}
+
+static inline bool pa_atomic_ptr_cmpxchg(pa_atomic_ptr_t *a, void *old_p, void* new_p) {
+    return __sync_bool_compare_and_swap(&a->value, old_p, new_p);
+}
+#else /* !__FILC__ */
+
 typedef struct pa_atomic_ptr {
     volatile uintptr_t value;
 } pa_atomic_ptr_t;
@@ -138,6 +166,7 @@ static inline void pa_atomic_ptr_store(pa_atomic_ptr_t *a, void *p) {
 static inline bool pa_atomic_ptr_cmpxchg(pa_atomic_ptr_t *a, void *old_p, void* new_p) {
     return __sync_bool_compare_and_swap(&a->value, (uintptr_t) old_p, (uintptr_t) new_p);
 }
+#endif /* !__FILC__ */
 
 #elif defined(__NetBSD__) && defined(HAVE_SYS_ATOMIC_H)
 
