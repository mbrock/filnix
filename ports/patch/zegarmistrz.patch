+    uint64_t clear_ctid_addr = 0; // CLONE_CHILD_CLEARTID address to clear+wake on exit
+    uint64_t robust_list = 0;
+    uint64_t rseq_addr = 0;
+
+    bool exited = false;
+
+    Emulator* emu = nullptr;
