diff --git a/src/basic/sigbus.c b/src/basic/sigbus.c
index a365801..c5e7729 100644
--- a/src/basic/sigbus.c
+++ b/src/basic/sigbus.c
@@ -12,6 +12,14 @@
 #include "sigbus.h"
 #include "signal-util.h"
 
+/* Fil-C: the pizlonator runtime owns SIGBUS handling (it relies on the signal
+ * internally, and a program re-registering a SIGBUS handler trips a runtime
+ * assertion - loginctl aborted exactly that way).  elogind's SIGBUS workaround
+ * (remap a faulting mmap page so execution can continue) must therefore not
+ * run under Fil-C, so the whole mechanism below is compiled out and
+ * sigbus_install()/sigbus_pop() are empty functions with unchanged
+ * signatures. */
+#if 0
 #define SIGBUS_QUEUE_MAX 64
 
 static struct sigaction old_sigaction;
@@ -122,35 +130,15 @@ static void sigbus_handler(int sn, siginfo_t *si, void *data) {
         assert_se(mmap(aligned, page_size(), PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED, -1, 0) == aligned);
 }
 
-void sigbus_install(void) {
-        struct sigaction sa = {
-                .sa_sigaction = sigbus_handler,
-                .sa_flags = SA_SIGINFO,
-        };
-
-        /* make sure that sysconf() is not called from a signal handler because
-        * it is not guaranteed to be async-signal-safe since POSIX.1-2008 */
-        (void) page_size();
-
-        n_installed++;
+#endif // Fil-C: the SIGBUS mechanism above is compiled out
 
-        if (n_installed == 1)
-                assert_se(sigaction(SIGBUS, &sa, &old_sigaction) == 0);
-
-        return;
+void sigbus_install(void) {
+        /* Fil-C owns SIGBUS handling; there is nothing to install. */
 }
 
 #if 0 /// UNNEEDED by elogind
-void sigbus_reset(void) {
-
-        if (n_installed <= 0)
-                return;
-
-        n_installed--;
-
-        if (n_installed == 0)
-                assert_se(sigaction(SIGBUS, &old_sigaction, NULL) == 0);
-
-        return;
+int sigbus_pop(void **ret) {
+        (void) ret;
+        return 0;
 }
 #endif // 0
