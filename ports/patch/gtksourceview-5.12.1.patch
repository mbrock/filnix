 {
-	static FcConfig *map_font_config;
+	static gpointer map_font_config; /* Fil-C: once-init statics for pointers use the _pointer variants. */
 	PangoFontMap *font_map = NULL;
 
 	font_map = pango_cairo_font_map_new_for_font_type (CAIRO_FONT_TYPE_FT);
@@ -982,7 +982,7 @@ load_override_font_fc (void)
 		return NULL;
 	}
 
