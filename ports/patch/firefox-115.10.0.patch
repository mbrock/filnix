index 0000000..d81a429
--- /dev/null
+++ b/js/src/util/EncodingStubs.cpp
@@ -0,0 +1,612 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * vim: set ts=8 sts=2 et sw=2 tw=80:
+ *
+ * Fil-C port: C++ implementations of the encoding_c / encoding_c_mem C API
+ * that SpiderMonkey's mfbt (Latin1.h, TextUtils.h, Utf8.h) uses. Upstream
+ * these are implemented in Rust (the jsrust crate), which is not built for
+ * Fil-C (no rustc in the toolchain). The semantics follow encoding_rs:
+ *
+ * - "valid up to" functions return the length of the longest prefix that
+ *   satisfies the predicate, ending on a code-unit boundary.
+ * - Conversions from UTF-8/UTF-16 replace malformed sequences with
+ *   U+FFFD (REPLACEMENT CHARACTER) using the "maximal subpart" rule.
+ * - Latin1 conversions treat each byte as a code point value U+0000..U+00FF.
+ * - The "_lossy" UTF-16/UTF-8 -> Latin1 conversions map code points above
+ *   U+00FF to 0x1A (SUB). encoding_rs documents "no promises" for those
+ *   inputs; callers normally ensure Latin1-ness first.
+ *
+ * Character-classification is kept byte/unit-wise and simple; performance
+ * is not a concern here (the Rust versions use SIMD; we do not).
+ */
+
+#include "mozilla/Assertions.h"
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+// 0x1A is ASCII SUB (substitute), a reasonable "no promises" mapping for
+// code points outside Latin-1 in the lossy conversions.
+static const char16_t kReplacementChar = 0xFFFD;
+static const unsigned char kLossyByte = 0x1A;
+
+extern "C" {
+
+bool encoding_mem_is_ascii(const char* buffer, size_t len) {
+  for (size_t i = 0; i < len; i++) {
+    if (static_cast<unsigned char>(buffer[i]) >= 0x80) {
+      return false;
+    }
+  }
+  return true;
+}
+
+size_t encoding_ascii_valid_up_to(const uint8_t* buffer, size_t buffer_len) {
+  for (size_t i = 0; i < buffer_len; i++) {
+    if (buffer[i] >= 0x80) {
+      return i;
+    }
+  }
+  return buffer_len;
+}
+
+bool encoding_mem_is_basic_latin(const char16_t* buffer, size_t len) {
+  for (size_t i = 0; i < len; i++) {
+    if (buffer[i] >= 0x80) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool encoding_mem_is_utf16_latin1(const char16_t* buffer, size_t len) {
+  for (size_t i = 0; i < len; i++) {
+    if (buffer[i] > 0xFF) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool encoding_mem_is_str_latin1(const char* buffer, size_t len) {
+  // A UTF-8 string is Latin1 iff every code point is <= U+00FF, i.e. every
+  // byte is ASCII or starts a valid two-byte sequence C2..DF.
+  for (size_t i = 0; i < len;) {
+    unsigned char b = static_cast<unsigned char>(buffer[i]);
+    if (b < 0x80) {
+      i++;
+      continue;
+    }
+    if (b >= 0xC2 && b <= 0xDF && i + 1 < len) {
+      unsigned char c = static_cast<unsigned char>(buffer[i + 1]);
+      if (c >= 0x80 && c <= 0xBF) {
+        i += 2;
+        continue;
+      }
+    }
+    return false;
+  }
+  return true;
+}
+
+bool encoding_mem_is_utf8_latin1(const char* buffer, size_t len) {
+  return encoding_mem_is_str_latin1(buffer, len);
+}
+
+size_t encoding_mem_str_latin1_up_to(const char* buffer, size_t len) {
+  size_t i = 0;
+  while (i < len) {
+    unsigned char b = static_cast<unsigned char>(buffer[i]);
+    if (b < 0x80) {
+      i++;
+      continue;
+    }
+    if (b >= 0xC2 && b <= 0xDF && i + 1 < len) {
+      unsigned char c = static_cast<unsigned char>(buffer[i + 1]);
+      if (c >= 0x80 && c <= 0xBF) {
+        i += 2;
+        continue;
+      }
+    }
+    break;
+  }
+  return i;
+}
+
+size_t encoding_mem_utf8_latin1_up_to(const char* buffer, size_t len) {
+  return encoding_mem_str_latin1_up_to(buffer, len);
+}
+
+size_t encoding_utf8_valid_up_to(const uint8_t* buffer, size_t buffer_len) {
+  // Longest valid UTF-8 prefix in bytes.
+  size_t i = 0;
+  while (i < buffer_len) {
+    uint8_t b = buffer[i];
+    if (b < 0x80) {
+      i++;
+      continue;
+    }
+    size_t need;
+    uint8_t lo;
+    uint8_t hi;
+    if (b >= 0xC2 && b <= 0xDF) {
+      need = 1;
+      lo = 0x80;
+      hi = 0xBF;
+    } else if (b == 0xE0) {
+      need = 2;
+      lo = 0xA0;
+      hi = 0xBF;
+    } else if ((b >= 0xE1 && b <= 0xEC) || b == 0xEE || b == 0xEF) {
+      need = 2;
+      lo = 0x80;
+      hi = 0xBF;
+    } else if (b == 0xED) {
+      need = 2;
+      lo = 0x80;
+      hi = 0x9F;
+    } else if (b == 0xF0) {
+      need = 3;
+      lo = 0x90;
+      hi = 0xBF;
+    } else if (b >= 0xF1 && b <= 0xF3) {
+      need = 3;
+      lo = 0x80;
+      hi = 0xBF;
+    } else if (b == 0xF4) {
+      need = 3;
+      lo = 0x80;
+      hi = 0x8F;
+    } else {
+      return i;  // invalid lead byte
+    }
+    if (i + need >= buffer_len + 1 && i + need > buffer_len) {
+      // Not enough bytes left for the whole sequence: stop before it.
+      return i;
+    }
+    if (i + need > buffer_len) {
+      return i;
+    }
+    for (size_t j = 1; j <= need; j++) {
+      uint8_t c = buffer[i + j];
+      uint8_t clo = (j == 1) ? lo : 0x80;
+      uint8_t chi = (j == 1) ? hi : 0xBF;
+      if (c < clo || c > chi) {
+        return i;
+      }
+    }
+    i += need + 1;
+  }
+  return i;
