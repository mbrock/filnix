+    unsigned char b = static_cast<unsigned char>(src[read]);
+    size_t need = (b < 0x80) ? 1 : 2;
+    if (written + need > dst_cap) {
+      break;
+    }
+    if (b < 0x80) {
+      dst[written++] = static_cast<char>(b);
+    } else {
+      dst[written++] = static_cast<char>(0xC0 | (b >> 6));
+      dst[written++] = static_cast<char>(0x80 | (b & 0x3F));
+    }
+    read++;
+  }
+  *src_len = read;
+  *dst_len = written;
