+
+// Decode one code point from UTF-16 at src[i] (len units total). On unpaired
+// surrogates, emits U+FFFD and consumes one unit. Returns units consumed and
+// stores the code point in *cp.
+static size_t decode_utf16_cp(const char16_t* src, size_t i, size_t len,
+                              uint32_t* cp) {
+  char16_t u = src[i];
+  if (u < 0xD800 || u > 0xDFFF) {
+    *cp = u;
+    return 1;
+  }
+  if (u <= 0xDBFF && i + 1 < len && src[i + 1] >= 0xDC00 &&
+      src[i + 1] <= 0xDFFF) {
+    uint32_t hi = u - 0xD800;
+    uint32_t lo = src[i + 1] - 0xDC00;
+    *cp = 0x10000 + (hi << 10) + lo;
+    return 2;
+  }
+  *cp = kReplacementChar;
+  return 1;
+}
+
+size_t encoding_mem_convert_utf16_to_utf8(const char16_t* src, size_t src_len,
+                                          char* dst, size_t dst_len) {
+  MOZ_ASSERT(dst_len >= 3 * src_len);
+  size_t written = 0;
+  size_t i = 0;
+  while (i < src_len) {
+    uint32_t cp;
+    i += decode_utf16_cp(src, i, src_len, &cp);
+    written += encode_utf8_cp(cp, dst + written, dst_len - written);
+  }
+  return written;
+}
+
+void encoding_mem_convert_utf16_to_utf8_partial(const char16_t* src,
+                                                size_t* src_len, char* dst,
+                                                size_t* dst_len) {
+  size_t read = 0;
+  size_t written = 0;
+  size_t dst_cap = *dst_len;
+  while (read < *src_len) {
+    uint32_t cp;
+    size_t consumed = decode_utf16_cp(src, read, *src_len, &cp);
+    // Per encodeInto() semantics, an unpaired surrogate at the very end of
+    // the input is converted even if it is the last thing that fits.
+    size_t need = (cp <= 0x7F)     ? 1
+                  : (cp <= 0x7FF)  ? 2
+                  : (cp <= 0xFFFF) ? 3
+                                   : 4;
+    if (written + need > dst_cap) {
+      break;
+    }
+    written += encode_utf8_cp(cp, dst + written, dst_cap - written);
+    read += consumed;
+  }
+  *src_len = read;
+  *dst_len = written;
+}
