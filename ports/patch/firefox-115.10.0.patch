+size_t encoding_mem_convert_str_to_utf16(const char* src, size_t src_len,
+                                         char16_t* dst, size_t dst_len) {
+  // Input is valid UTF-8 (caller's responsibility). dst_len >= src_len.
+  MOZ_ASSERT(dst_len >= src_len);
