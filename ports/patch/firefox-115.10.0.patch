+
+size_t encoding_mem_utf16_valid_up_to(const char16_t* buffer, size_t len) {
+  for (size_t i = 0; i < len; i++) {
+    char16_t u = buffer[i];
+    if (u >= 0xD800 && u <= 0xDFFF) {
+      if (u <= 0xDBFF && i + 1 < len && buffer[i + 1] >= 0xDC00 &&
+          buffer[i + 1] <= 0xDFFF) {
+        i++;  // valid pair
+        continue;
+      }
+      return i;  // unpaired surrogate
+    }
+  }
+  return len;
