diff --git a/meson.build b/meson.build
index cf494c2..3622708 100644
--- a/meson.build
+++ b/meson.build
@@ -206,6 +206,12 @@ if enable_logind
   config_data.set10('HAVE_' + func.to_upper(), cc.has_function(func, dependencies: logind_dep))
 endif
 config_data.set('HAVE_LIBSYSTEMD', enable_logind)
+# pizlix/Fil-C: elogind provides the same sd_* API through <elogind/sd-*.h>;
+# upstream's guards conflate "session tracking via sd-login" with "built
+# against systemd", which breaks the elogind build (no systemd headers).
+if session_tracking == 'elogind'
+  config_data.set('HAVE_LIBELOGIND', true)
+endif
 
