diff --git a/meson-postinstall.sh b/meson-postinstall.sh
index 39ed378..48d5b7d 100644
--- a/meson-postinstall.sh
+++ b/meson-postinstall.sh
@@ -2,6 +2,10 @@
 
 # Package managers set this so we don't need to run
 if [ -z "$DESTDIR" ]; then
-  echo Updating desktop database...
-  update-desktop-database -q ${MESON_INSTALL_PREFIX}/share/applications
+  # Fil-C: update-desktop-database (desktop-file-utils) is not part of the
+  # pizlonated system yet; only refresh the MIME database when it exists.
+  if command -v update-desktop-database >/dev/null 2>&1; then
+    echo Updating desktop database...
+    update-desktop-database -q ${MESON_INSTALL_PREFIX}/share/applications
+  fi
 fi
