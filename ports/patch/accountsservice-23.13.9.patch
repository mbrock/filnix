diff --git a/src/libaccountsservice/symbol.map b/src/libaccountsservice/symbol.map
index e7b7bb5..be590b3 100644
--- a/src/libaccountsservice/symbol.map
+++ b/src/libaccountsservice/symbol.map
@@ -1,4 +1,10 @@
 {
-    local:
+    global:
+        /* Fil-C pizlonation exports pizlonated_<name> aliases for every
+         * exported function, and the daemon / g-ir-scanner dumper reference
+         * those aliases directly; they must not be caught by "local: *". */
+        pizlonated*;
         _*;
+    local:
+        *;
 };
