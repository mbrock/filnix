@@ -1442,11 +1442,21 @@
 /* non-pointer slots of "typed" objects is equivalent to        */
 /* disguising them in this way, and may have other advantages.  */
 typedef GC_word GC_hidden_pointer;
+#ifdef __FILC__
+  /* Fil-C: (~(GC_word)p) loses p's capability, so hiding goes through  */
+  /* a weak pointer table in the FUGC-backed libgc.  Revealing gives    */
+  /* back a usable pointer while the object is alive.                   */
+  GC_API GC_hidden_pointer GC_CALL GC_fugc_hide_pointer(const void *);
+  GC_API void * GC_CALL GC_fugc_reveal_pointer(GC_hidden_pointer);
+# define GC_HIDE_POINTER(p) GC_fugc_hide_pointer((const void *)(p))
+# define GC_REVEAL_POINTER(p) GC_fugc_reveal_pointer((GC_hidden_pointer)(p))
+#else
 #define GC_HIDE_POINTER(p) (~(GC_hidden_pointer)(p))
 /* Converting a hidden pointer to a real pointer requires verifying     */
 /* that the object still exists.  This involves acquiring the           */
 /* allocator lock to avoid a race with the collector.                   */
 #define GC_REVEAL_POINTER(p) ((void *)GC_HIDE_POINTER(p))
+#endif
 
