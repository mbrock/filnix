# Canonical public viewer, with compatibility redirects for old session links.
nix.swa.sh {
    redir /v2 / 308
    handle_path /v2/* {
        redir {uri} 308
    }
    redir /cache /cache/
    handle_path /cache/* {
        root * /var/www/filnix-cache
        @public_key path /cache.pub
        header @public_key Cache-Control "no-cache"
        @objects path /nar/* *.narinfo
        header @objects Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:8778
    }
}
