diff --git a/simd/x86_64/jsimd.c b/simd/x86_64/jsimd.c
index 8cfd38b..1107b48 100644
--- a/simd/x86_64/jsimd.c
+++ b/simd/x86_64/jsimd.c
@@ -992,8 +992,11 @@ jsimd_can_idct_float(void)
   if (sizeof(FLOAT_MULT_TYPE) != 4)
     return 0;
 
+#ifndef __FILC__
+  /* SaRCAsm cannot model the walking pointer into the stack workspace. */
   if ((simd_support & JSIMD_SSE2) && IS_ALIGNED_SSE(jconst_idct_float_sse2))
     return 1;
+#endif
 
   return 0;
 }
@@ -1028,8 +1031,10 @@ jsimd_idct_float(j_decompress_ptr cinfo, jpeg_component_info *compptr,
                  JCOEFPTR coef_block, JSAMPARRAY output_buf,
                  JDIMENSION output_col)
 {
+#ifndef __FILC__
   jsimd_idct_float_sse2(compptr->dct_table, coef_block, output_buf,
                         output_col);
+#endif
 }
 
 GLOBAL(int)
@@ -1042,9 +1047,12 @@ jsimd_can_huff_encode_one_block(void)
   if (sizeof(JCOEF) != 2)
     return 0;
 
+#ifndef __FILC__
+  /* SaRCAsm cannot model the walking pointer into the stack block. */
   if ((simd_support & JSIMD_SSE2) && simd_huffman &&
       IS_ALIGNED_SSE(jconst_huff_encode_one_block))
     return 1;
+#endif
 
   return 0;
 }
@@ -1054,8 +1062,12 @@ jsimd_huff_encode_one_block(void *state, JOCTET *buffer, JCOEFPTR block,
                             int last_dc_val, c_derived_tbl *dctbl,
                             c_derived_tbl *actbl)
 {
+#ifndef __FILC__
