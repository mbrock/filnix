+% The profile's marks: the passes run on the stream without them, and
+% the function's code is followed by the marked stream they ran on, as
+% comments, which bench/profile/remark.py aligns with it.
+pf_pairs([], _, []).
+pf_pairs([mark(A)|Ls], Ms, Ps) :- !, append(Ms, [mark(A)], Ms1), pf_pairs(Ls, Ms1, Ps).
+pf_pairs([L|Ls], Ms, [Ms-L|Ps]) :- pf_pairs(Ls, [], Ps).
