+(** A byte as it is written inside a C++ character or string literal.
+    Anything but a plain printable character is three octal digits, which
+    is a whole escape, so a digit after it is never read into it. *)
+let cpp_escaped_byte c =
+  let n = Char.code c in
+  if n >= 32 && n < 127 && c <> '\\' && c <> '\'' && c <> '"' && c <> '?'
+  then String.make 1 c
+  else Printf.sprintf "\\%03o" n
+
+(** A string as a C++ [std::string] expression, by its length, so that a
+    zero byte does not end it. *)
+let cpp_string_literal s =
+  let buf = Buffer.create (String.length s + 16) in
+  String.iter (fun c -> Buffer.add_string buf (cpp_escaped_byte c)) s;
+  Printf.sprintf "std::string(\"%s\", %d)" (Buffer.contents buf) (String.length s)
+
+(** A character as a C++ [char] literal. *)
+let cpp_char_literal c = "'" ^ cpp_escaped_byte c ^ "'"
+
 (** Pretty-print an ascii constructor as a C++ char literal. *)
 let pp_native_char c = str ("'" ^ Char.escaped (get_native_char c) ^ "'")
 
