func(adds, export, w, [par(w, t(a)), par(w, t(b))], [
    blk(start, [], [
        ins(t(x), s, cast, [t(a)]),
        ins(t(y), s, cast, [t(b)]),
        ins(t(z), s, add, [t(x), t(y)]),
        ins(t(r), w, cast, [t(z)])
    ], ret(t(r)))
]).
