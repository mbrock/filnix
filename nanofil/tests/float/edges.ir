% Pack all eight comparison results into a bitmask.
func(cmps, export, w, [param(w, tmp(a)), param(w, tmp(b))], [
    block(start, [], [
        let(tmp(x), s, cast, [tmp(a)]),
        let(tmp(y), s, cast, [tmp(b)]),
        let(tmp(a0), w, cmp(eq, s), [tmp(x), tmp(y)]),
        let(tmp(a1), w, cmp(ne, s), [tmp(x), tmp(y)]),
        let(tmp(a2), w, cmp(le, s), [tmp(x), tmp(y)]),
        let(tmp(a3), w, cmp(lt, s), [tmp(x), tmp(y)]),
        let(tmp(a4), w, cmp(ge, s), [tmp(x), tmp(y)]),
        let(tmp(a5), w, cmp(gt, s), [tmp(x), tmp(y)]),
        let(tmp(a6), w, cmp(o, s), [tmp(x), tmp(y)]),
        let(tmp(a7), w, cmp(uo, s), [tmp(x), tmp(y)]),
        let(tmp(b1), w, shl, [tmp(a1), const(1)]),
        let(tmp(b2), w, shl, [tmp(a2), const(2)]),
        let(tmp(b3), w, shl, [tmp(a3), const(3)]),
        let(tmp(b4), w, shl, [tmp(a4), const(4)]),
        let(tmp(b5), w, shl, [tmp(a5), const(5)]),
        let(tmp(b6), w, shl, [tmp(a6), const(6)]),
        let(tmp(b7), w, shl, [tmp(a7), const(7)]),
        let(tmp(c1), w, or, [tmp(a0), tmp(b1)]),
        let(tmp(c2), w, or, [tmp(c1), tmp(b2)]),
        let(tmp(c3), w, or, [tmp(c2), tmp(b3)]),
        let(tmp(c4), w, or, [tmp(c3), tmp(b4)]),
        let(tmp(c5), w, or, [tmp(c4), tmp(b5)]),
        let(tmp(c6), w, or, [tmp(c5), tmp(b6)]),
        let(tmp(r), w, or, [tmp(c6), tmp(b7)])
    ], ret(tmp(r)))
]).
func(cmpd, export, w, [param(l, tmp(a)), param(l, tmp(b))], [
    block(start, [], [
        let(tmp(x), d, cast, [tmp(a)]),
        let(tmp(y), d, cast, [tmp(b)]),
        let(tmp(a0), w, cmp(eq, d), [tmp(x), tmp(y)]),
        let(tmp(a1), w, cmp(ne, d), [tmp(x), tmp(y)]),
        let(tmp(a2), w, cmp(le, d), [tmp(x), tmp(y)]),
        let(tmp(a3), w, cmp(lt, d), [tmp(x), tmp(y)]),
        let(tmp(a4), w, cmp(ge, d), [tmp(x), tmp(y)]),
        let(tmp(a5), w, cmp(gt, d), [tmp(x), tmp(y)]),
        let(tmp(a6), w, cmp(o, d), [tmp(x), tmp(y)]),
        let(tmp(a7), w, cmp(uo, d), [tmp(x), tmp(y)]),
        let(tmp(b1), w, shl, [tmp(a1), const(1)]),
        let(tmp(b2), w, shl, [tmp(a2), const(2)]),
        let(tmp(b3), w, shl, [tmp(a3), const(3)]),
        let(tmp(b4), w, shl, [tmp(a4), const(4)]),
        let(tmp(b5), w, shl, [tmp(a5), const(5)]),
        let(tmp(b6), w, shl, [tmp(a6), const(6)]),
        let(tmp(b7), w, shl, [tmp(a7), const(7)]),
        let(tmp(c1), w, or, [tmp(a0), tmp(b1)]),
        let(tmp(c2), w, or, [tmp(c1), tmp(b2)]),
        let(tmp(c3), w, or, [tmp(c2), tmp(b3)]),
        let(tmp(c4), w, or, [tmp(c3), tmp(b4)]),
        let(tmp(c5), w, or, [tmp(c4), tmp(b5)]),
        let(tmp(c6), w, or, [tmp(c5), tmp(b6)]),
        let(tmp(r), w, or, [tmp(c6), tmp(b7)])
    ], ret(tmp(r)))
]).
func(identity, local, d, [param(d, tmp(a)), param(s, tmp(b))], [
    block(start, [], [
        let(tmp(x), s, copy, [tmp(b)]),
        let(tmp(y), d, copy, [tmp(a)])
    ], ret(tmp(y)))
]).
func(identity_s, local, s, [param(s, tmp(a))], [
    block(start, [], [
        let(tmp(x), s, copy, [tmp(a)])
    ], ret(tmp(x)))
]).
func(memory, export, l, [param(w, tmp(a)), param(l, tmp(b))], [
    block(start, [], [
        let(tmp(p), l, alloc(8), [const(16)]),
        let(tmp(q), l, add, [tmp(p), const(8)]),
        let(tmp(x), s, cast, [tmp(a)]),
        let(tmp(y), d, cast, [tmp(b)]),
        store(s, tmp(x), tmp(p)),
        store(d, tmp(y), tmp(q)),
        let(tmp(xx), s, load(s), [tmp(p)]),
        let(tmp(yy), d, load(d), [tmp(q)]),
        call(result(tmp(z), d), global(identity), [arg(d, tmp(yy)), arg(s, tmp(xx))]),
        call(result(tmp(zs), s), global(identity_s), [arg(s, tmp(xx))]),
        let(tmp(ws), w, cast, [tmp(zs)]),
        let(tmp(ls), l, ext(uw), [tmp(ws)]),
        let(tmp(ld), l, cast, [tmp(z)]),
        let(tmp(r), l, xor, [tmp(ld), tmp(ls)])
    ], ret(tmp(r)))
]).
data(values, local, 8, [item(s, const(2147483648)), item(d, const(18444492273895866370)), item(s, const(1))]).
func(literal, export, l, [], [
    block(start, [], [
        let(tmp(p), l, add, [global(values), const(4)]),
        let(tmp(d), d, load(d), [tmp(p)]),
        let(tmp(v), s, add, [const(1065353217), const(0)]),
        let(tmp(w), w, cast, [tmp(v)]),
        let(tmp(n), l, ext(uw), [tmp(w)]),
        let(tmp(l), l, cast, [tmp(d)]),
        let(tmp(r), l, xor, [tmp(l), tmp(n)])
    ], ret(tmp(r)))
]).
func(choose, export, l, [param(w, tmp(a))], [
    block(start, [], [], branch(tmp(a), left, right)),
    block(left, [], [], goto(join)),
    block(right, [], [], goto(join)),
    block(join, [
        phi(tmp(s), s, [left-const(2147483648), right-const(1)]),
        phi(tmp(d), d, [left-const(18444492273895866370), right-const(1)])
    ], [
        call(result(tmp(v), d), global(identity), [arg(d, tmp(d)), arg(s, tmp(s))]),
        call(result(tmp(vs), s), global(identity_s), [arg(s, tmp(s))]),
        let(tmp(w), w, cast, [tmp(vs)]),
        let(tmp(l), l, ext(uw), [tmp(w)]),
        let(tmp(bits), l, cast, [tmp(v)]),
        let(tmp(r), l, xor, [tmp(bits), tmp(l)])
    ], ret(tmp(r)))
]).
