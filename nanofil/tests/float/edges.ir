func(adds, export, w, [param(w, tmp(a)), param(w, tmp(b))], [
    block(start, [], [
        let(tmp(x), s, cast, [tmp(a)]),
        let(tmp(y), s, cast, [tmp(b)]),
        let(tmp(z), s, add, [tmp(x), tmp(y)]),
        let(tmp(r), w, cast, [tmp(z)])
    ], ret(tmp(r)))
]).
