% Pack all eight comparison results into a bitmask.
func(cmps, export, w, [par(w, t(a)), par(w, t(b))], [
    blk(start, [], [
        ins(t(x), s, cast, [t(a)]),
        ins(t(y), s, cast, [t(b)]),
        ins(t(a0), w, cmp(eq, s), [t(x), t(y)]),
        ins(t(a1), w, cmp(ne, s), [t(x), t(y)]),
        ins(t(a2), w, cmp(le, s), [t(x), t(y)]),
        ins(t(a3), w, cmp(lt, s), [t(x), t(y)]),
        ins(t(a4), w, cmp(ge, s), [t(x), t(y)]),
        ins(t(a5), w, cmp(gt, s), [t(x), t(y)]),
        ins(t(a6), w, cmp(o, s), [t(x), t(y)]),
        ins(t(a7), w, cmp(uo, s), [t(x), t(y)]),
        ins(t(b1), w, shl, [t(a1), c(1)]),
        ins(t(b2), w, shl, [t(a2), c(2)]),
        ins(t(b3), w, shl, [t(a3), c(3)]),
        ins(t(b4), w, shl, [t(a4), c(4)]),
        ins(t(b5), w, shl, [t(a5), c(5)]),
        ins(t(b6), w, shl, [t(a6), c(6)]),
        ins(t(b7), w, shl, [t(a7), c(7)]),
        ins(t(c1), w, or, [t(a0), t(b1)]),
        ins(t(c2), w, or, [t(c1), t(b2)]),
        ins(t(c3), w, or, [t(c2), t(b3)]),
        ins(t(c4), w, or, [t(c3), t(b4)]),
        ins(t(c5), w, or, [t(c4), t(b5)]),
        ins(t(c6), w, or, [t(c5), t(b6)]),
        ins(t(r), w, or, [t(c6), t(b7)])
    ], ret(t(r)))
]).
func(cmpd, export, w, [par(l, t(a)), par(l, t(b))], [
    blk(start, [], [
        ins(t(x), d, cast, [t(a)]),
        ins(t(y), d, cast, [t(b)]),
        ins(t(a0), w, cmp(eq, d), [t(x), t(y)]),
        ins(t(a1), w, cmp(ne, d), [t(x), t(y)]),
        ins(t(a2), w, cmp(le, d), [t(x), t(y)]),
        ins(t(a3), w, cmp(lt, d), [t(x), t(y)]),
        ins(t(a4), w, cmp(ge, d), [t(x), t(y)]),
        ins(t(a5), w, cmp(gt, d), [t(x), t(y)]),
        ins(t(a6), w, cmp(o, d), [t(x), t(y)]),
        ins(t(a7), w, cmp(uo, d), [t(x), t(y)]),
        ins(t(b1), w, shl, [t(a1), c(1)]),
        ins(t(b2), w, shl, [t(a2), c(2)]),
        ins(t(b3), w, shl, [t(a3), c(3)]),
        ins(t(b4), w, shl, [t(a4), c(4)]),
        ins(t(b5), w, shl, [t(a5), c(5)]),
        ins(t(b6), w, shl, [t(a6), c(6)]),
        ins(t(b7), w, shl, [t(a7), c(7)]),
        ins(t(c1), w, or, [t(a0), t(b1)]),
        ins(t(c2), w, or, [t(c1), t(b2)]),
        ins(t(c3), w, or, [t(c2), t(b3)]),
        ins(t(c4), w, or, [t(c3), t(b4)]),
        ins(t(c5), w, or, [t(c4), t(b5)]),
        ins(t(c6), w, or, [t(c5), t(b6)]),
        ins(t(r), w, or, [t(c6), t(b7)])
    ], ret(t(r)))
]).
func(identity, local, d, [par(d, t(a)), par(s, t(b))], [
    blk(start, [], [
        ins(t(x), s, copy, [t(b)]),
        ins(t(y), d, copy, [t(a)])
    ], ret(t(y)))
]).
func(identity_s, local, s, [par(s, t(a))], [
    blk(start, [], [
        ins(t(x), s, copy, [t(a)])
    ], ret(t(x)))
]).
func(memory, export, l, [par(w, t(a)), par(l, t(b))], [
    blk(start, [], [
        ins(t(p), l, alloc(8), [c(16)]),
        ins(t(q), l, add, [t(p), c(8)]),
        ins(t(x), s, cast, [t(a)]),
        ins(t(y), d, cast, [t(b)]),
        store(s, t(x), t(p)),
        store(d, t(y), t(q)),
        ins(t(xx), s, load(s), [t(p)]),
        ins(t(yy), d, load(d), [t(q)]),
        call(to(t(z), d), glo(identity), [arg(d, t(yy)), arg(s, t(xx))]),
        call(to(t(zs), s), glo(identity_s), [arg(s, t(xx))]),
        ins(t(ws), w, cast, [t(zs)]),
        ins(t(ls), l, ext(uw), [t(ws)]),
        ins(t(ld), l, cast, [t(z)]),
        ins(t(r), l, xor, [t(ld), t(ls)])
    ], ret(t(r)))
]).
data(values, local, 8, [item(s, c(2147483648)), item(d, c(18444492273895866370)), item(s, c(1))]).
func(literal, export, l, [], [
    blk(start, [], [
        ins(t(p), l, add, [glo(values), c(4)]),
        ins(t(d), d, load(d), [t(p)]),
        ins(t(v), s, add, [c(1065353217), c(0)]),
        ins(t(w), w, cast, [t(v)]),
        ins(t(n), l, ext(uw), [t(w)]),
        ins(t(l), l, cast, [t(d)]),
        ins(t(r), l, xor, [t(l), t(n)])
    ], ret(t(r)))
]).
func(choose, export, l, [par(w, t(a))], [
    blk(start, [], [], jnz(t(a), left, right)),
    blk(left, [], [], jmp(join)),
    blk(right, [], [], jmp(join)),
    blk(join, [
        phi(t(s), s, [left-c(2147483648), right-c(1)]),
        phi(t(d), d, [left-c(18444492273895866370), right-c(1)])
    ], [
        call(to(t(v), d), glo(identity), [arg(d, t(d)), arg(s, t(s))]),
        call(to(t(vs), s), glo(identity_s), [arg(s, t(s))]),
        ins(t(w), w, cast, [t(vs)]),
        ins(t(l), l, ext(uw), [t(w)]),
        ins(t(bits), l, cast, [t(v)]),
        ins(t(r), l, xor, [t(bits), t(l)])
    ], ret(t(r)))
]).
