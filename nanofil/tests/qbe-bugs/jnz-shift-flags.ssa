# qbe 1.2 and upstream c081897 miscompile this. jnz reuses the flags of
# the shift that defines %x, but an x86 shift by zero leaves the flags
# unchanged, so the branch sees the flags of the preceding `and` (zero).
#
#   -128 >> 0 is nonzero, so $f(0) is 1; qbe's code returns 0.
#
# run: $f 0
# run: $f 1
export function w $f(l %n) {
@start
	%c =w and %n, 63
	%x =l shr -128, %c
	jnz %x, @yes, @no
@yes
	ret 1
@no
	ret 0
}
