# qbe 1.2 and upstream c081897 miscompile this. storew of an l temp must
# store only its low 32 bits (QBE IL, "Subtyping"), but load forwarding
# builds the halfword at offset 5 from %b shifted right by 24 without
# masking, so bits of %b beyond the stored word leak into the result.
#
#   memory: 11 22 88 99 aa bb 77 88    loaduh at 5 -> 0x77bb = 30651
#   qbe:    0xffbb = 65467
#
# run: $f 9833440827789222417 18441921395520346504
export function w $f(l %a, l %b) {
@start
	%p =l alloc8 16
	storel %a, %p
	%q =l add %p, 2
	storew %b, %q
	%r =l add %p, 5
	%v =w loaduh %r
	ret %v
}
