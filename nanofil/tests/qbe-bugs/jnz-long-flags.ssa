# qbe 1.2 and upstream c081897 disagree with the QBE IL document, which
# says jnz compares only the 32 least significant bits of an l argument
# to zero. qbe does that for an l parameter (see $jnzl in
# fixtures/arith.ssa), but when jnz reuses the flags of a 64-bit add it
# tests all 64 bits.
#
#   2^32 + 0 has zero low bits, so $f(2^32, 0) is 0; qbe's code returns 1.
#
# run: $f 4294967296 0
export function w $f(l %a, l %b) {
@start
	%x =l add %a, %b
	jnz %x, @yes, @no
@yes
	ret 1
@no
	ret 0
}
