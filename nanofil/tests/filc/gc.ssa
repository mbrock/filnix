# GC stress, driven by gc.c: while these functions run, c_gc forces and
# requests collections and churns the heap. Every node is reachable only
# through nanofil's frame and through pointers nanofil stored, so a missed
# root or store barrier frees a live node.

# A list of %n nodes {next p at 0, value l at 8}, newest first.
export function p $build(l %n) {
@start
	jmp @loop
@loop
	%i =l phi @start 0, @body %i1
	%head =p phi @start 0, @body %node_back
	%c =w csltl %i, %n
	jnz %c, @body, @done
@body
	%head_copy =p copy %head
	%head_link =p copy %head_copy
	%node =p alloc8 16
	%node_copy =p copy %node
	%node_live =p copy %node_copy
	storep %head_link, %node_live
	%v =p add %node_live, 8
	storel %i, %v
	call $c_gc(l %i)
	%node_back =p copy %node_live
	%i1 =l add %i, 1
	jmp @loop
@done
	%result =p copy %head
	ret %result
}

# Two distinct anchors swap on every backedge and live across collections.
# Their values sum to 46: include that check in the result without changing
# gc.c's list-sum contract. Losing one capability or sequentially updating
# the swap phis must not silently leave the expected answer unchanged.
export function l $sum(p %list) {
@start
	%list_copy =p copy %list
	%list_start =p copy %list_copy
	%left_seed =p alloc8 8
	storel 17, %left_seed
	%right_seed =p alloc8 8
	storel 29, %right_seed
	jmp @loop
@loop
	%p =p phi @start %list_start, @finish %next_back
	%left =p phi @start %left_seed, @finish %left_back
	%right =p phi @start %right_seed, @finish %right_back
	%s =l phi @start 0, @finish %s1
	%a =l ptoi %p
	%z =w ceql %a, 0
	jnz %z, @done, @body
@body
	%current_copy =p copy %p
	%current =p copy %current_copy
	%vp =p add %current, 8
	%v =l loadl %vp
	%next =p loadp %current
	%next_live =p copy %next
	%anchor_seed =p alloc8 8
	storel 37, %anchor_seed
	jmp @inner
@inner
	# Invariants of this inner loop, including a fresh object rooted only
	# here and aliases of the outer swap phis. All three should disappear.
	%anchor =p phi @body %anchor_seed, @spin %anchor
	%left_hold =p phi @body %left, @spin %left_hold
	%right_hold =p phi @body %right, @spin %right_hold
	%j =w phi @body 0, @spin %j1
	%again =w csltw %j, 1
	jnz %again, @spin, @finish
@spin
	call $c_gc(l %v)
	%j1 =w add %j, 1
	jmp @inner
@finish
	%av =l loadl %anchor
	%ad =l sub %av, 37
	%checked =l add %v, %ad
	%s1 =l add %s, %checked
	%left_copy =p copy %right_hold
	%right_copy =p copy %left_hold
	%next_back =p copy %next_live
	%left_back =p copy %left_copy
	%right_back =p copy %right_copy
	jmp @loop
@done
	%left_result =p copy %left
	%right_result =p copy %right
	%lv =l loadl %left_result
	%rv =l loadl %right_result
	%both =l add %lv, %rv
	%delta =l sub %both, 46
	%result =l add %s, %delta
	ret %result
}
