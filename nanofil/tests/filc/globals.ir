data(tab, local, 8, [item(w, const(10)), item(w, const(20)), item(w, const(30))]).
data(msg, ro(local), 8, [item(b, str("hi\n")), item(b, const(0))]).
data(pt, local, 8, [item(p, sym(tab, 4)), item(p, sym(msg, 0)), item(l, const(7))]).
func(three, local, w, [param(w, tmp(x))], [
    block(s, [], [
        let(tmp(r), w, mul, [tmp(x), const(3)])
    ], ret(tmp(r)))
]).
func(get, export, w, [param(w, tmp(i))], [
    block(s, [], [
        let(tmp(t), p, copy, [global(tab)]),
        let(tmp(o), l, ext(sw), [tmp(i)]),
        let(tmp(o4), l, mul, [tmp(o), const(4)]),
        let(tmp(q), p, add, [tmp(t), tmp(o4)]),
        let(tmp(v), w, load(sw), [tmp(q)])
    ], ret(tmp(v)))
]).
func(viapt, export, w, [], [
    block(s, [], [
        let(tmp(t), p, copy, [global(pt)]),
        let(tmp(a), p, load(p), [tmp(t)]),
        let(tmp(v), w, load(sw), [tmp(a)]),
        let(tmp(m), p, add, [tmp(t), const(8)]),
        let(tmp(s), p, load(p), [tmp(m)]),
        let(tmp(c), w, load(ub), [tmp(s)]),
        let(tmp(r), w, add, [tmp(v), tmp(c)])
    ], ret(tmp(r)))
]).
func(poke, export, w, [], [
    block(s, [], [
        let(tmp(t), p, copy, [global(msg)]),
        store(b, const(65), tmp(t))
    ], ret(const(0)))
]).
func(ind, export, w, [param(w, tmp(x))], [
    block(s, [], [
        let(tmp(f), p, copy, [global(three)]),
        call(result(tmp(r), w), tmp(f), [arg(w, tmp(x))])
    ], ret(tmp(r)))
]).
func(indl, export, l, [param(l, tmp(x))], [
    block(s, [], [
        let(tmp(f), p, copy, [global(three)]),
        call(result(tmp(r), l), tmp(f), [arg(l, tmp(x)), arg(w, const(5))])
    ], ret(tmp(r)))
]).
func(notfn, export, w, [], [
    block(s, [], [
        let(tmp(f), p, copy, [global(tab)]),
        call(result(tmp(r), w), tmp(f), [arg(w, const(1))])
    ], ret(tmp(r)))
]).
func(offfn, export, w, [], [
    block(s, [], [
        let(tmp(f), p, copy, [global(three)]),
        let(tmp(g), p, add, [tmp(f), const(0)]),
        let(tmp(h), p, add, [tmp(g), const(1)]),
        call(result(tmp(r), w), tmp(h), [arg(w, const(1))])
    ], ret(tmp(r)))
]).
func(readfn, export, w, [], [
    block(s, [], [
        let(tmp(f), p, copy, [global(three)]),
        let(tmp(v), w, load(ub), [tmp(f)])
    ], ret(tmp(v)))
]).
func(toofew, export, w, [], [
    block(s, [], [
        let(tmp(f), p, copy, [global(three)]),
        call(result(tmp(r), w), tmp(f), [])
    ], ret(tmp(r)))
]).
run(get, [1]).
run(get, [2]).
run(get, [3]).
run(viapt, []).
run(poke, []).
run(ind, [7]).
run(indl, [7]).
run(notfn, []).
run(offfn, []).
run(readfn, []).
run(toofew, []).
