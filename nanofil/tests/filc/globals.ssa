data $tab = { w 10, w 20, w 30 }
section ".rodata" data $msg = { b "hi\n", b 0 }
data $pt = { p $tab + 4, p $msg, l 7 }
function w $three(w %x) {
@s
	%r =w mul %x, 3
	ret %r
}
export function w $get(w %i) {
@s
	%t =p copy $tab
	%o =l extsw %i
	%o4 =l mul %o, 4
	%q =p add %t, %o4
	%v =w loadsw %q
	ret %v
}
export function w $viapt() {
@s
	%t =p copy $pt
	%a =p loadp %t
	%v =w loadsw %a
	%m =p add %t, 8
	%s =p loadp %m
	%c =w loadub %s
	%r =w add %v, %c
	ret %r
}
export function w $poke() {
@s
	%t =p copy $msg
	storeb 65, %t
	ret 0
}
export function w $ind(w %x) {
@s
	%f =p copy $three
	%r =w call %f(w %x)
	ret %r
}
export function l $indl(l %x) {
@s
	%f =p copy $three
	%r =l call %f(l %x, w 5)
	ret %r
}
export function w $notfn() {
@s
	%f =p copy $tab
	%r =w call %f(w 1)
	ret %r
}
export function w $offfn() {
@s
	%f =p copy $three
	%g =p add %f, 0
	%h =p add %g, 1
	%r =w call %h(w 1)
	ret %r
}
export function w $readfn() {
@s
	%f =p copy $three
	%v =w loadub %f
	ret %v
}
export function w $toofew() {
@s
	%f =p copy $three
	%r =w call %f()
	ret %r
}
