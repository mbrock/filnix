% GC stress, driven by gc.c: while these functions run, c_gc forces and
% requests collections and churns the heap. Every node is reachable only
% through nanofil's frame and through pointers nanofil stored, so a missed
% root or store barrier frees a live node.

% A list of %n nodes {next p at 0, value l at 8}, newest first.
func(build, export, p, [param(l, tmp(n))], [
    block(start, [], [], goto(loop)),
    block(loop, [
        phi(tmp(i), l, [start-const(0), body-tmp(i1)]),
        phi(tmp(head), p, [start-const(0), body-tmp(node_back)])
    ], [
        let(tmp(c), w, cmp(slt, l), [tmp(i), tmp(n)])
    ], branch(tmp(c), body, done)),
    block(body, [], [
        let(tmp(head_copy), p, copy, [tmp(head)]),
        let(tmp(head_link), p, copy, [tmp(head_copy)]),
        let(tmp(node), p, alloc(8), [const(16)]),
        let(tmp(node_copy), p, copy, [tmp(node)]),
        let(tmp(node_live), p, copy, [tmp(node_copy)]),
        store(p, tmp(head_link), tmp(node_live)),
        let(tmp(v), p, add, [tmp(node_live), const(8)]),
        store(l, tmp(i), tmp(v)),
        call(void, global(c_gc), [arg(l, tmp(i))]),
        let(tmp(node_back), p, copy, [tmp(node_live)]),
        let(tmp(i1), l, add, [tmp(i), const(1)])
    ], goto(loop)),
    block(done, [], [
        let(tmp(result), p, copy, [tmp(head)])
    ], ret(tmp(result)))
]).

% Two distinct anchors swap on every backedge and live across collections.
% Their values sum to 46: include that check in the result without changing
% gc.c's list-sum contract. Losing one capability or sequentially updating
% the swap phis must not silently leave the expected answer unchanged.
func(sum, export, l, [param(p, tmp(list))], [
    block(start, [], [
        let(tmp(list_copy), p, copy, [tmp(list)]),
        let(tmp(list_start), p, copy, [tmp(list_copy)]),
        let(tmp(left_seed), p, alloc(8), [const(8)]),
        store(l, const(17), tmp(left_seed)),
        let(tmp(right_seed), p, alloc(8), [const(8)]),
        store(l, const(29), tmp(right_seed))
    ], goto(loop)),
    block(loop, [
        phi(tmp(p), p, [start-tmp(list_start), finish-tmp(next_back)]),
        phi(tmp(left), p, [start-tmp(left_seed), finish-tmp(left_back)]),
        phi(tmp(right), p, [start-tmp(right_seed), finish-tmp(right_back)]),
        phi(tmp(s), l, [start-const(0), finish-tmp(s1)])
    ], [
        let(tmp(a), l, ptoi, [tmp(p)]),
        let(tmp(z), w, cmp(eq, l), [tmp(a), const(0)])
    ], branch(tmp(z), done, body)),
    block(body, [], [
        let(tmp(current_copy), p, copy, [tmp(p)]),
        let(tmp(current), p, copy, [tmp(current_copy)]),
        let(tmp(vp), p, add, [tmp(current), const(8)]),
        let(tmp(v), l, load(l), [tmp(vp)]),
        let(tmp(next), p, load(p), [tmp(current)]),
        let(tmp(next_live), p, copy, [tmp(next)]),
        let(tmp(anchor_seed), p, alloc(8), [const(8)]),
        store(l, const(37), tmp(anchor_seed))
    ], goto(inner)),
    block(inner, [
        % Invariants of this inner loop, including a fresh object rooted only
        % here and aliases of the outer swap phis. All three should disappear.
        phi(tmp(anchor), p, [body-tmp(anchor_seed), spin-tmp(anchor)]),
        phi(tmp(left_hold), p, [body-tmp(left), spin-tmp(left_hold)]),
        phi(tmp(right_hold), p, [body-tmp(right), spin-tmp(right_hold)]),
        phi(tmp(j), w, [body-const(0), spin-tmp(j1)])
    ], [
        let(tmp(again), w, cmp(slt, w), [tmp(j), const(1)])
    ], branch(tmp(again), spin, finish)),
    block(spin, [], [
        call(void, global(c_gc), [arg(l, tmp(v))]),
        let(tmp(j1), w, add, [tmp(j), const(1)])
    ], goto(inner)),
    block(finish, [], [
        let(tmp(av), l, load(l), [tmp(anchor)]),
        let(tmp(ad), l, sub, [tmp(av), const(37)]),
        let(tmp(checked), l, add, [tmp(v), tmp(ad)]),
        let(tmp(s1), l, add, [tmp(s), tmp(checked)]),
        let(tmp(left_copy), p, copy, [tmp(right_hold)]),
        let(tmp(right_copy), p, copy, [tmp(left_hold)]),
        let(tmp(next_back), p, copy, [tmp(next_live)]),
        let(tmp(left_back), p, copy, [tmp(left_copy)]),
        let(tmp(right_back), p, copy, [tmp(right_copy)])
    ], goto(loop)),
    block(done, [], [
        let(tmp(left_result), p, copy, [tmp(left)]),
        let(tmp(right_result), p, copy, [tmp(right)]),
        let(tmp(lv), l, load(l), [tmp(left_result)]),
        let(tmp(rv), l, load(l), [tmp(right_result)]),
        let(tmp(both), l, add, [tmp(lv), tmp(rv)]),
        let(tmp(delta), l, sub, [tmp(both), const(46)]),
        let(tmp(result), l, add, [tmp(s), tmp(delta)])
    ], ret(tmp(result)))
]).
