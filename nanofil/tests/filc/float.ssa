data $floatdata = align 8 { s s_1.25, z 4, d d_2.5 }

export function s $nfloat(p %p, s %x) {
@start
    call $churn()
    stores %x, %p
    %a =s loads %p
    %r =s add %a, s_1.5
    ret %r
}
export function d $ndouble(p %p, d %x) {
@start
    call $churn()
    stored %x, %p
    %a =d loadd %p
    %r =d mul %a, d_2.5
    ret %r
}
export function d $ncall(p %p) {
@start
    %a =s call $cfloat(p %p, s s_2.5)
    %b =d exts %a
    %c =d call $cdouble(d %b, p %p)
    ret %c
}
export function d $nwide(l %i, p %p, d %a, d %b, d %c, d %d, d %e, d %f, d %g, d %h, d %j, l %k, l %l, l %m, l %n) {
@start
    call $churn()
    %x =d add %a, %j
    %y =d sltof %n
    %v =w loadsw %p
    %z =d swtof %v
    %r0 =d add %x, %y
    %r =d add %r0, %z
    ret %r
}
export function d $ncallwide(p %p) {
@start
    %r =d call $cwide(l 1, p %p, d d_2.0, d d_3.0, d d_4.0, d d_5.0, d d_6.0, d d_7.0, d d_8.0, d d_9.0, d d_10.0, l 11, l 12, l 13, l 14)
    ret %r
}
export function d $nindirect(p %p) {
@start
    %fp =p copy $nwide
    %r =d call %fp(l 1, p %p, d d_2.0, d d_3.0, d d_4.0, d d_5.0, d d_6.0, d d_7.0, d d_8.0, d d_9.0, d d_10.0, l 11, l 12, l 13, l 14)
    ret %r
}
export function d $nvar(d %fixed, w %n) {
@start
    call $churn()
    %args =p va_args 16
    %ap =p alloc8 24
    storep %args, %ap
    %a =d va_arg %ap
    %b =d va_arg %ap
    %p =p va_arg %ap
    call $churn()
    %v =w loadsw %p
    %f =d swtof %v
    %ab =d add %a, %b
    %ff =d add %fixed, %f
    %r =d add %ab, %ff
    ret %r
}
export function d $ncallvar(p %p) {
@start
    %r =d call $cvar(w 3, d d_1.25, d d_2.5, p %p)
    ret %r
}
export function d $nconsume(p %ap) {
@start
    %r =d va_arg %ap
    ret %r
}
export function d $nforward(w %n) {
@start
    %args =p va_args 8
    %ap =p alloc8 24
    storep %args, %ap
    %r =d call $cconsume(p %ap)
    ret %r
}
export function w $nfloatbits(p %fp) {
@start
    %a =s call %fp(s s_1.5)
    %r =w cast %a
    ret %r
}
export function w $nshort(w %n) {
@start
    %args =p va_args 8
    %ap =p alloc8 24
    storep %args, %ap
    %a =d va_arg %ap
    %b =d va_arg %ap
    %r =w dtosi %b
    ret %r
}
export function s $nidentity(s %x) {
@start
    ret %x
}
export function w $nforge(p %fp) {
@start
    %p =p call %fp(s s_1.5)
    %r =w loadsw %p
    ret %r
}
export function d $nphi(p %unused, w %which) {
@start
    jnz %which, @a, @b
@a
    jmp @end
@b
    jmp @end
@end
    %x =d phi @a d_1.25, @b d_2.5
    ret %x
}
export function {l, p} $nbuffer(d %x, p %p, l %n, p %q, d %y) {
@start
    call $churn()
    %z =d add %x, %y
    %i =l dtosi %z
    %r =l add %i, %n
    ret {%r, %q}
}
export function l $ncallbuffer(p %p) {
@start
    {%n, %q} ={l, p} call $cbuffer(d d_1.25, p %p, l 10, p %p, d d_2.5)
    call $churn()
    %v =w loadsw %q
    %l =l extsw %v
    %r =l add %n, %l
    ret %r
}
export function d $ndata() {
@start
    %p =p copy $floatdata
    %a =s loads %p
    %q =p add %p, 8
    %b =d loadd %q
    %c =d exts %a
    %r =d add %b, %c
    ret %r
}
