func(nsum, export, l, [param(w, tmp(n))], [
    block(start, [], [
        call(void, global(churn), []),
        let(tmp(args), p, va_args, [const(8)]),
        let(tmp(ap), p, alloc(8), [const(24)]),
        store(p, tmp(args), tmp(ap)),
        let(tmp(i), w, va_arg, [tmp(ap)]),
        let(tmp(l), l, va_arg, [tmp(ap)]),
        let(tmp(p), p, va_arg, [tmp(ap)]),
        call(void, global(churn), []),
        let(tmp(v), w, load(sw), [tmp(p)]),
        let(tmp(il), l, ext(sw), [tmp(i)]),
        let(tmp(vl), l, ext(sw), [tmp(v)]),
        let(tmp(a), l, add, [tmp(il), tmp(l)]),
        let(tmp(b), l, add, [tmp(a), tmp(vl)])
    ], ret(tmp(b)))
]).

func(ncall, export, l, [param(p, tmp(p))], [
    block(start, [], [
        call(result(tmp(a), l), global(csum), [arg(w, const(3)), arg(w, const(11)), arg(l, const(10000000000)), arg(p, tmp(p))])
    ], ret(tmp(a)))
]).

func(nconsume, export, l, [param(p, tmp(ap))], [
    block(start, [], [
        let(tmp(a), l, va_arg, [tmp(ap)])
    ], ret(tmp(a)))
]).

func(nforward, export, l, [param(w, tmp(n))], [
    block(start, [], [
        let(tmp(args), p, va_args, [const(8)]),
        let(tmp(ap), p, alloc(8), [const(24)]),
        store(p, tmp(args), tmp(ap)),
        call(result(tmp(v), l), global(cconsume), [arg(p, tmp(ap))])
    ], ret(tmp(v)))
]).

func(nptr, export, p, [param(w, tmp(n))], [
    block(start, [], [
        let(tmp(args), p, va_args, [const(8)]),
        let(tmp(ap), p, alloc(8), [const(24)]),
        store(p, tmp(args), tmp(ap)),
        let(tmp(p), p, va_arg, [tmp(ap)])
    ], ret(tmp(p)))
]).

func(ntrap, export, l, [param(w, tmp(n))], [
    block(start, [], [
        let(tmp(args), p, va_args, [const(8)]),
        let(tmp(ap), p, alloc(8), [const(24)]),
        store(p, tmp(args), tmp(ap)),
        let(tmp(a), l, va_arg, [tmp(ap)]),
        let(tmp(b), l, va_arg, [tmp(ap)])
    ], ret(tmp(b)))
]).
