# Called from interop.c (clang-built Fil-C); see run-c.sh.

export function l $sumbytes(p %buf, l %n) {
@start
	jmp @loop
@loop
	%i =l phi @start 0, @body %i1
	%s =l phi @start 0, @body %s1
	%c =w csltl %i, %n
	jnz %c, @body, @done
@body
	%q =p add %buf, %i
	%b =l loadub %q
	%s1 =l add %s, %b
	%i1 =l add %i, 1
	jmp @loop
@done
	ret %s
}

export function $setslot(p %slot, p %v) {
@start
	storep %v, %slot
	ret
}

export function p $offset(p %p, l %off) {
@start
	%q =p add %p, %off
	ret %q
}

export function $poke(p %p, w %v) {
@start
	storeb %v, %p
	ret
}

# Ten words of arguments: the last pointers go on the stack, and the
# fourth pointer is split between %r9 and the stack.
export function l $five(p %a, p %b, p %c, p %d, p %e) {
@start
	%va =l loadub %a
	%vb =l loadub %b
	%vc =l loadub %c
	%vd =l loadub %d
	%ve =l loadub %e
	%x1 =l mul %vb, 10
	%x2 =l mul %vc, 100
	%x3 =l mul %vd, 1000
	%x4 =l mul %ve, 10000
	%s1 =l add %va, %x1
	%s2 =l add %s1, %x2
	%s3 =l add %s2, %x3
	%s4 =l add %s3, %x4
	ret %s4
}

# Calls into C, and back into nanofil through C.
export function l $callc(p %s) {
@start
	%n =l call $c_len(p %s)
	%m =p call $c_mid(p %s)
	%v =l loadub %m
	%k =l call $c_five(p %s)
	%a =l mul %n, 1000
	%b =l add %a, %v
	%r =l add %b, %k
	ret %r
}
