% Check reuse (docs/m7.md): difftest runs each run line on the unchecked
% module, the pizlonated one and, with NANOFIL_CHECKS=reuse, the module
% whose covered checks were deleted; all must agree, traps included.
% Each function holds a mistake a wrong reuse would make; the comments
% say which checks must stay. reuse-gc.ir is the native GC fixture.

% A write proof covers the 8-byte read and the 4-byte read after it. A
% call (here free) ends the evidence: the load after it keeps its check
% and traps. Treating calls as transparent would read the freed object.
run(stale, [0]).
run(stale, [1]).
func(stale, export, l, [param(w, tmp(yes))], [
    block(start, [], [
        let(tmp(p), p, alloc(8), [const(8)]),
        store(l, const(5), tmp(p)),
        let(tmp(x), l, load(l), [tmp(p)]),
        let(tmp(y), w, load(sw), [tmp(p)])
    ], branch(tmp(yes), freed, kept)),
    block(freed, [], [
        let(tmp(w), l, load(l), [tmp(p)]),
        call(void, global(free), [arg(p, tmp(p))]),
        let(tmp(z), l, load(l), [tmp(p)]),
        let(tmp(r), l, add, [tmp(z), tmp(w)])
    ], ret(tmp(r))),
    block(kept, [], [
        let(tmp(y1), l, ext(sw), [tmp(y)]),
        let(tmp(z), l, add, [tmp(x), tmp(y1)])
    ], ret(tmp(z)))
]).

% A 4-byte proof does not cover an 8-byte read of a 4-byte object.
run(narrow, [0]).
func(narrow, export, l, [param(w, tmp(v))], [
    block(start, [], [
        let(tmp(p), p, alloc(4), [const(4)]),
        store(w, tmp(v), tmp(p)),
        let(tmp(x), w, load(sw), [tmp(p)]),
        let(tmp(y), l, load(l), [tmp(p)])
    ], ret(tmp(y)))
]).

% A read proof does not cover a write: the store traps readonly.
data(msg, ro(local), 1, [item(b, str("hi"))]).
run(readonly, []).
func(readonly, export, w, [], [
    block(start, [], [
        let(tmp(p), p, copy, [global(msg)]),
        let(tmp(x), w, load(ub), [tmp(p)]),
        let(tmp(y), w, load(ub), [tmp(p)]),
        let(tmp(z), w, add, [tmp(x), tmp(y)]),
        store(b, tmp(z), tmp(p))
    ], ret(tmp(z)))
]).

% Two objects at different addresses: evidence about a is not about b.
% 10 * 1 + 2 = 12; reading a for b would give 11.
run(objects, []).
func(objects, export, l, [], [
    block(start, [], [
        let(tmp(a), p, alloc(8), [const(8)]),
        let(tmp(b), p, alloc(8), [const(8)]),
        store(l, const(1), tmp(a)),
        store(l, const(2), tmp(b)),
        let(tmp(x), l, load(l), [tmp(a)]),
        let(tmp(y), l, load(l), [tmp(b)]),
        let(tmp(t), l, mul, [tmp(x), const(10)]),
        let(tmp(r), l, add, [tmp(t), tmp(y)])
    ], ret(tmp(r)))
]).

% Evidence ends at the block: a proof from start does not cover join,
% even though start dominates it, nor the arm that frees p.
run(branches, [0]).
run(branches, [1]).
func(branches, export, l, [param(w, tmp(yes))], [
    block(start, [], [
        let(tmp(p), p, alloc(8), [const(8)]),
        store(l, const(3), tmp(p))
    ], branch(tmp(yes), release, join)),
    block(release, [], [
        call(void, global(free), [arg(p, tmp(p))])
    ], goto(join)),
    block(join, [], [
        let(tmp(x), l, load(l), [tmp(p)])
    ], ret(tmp(x)))
]).

% Across edges: both arms keep start's write proof, so the join's read
% may reuse it.
run(diamond, [0]).
run(diamond, [1]).
func(diamond, export, l, [param(w, tmp(c))], [
    block(start, [], [
        let(tmp(p), p, alloc(8), [const(8)]),
        store(l, const(4), tmp(p))
    ], branch(tmp(c), left, right)),
    block(left, [], [let(tmp(k), l, add, [const(1), const(2)])], goto(join)),
    block(right, [], [], goto(join)),
    block(join, [], [
        let(tmp(x), l, load(l), [tmp(p)])
    ], ret(tmp(x)))
]).

% Loop-carried staleness: the first iteration frees p after reading it,
% so the second read traps. Evidence from start must not survive the
% back edge.
run(loop_free, []).
func(loop_free, export, l, [], [
    block(start, [], [
        let(tmp(p), p, alloc(8), [const(8)]),
        store(l, const(7), tmp(p))
    ], goto(head)),
    block(head, [], [
        let(tmp(x), l, load(l), [tmp(p)])
    ], goto(body)),
    block(body, [], [
        call(void, global(free), [arg(p, tmp(p))])
    ], goto(head))
]).

% Round 3 (related pointers): each field is reached by a fresh flight
% from p, as -O emits, so only a proof of an earlier flight to the same
% field covers the reload. Fields hold 1, 2 and 3, so a wrong distance
% changes the result: 100 * 3 + 10 * 2 + 1 = 321.
run(fields, []).
func(fields, export, l, [], [
    block(start, [], [
        let(tmp(p), p, alloc(16), [const(16)]),
        store(w, const(1), tmp(p)),
        let(tmp(a4), p, add, [tmp(p), const(4)]),
        store(w, const(2), tmp(a4)),
        let(tmp(a8), p, add, [tmp(p), const(8)]),
        store(l, const(3), tmp(a8)),
        let(tmp(b8), p, add, [tmp(p), const(8)]),
        let(tmp(x8), l, load(l), [tmp(b8)]),
        let(tmp(b4), p, add, [tmp(p), const(4)]),
        let(tmp(x4), w, load(sw), [tmp(b4)]),
        let(tmp(x0), w, load(sw), [tmp(p)]),
        let(tmp(y4), l, ext(sw), [tmp(x4)]),
        let(tmp(y0), l, ext(sw), [tmp(x0)]),
        let(tmp(h), l, mul, [tmp(x8), const(100)]),
        let(tmp(t), l, mul, [tmp(y4), const(10)]),
        let(tmp(s), l, add, [tmp(h), tmp(t)]),
        let(tmp(r), l, add, [tmp(s), tmp(y0)])
    ], ret(tmp(r)))
]).

% A free between the field's store and its reload through another
% flight: the reload keeps its check and traps. A field past the end
% of the object (offset 8 of 8 bytes) keeps its own check and traps at
% its access, after an in-bounds field of the same object; it is never
% covered by the first field's proof.
run(fields_free, [0]).
run(fields_free, [1]).
run(fields_free, [2]).
func(fields_free, export, l, [param(w, tmp(k))], [
    block(start, [], [
        let(tmp(p), p, alloc(8), [const(8)]),
        let(tmp(a), p, add, [tmp(p), const(0)]),
        store(l, const(4), tmp(a)),
        let(tmp(c), w, cmp(eq, w), [tmp(k), const(1)])
    ], branch(tmp(c), freed, other)),
    block(freed, [], [
        call(void, global(free), [arg(p, tmp(p))]),
        let(tmp(b), p, add, [tmp(p), const(0)]),
        let(tmp(x), l, load(l), [tmp(b)])
    ], ret(tmp(x))),
    block(other, [], [
        let(tmp(d), w, cmp(eq, w), [tmp(k), const(2)])
    ], branch(tmp(d), past, across)),
    block(past, [], [
        let(tmp(e), p, add, [tmp(p), const(8)]),
        let(tmp(y), l, load(l), [tmp(e)])
    ], ret(tmp(y))),
    % Rounds 2 and 3 together: a plain edge from start, where a proves
    % the field, to a reload through a different flight.
    block(across, [], [
        let(tmp(f), p, add, [tmp(p), const(0)]),
        let(tmp(z), l, load(l), [tmp(f)])
    ], ret(tmp(z)))
]).
