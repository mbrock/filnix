% Fil-C mode: pointers carry capabilities. Each run's outcome is a
% return value or a trap, and a native run must match (a trap is a Fil-C
% safety panic).

% In-bounds reads and writes at every width.
run(widths, [0]).
run(widths, [1]).
func(widths, export, l, [param(w, tmp(k))], [
    block(start, [], [
        let(tmp(p), p, alloc(8), [const(16)]),
        store(l, const(-2), tmp(p)),
        let(tmp(q), p, add, [tmp(p), const(8)]),
        store(w, const(305419896), tmp(q)),
        let(tmp(r), p, add, [tmp(p), const(15)]),
        store(b, const(255), tmp(r)),
        let(tmp(a), l, load(sb), [tmp(p)]),
        let(tmp(b), l, load(l), [tmp(q)])
    ], branch(tmp(k), one, zero)),
    block(zero, [], [], ret(tmp(a))),
    block(one, [], [], ret(tmp(b)))
]).

% Reads one past the end, and just below the start.
run(oob, [16]).
run(oob, [15]).
run(oob, [-1]).
run(oob, [0]).
func(oob, export, w, [param(l, tmp(i))], [
    block(start, [], [
        let(tmp(p), p, alloc(8), [const(16)]),
        let(tmp(q), p, add, [tmp(p), tmp(i)]),
        let(tmp(v), w, load(ub), [tmp(q)])
    ], ret(tmp(v)))
]).

% An 8-byte read that starts inside but ends outside.
run(straddle, [8]).
run(straddle, [9]).
func(straddle, export, l, [param(l, tmp(i))], [
    block(start, [], [
        let(tmp(p), p, alloc(8), [const(16)]),
        let(tmp(q), p, add, [tmp(p), tmp(i)]),
        let(tmp(v), l, load(l), [tmp(q)])
    ], ret(tmp(v)))
]).

% Allocations are zeroed.
run(zeroed, [24]).
func(zeroed, export, l, [param(l, tmp(n))], [
    block(start, [], [
        let(tmp(p), p, alloc(16), [tmp(n)]),
        let(tmp(q), p, add, [tmp(p), const(16)]),
        let(tmp(v), l, load(l), [tmp(q)])
    ], ret(tmp(v)))
]).

% An integer turned into a pointer has no capability, even when it is the
% address of a live object.
run(forged, [0]).
run(forged, [1]).
func(forged, export, w, [param(w, tmp(k))], [
    block(start, [], [
        let(tmp(p), p, alloc(8), [const(8)]),
        store(w, const(7), tmp(p)),
        let(tmp(i), l, ptoi, [tmp(p)]),
        let(tmp(f), p, itop, [tmp(i)])
    ], branch(tmp(k), forge, real)),
    block(real, [], [
        let(tmp(v), w, load(sw), [tmp(p)])
    ], ret(tmp(v))),
    block(forge, [], [
        let(tmp(u), w, load(sw), [tmp(f)])
    ], ret(tmp(u)))
]).

% A pointer constant has no capability.
run(nullread, [0]).
func(nullread, export, w, [param(w, tmp(k))], [
    block(start, [], [
        let(tmp(v), w, load(sw), [const(0)])
    ], ret(tmp(v)))
]).

% Pointers round-trip through memory with their capabilities; an integer
% store over a pointer slot keeps the capability and moves the address.
run(roundtrip, [0]).
run(roundtrip, [1]).
run(roundtrip, [2]).
func(roundtrip, export, l, [param(w, tmp(k))], [
    block(start, [], [
        let(tmp(obj), p, alloc(8), [const(32)]),
        let(tmp(f), p, add, [tmp(obj), const(24)]),
        store(l, const(99), tmp(f)),
        let(tmp(box), p, alloc(8), [const(8)]),
        store(p, tmp(obj), tmp(box)),
        let(tmp(back), p, load(p), [tmp(box)])
    ], branch(tmp(k), n1, plain)),
    block(plain, [], [
        let(tmp(b2), p, add, [tmp(back), const(24)]),
        let(tmp(v), l, load(l), [tmp(b2)])
    ], ret(tmp(v))),
    block(n1, [], [
        let(tmp(k1), w, sub, [tmp(k), const(1)])
    ], branch(tmp(k1), smash, read)),
    block(read, [], [
        let(tmp(v1), l, load(l), [tmp(back)])
    ], ret(tmp(v1))),
    block(smash, [], [
        let(tmp(a), l, ptoi, [tmp(obj)]),
        let(tmp(a8), l, add, [tmp(a), const(8)]),
        store(l, tmp(a8), tmp(box)),
        let(tmp(moved), p, load(p), [tmp(box)]),
        let(tmp(m2), p, add, [tmp(moved), const(16)]),
        let(tmp(v2), l, load(l), [tmp(m2)])
    ], ret(tmp(v2)))
]).

% A pointer read from memory that never held one has no capability.
run(nocap, [0]).
func(nocap, export, w, [param(w, tmp(k))], [
    block(start, [], [
        let(tmp(box), p, alloc(8), [const(8)]),
        let(tmp(p), p, load(p), [tmp(box)]),
        let(tmp(v), w, load(sw), [tmp(p)])
    ], ret(tmp(v)))
]).

% Pointer loads and stores must be 8-aligned.
run(misaligned, [4]).
run(misaligned, [8]).
func(misaligned, export, w, [param(l, tmp(off))], [
    block(start, [], [
        let(tmp(box), p, alloc(8), [const(24)]),
        let(tmp(q), p, add, [tmp(box), tmp(off)]),
        store(p, tmp(box), tmp(q))
    ], ret(const(1)))
]).

% Pointers through phis and calls, over a loop with back edges.
func(next, local, p, [param(p, tmp(p))], [
    block(start, [], [
        let(tmp(q), p, add, [tmp(p), const(8)])
    ], ret(tmp(q)))
]).

% Walk an array of 8 words, summing them; reading one more traps.
run(walk, [8]).
run(walk, [9]).
func(walk, export, l, [param(w, tmp(n))], [
    block(start, [], [
        let(tmp(a), p, alloc(8), [const(64)])
    ], goto(fill)),
    block(fill, [
        phi(tmp(i), w, [start-const(0), fill-tmp(i1)]),
        phi(tmp(p), p, [start-tmp(a), fill-tmp(p1)])
    ], [
        let(tmp(iv), l, ext(uw), [tmp(i)]),
        let(tmp(sq), l, mul, [tmp(iv), tmp(iv)]),
        store(l, tmp(sq), tmp(p)),
        call(result(tmp(p1), p), global(next), [arg(p, tmp(p))]),
        let(tmp(i1), w, add, [tmp(i), const(1)]),
        let(tmp(c), w, cmp(slt, w), [tmp(i1), const(8)])
    ], branch(tmp(c), fill, sum)),
    block(sum, [], [], goto(loop)),
    block(loop, [
        phi(tmp(j), w, [sum-const(0), body-tmp(j1)]),
        phi(tmp(s), l, [sum-const(0), body-tmp(s1)]),
        phi(tmp(q), p, [sum-tmp(a), body-tmp(q1)])
    ], [
        let(tmp(c2), w, cmp(slt, w), [tmp(j), tmp(n)])
    ], branch(tmp(c2), body, done)),
    block(body, [], [
        let(tmp(v), l, load(l), [tmp(q)]),
        let(tmp(s1), l, add, [tmp(s), tmp(v)]),
        let(tmp(q1), p, add, [tmp(q), const(8)]),
        let(tmp(j1), w, add, [tmp(j), const(1)])
    ], goto(loop)),
    block(done, [], [], ret(tmp(s)))
]).

% Allocations made by a callee outlive it.
func(make, local, p, [param(l, tmp(v))], [
    block(start, [], [
        let(tmp(p), p, alloc(8), [const(8)]),
        store(l, tmp(v), tmp(p))
    ], ret(tmp(p)))
]).

run(outlive, [41]).
func(outlive, export, l, [param(l, tmp(v))], [
    block(start, [], [
        call(result(tmp(p), p), global(make), [arg(l, tmp(v))]),
        let(tmp(x), l, load(l), [tmp(p)]),
        let(tmp(y), l, add, [tmp(x), const(1)])
    ], ret(tmp(y)))
]).
