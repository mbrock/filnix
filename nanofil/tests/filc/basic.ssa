# Fil-C mode: pointers carry capabilities. Each run's outcome is a
# return value or a trap, and a native run must match (a trap is a Fil-C
# safety panic).

# In-bounds reads and writes at every width.
# run: $widths 0
# run: $widths 1
export function l $widths(w %k) {
@start
	%p =p alloc8 16
	storel -2, %p
	%q =p add %p, 8
	storew 305419896, %q
	%r =p add %p, 15
	storeb 255, %r
	%a =l loadsb %p
	%b =l loadl %q
	jnz %k, @one, @zero
@zero
	ret %a
@one
	ret %b
}

# Reads one past the end, and just below the start.
# run: $oob 16
# run: $oob 15
# run: $oob -1
# run: $oob 0
export function w $oob(l %i) {
@start
	%p =p alloc8 16
	%q =p add %p, %i
	%v =w loadub %q
	ret %v
}

# An 8-byte read that starts inside but ends outside.
# run: $straddle 8
# run: $straddle 9
export function l $straddle(l %i) {
@start
	%p =p alloc8 16
	%q =p add %p, %i
	%v =l loadl %q
	ret %v
}

# Allocations are zeroed.
# run: $zeroed 24
export function l $zeroed(l %n) {
@start
	%p =p alloc16 %n
	%q =p add %p, 16
	%v =l loadl %q
	ret %v
}

# An integer turned into a pointer has no capability, even when it is the
# address of a live object.
# run: $forged 0
# run: $forged 1
export function w $forged(w %k) {
@start
	%p =p alloc8 8
	storew 7, %p
	%i =l ptoi %p
	%f =p itop %i
	jnz %k, @forge, @real
@real
	%v =w loadw %p
	ret %v
@forge
	%u =w loadw %f
	ret %u
}

# A pointer constant has no capability.
# run: $nullread 0
export function w $nullread(w %k) {
@start
	%v =w loadw 0
	ret %v
}

# Pointers round-trip through memory with their capabilities; an integer
# store over a pointer slot keeps the capability and moves the address.
# run: $roundtrip 0
# run: $roundtrip 1
# run: $roundtrip 2
export function l $roundtrip(w %k) {
@start
	%obj =p alloc8 32
	%f =p add %obj, 24
	storel 99, %f
	%box =p alloc8 8
	storep %obj, %box
	%back =p loadp %box
	jnz %k, @n1, @plain
@plain
	%b2 =p add %back, 24
	%v =l loadl %b2
	ret %v
@n1
	%k1 =w sub %k, 1
	jnz %k1, @smash, @read
@read
	%v1 =l loadl %back
	ret %v1
@smash
	%a =l ptoi %obj
	%a8 =l add %a, 8
	storel %a8, %box
	%moved =p loadp %box
	%m2 =p add %moved, 16
	%v2 =l loadl %m2
	ret %v2
}

# A pointer read from memory that never held one has no capability.
# run: $nocap 0
export function w $nocap(w %k) {
@start
	%box =p alloc8 8
	%p =p loadp %box
	%v =w loadw %p
	ret %v
}

# Pointer loads and stores must be 8-aligned.
# run: $misaligned 4
# run: $misaligned 8
export function w $misaligned(l %off) {
@start
	%box =p alloc8 24
	%q =p add %box, %off
	storep %box, %q
	ret 1
}

# Pointers through phis and calls, over a loop with back edges.
function p $next(p %p) {
@start
	%q =p add %p, 8
	ret %q
}

# Walk an array of 8 words, summing them; reading one more traps.
# run: $walk 8
# run: $walk 9
export function l $walk(w %n) {
@start
	%a =p alloc8 64
	jmp @fill
@fill
	%i =w phi @start 0, @fill %i1
	%p =p phi @start %a, @fill %p1
	%iv =l extuw %i
	%sq =l mul %iv, %iv
	storel %sq, %p
	%p1 =p call $next(p %p)
	%i1 =w add %i, 1
	%c =w csltw %i1, 8
	jnz %c, @fill, @sum
@sum
	jmp @loop
@loop
	%j =w phi @sum 0, @body %j1
	%s =l phi @sum 0, @body %s1
	%q =p phi @sum %a, @body %q1
	%c2 =w csltw %j, %n
	jnz %c2, @body, @done
@body
	%v =l loadl %q
	%s1 =l add %s, %v
	%q1 =p add %q, 8
	%j1 =w add %j, 1
	jmp @loop
@done
	ret %s
}

# Allocations made by a callee outlive it.
function p $make(l %v) {
@start
	%p =p alloc8 8
	storel %v, %p
	ret %p
}

# run: $outlive 41
export function l $outlive(l %v) {
@start
	%p =p call $make(l %v)
	%x =l loadl %p
	%y =l add %x, 1
	ret %y
}
