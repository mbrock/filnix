% Jump through a site captured before the loop site first executes, then
% through iteration zero's user buffer. That buffer must target the latest
% execution of its site. Repeat without reexecuting either site; collection
% after the outer jump sees the loop pointer only in the saved jmpbuf.
func(nloop, export, w, [], [
    block(start, [], [
        call(result(tmp(outerbuf), p), global(pick), [arg(w, const(2))]),
        let(tmp(outer), w, setjmp('_setjmp'), [tmp(outerbuf), const(0)])
    ], branch(tmp(outer), back, begin)),
    block(back, [], [
        call(void, global(collect), []),
        call(void, global(jump_a), [])
    ], unreachable),
    block(begin, [], [], goto(loop)),
    block(loop, [
        phi(tmp(i), w, [begin-const(0), next-tmp(inc)])
    ], [
        let(tmp(p), p, alloc(8), [const(16)]),
        store(w, tmp(i), tmp(p)),
        let(tmp(scalar), w, add, [tmp(i), const(40)]),
        call(result(tmp(buf), p), global(pick), [arg(w, tmp(i))]),
        let(tmp(r), w, setjmp('_setjmp'), [tmp(buf), const(0)])
    ], branch(tmp(r), resumed, next)),
    block(next, [], [
        let(tmp(inc), w, add, [tmp(i), const(1)]),
        let(tmp(more), w, cmp(slt, w), [tmp(inc), const(2)])
    ], branch(tmp(more), loop, jump)),
    block(jump, [], [
        call(void, global(collect), []),
        call(void, global(jump_c), [])
    ], unreachable),
    block(resumed, [], [
        call(void, global(collect), []),
        let(tmp(v), w, load(sw), [tmp(p)]),
        let(tmp(sum), w, add, [tmp(v), tmp(scalar)]),
        let(tmp(withphi), w, add, [tmp(sum), tmp(i)]),
        let(tmp(out), w, add, [tmp(withphi), tmp(r)]),
        call(result(tmp(again), w), global(again), [])
    ], branch(tmp(again), jump, done)),
    block(done, [], [], ret(tmp(out)))
]).

func(nbad, export, w, [param(p, tmp(buf))], [
    block(start, [], [
        let(tmp(r), w, setjmp(setjmp), [tmp(buf), const(0)])
    ], ret(tmp(r)))
]).

% Before the first dynamic setjmp, the stack walk must see zeroed site
% lowers in this intermediate frame.
func(nforward, export, void, [], [
    block(start, [], [
        call(void, global(jump_a), []),
        call(result(tmp(buf), p), global(pick), [arg(w, const(0))]),
        let(tmp(r), w, setjmp(sigsetjmp), [tmp(buf), const(0)])
    ], ret)
]).
