% The getter copy must survive; only its temporary aliases disappear.
data(cell, local, 8, [item(l, const(41))]).
data(readonly, ro(local), 8, [item(l, const(17))]).
func(read, local, l, [param(p, tmp(p))], [
    block(start, [], [
        let(tmp(q), p, copy, [tmp(p)]),
        let(tmp(x), l, load(l), [tmp(q)])
    ], ret(tmp(x)))
]).
func(global_alias, export, l, [], [
    block(start, [], [
        let(tmp(p), p, copy, [global(cell)]),
        let(tmp(q), p, copy, [tmp(p)]),
        let(tmp(r), p, copy, [tmp(q)]),
        call(result(tmp(x), l), global(read), [arg(p, tmp(r))])
    ], ret(tmp(x)))
]).
run(global_alias, []).

% A pointer phi can select different capabilities. Store/load must retain
% the selected one, not just its address. Both valid and trapping offsets.
func(choose, export, l, [param(w, tmp(which)), param(l, tmp(off))], [
    block(start, [], [
        let(tmp(a), p, copy, [global(cell)]),
        let(tmp(b), p, copy, [global(readonly)]),
        let(tmp(cond), w, copy, [tmp(which)])
    ], branch(tmp(cond), left, right)),
    block(left, [], [
        let(tmp(aa), p, copy, [tmp(a)])
    ], goto(join)),
    block(right, [], [
        let(tmp(bb), p, copy, [tmp(b)])
    ], goto(join)),
    block(join, [
        phi(tmp(p), p, [left-tmp(aa), right-tmp(bb)])
    ], [
        let(tmp(q), p, copy, [tmp(p)]),
        let(tmp(slot), p, alloc(8), [const(8)]),
        let(tmp(slotcopy), p, copy, [tmp(slot)]),
        store(p, tmp(q), tmp(slotcopy)),
        let(tmp(loaded), p, load(p), [tmp(slotcopy)]),
        let(tmp(alias), p, copy, [tmp(loaded)]),
        let(tmp(o), l, copy, [tmp(off)]),
        let(tmp(at), p, add, [tmp(alias), tmp(o)]),
        let(tmp(r), l, load(l), [tmp(at)])
    ], ret(tmp(r)))
]).
run(choose, [1, 0]).
run(choose, [0, 0]).
run(choose, [1, 8]).
run(choose, [0, 18446744073709551615]).

func(readonly_alias, export, w, [], [
    block(start, [], [
        let(tmp(p), p, copy, [global(readonly)]),
        let(tmp(q), p, copy, [tmp(p)]),
        store(b, const(3), tmp(q))
    ], ret(const(0)))
]).
run(readonly_alias, []).

% Integer casts must never acquire the original capability. These traps
% distinguish address equality from equality of Fil-C pointer values.
func(cast_alias, export, l, [], [
    block(start, [], [
        let(tmp(p), p, copy, [global(cell)]),
        let(tmp(q), p, copy, [tmp(p)]),
        let(tmp(i), l, ptoi, [tmp(q)]),
        let(tmp(j), l, copy, [tmp(i)]),
        let(tmp(raw), p, itop, [tmp(j)]),
        let(tmp(alias), p, copy, [tmp(raw)]),
        let(tmp(r), l, load(l), [tmp(alias)])
    ], ret(tmp(r)))
]).
run(cast_alias, []).

% Even if the only pointer is a literal, keep its materialization and
% therefore module mode. A literal pointer has no capability.
func(literal_address, export, l, [], [
    block(start, [], [
        let(tmp(p), p, copy, [const(123)]),
        let(tmp(q), p, copy, [tmp(p)]),
        let(tmp(i), l, ptoi, [tmp(q)])
    ], ret(tmp(i)))
]).
run(literal_address, []).
func(literal_load, export, l, [], [
    block(start, [], [
        let(tmp(p), p, copy, [const(0)]),
        let(tmp(q), p, copy, [tmp(p)]),
        let(tmp(x), l, load(l), [tmp(q)])
    ], ret(tmp(x)))
]).
run(literal_load, []).

% Direct and indirect calls, tuple operands/results, and pointer returns.
func(pair, local, tuple([l, p]), [param(p, tmp(p)), param(l, tmp(n))], [
    block(start, [], [
        let(tmp(q), p, copy, [tmp(p)]),
        let(tmp(x), l, copy, [tmp(n)])
    ], rets([tmp(x), tmp(q)]))
]).
func(indirect, export, l, [param(l, tmp(n))], [
    block(start, [], [
        let(tmp(p), p, copy, [global(cell)]),
        let(tmp(f), p, copy, [global(pair)]),
        let(tmp(g), p, copy, [tmp(f)]),
        let(tmp(h), p, copy, [tmp(g)]),
        let(tmp(x), l, copy, [tmp(n)]),
        call(tuple([result(tmp(number), l), result(tmp(pointer), p)]), tmp(h), [arg(p, tmp(p)), arg(l, tmp(x))]),
        let(tmp(nc), l, copy, [tmp(number)]),
        let(tmp(pc), p, copy, [tmp(pointer)]),
        call(result(tmp(v), l), global(read), [arg(p, tmp(pc))]),
        let(tmp(r), l, sub, [tmp(nc), tmp(v)])
    ], ret(tmp(r)))
]).
run(indirect, [5]).
run(indirect, [100]).

% Calling a copied data pointer is still a non-function trap.
func(not_function, export, l, [], [
    block(start, [], [
        let(tmp(p), p, copy, [global(cell)]),
        let(tmp(q), p, copy, [tmp(p)]),
        call(result(tmp(r), l), tmp(q), [])
    ], ret(tmp(r)))
]).
run(not_function, []).

% A self-backedge phi aliases the entire pointer, not just its address.
func(pointer_invariant, local, p, [param(w, tmp(n))], [
    block(start, [], [
        let(tmp(seed), p, alloc(8), [const(16)]),
        store(l, const(53), tmp(seed))
    ], goto(head)),
    block(head, [
        phi(tmp(p), p, [start-tmp(seed), body-tmp(p)]),
        phi(tmp(i), w, [start-const(0), body-tmp(i1)])
    ], [
        let(tmp(c), w, cmp(slt, w), [tmp(i), tmp(n)])
    ], branch(tmp(c), body, done)),
    block(body, [], [
        let(tmp(i1), w, add, [tmp(i), const(1)])
    ], goto(head)),
    block(done, [], [], ret(tmp(p)))
]).
func(invariant_load, export, l, [param(w, tmp(n)), param(l, tmp(off))], [
    block(start, [], [
        call(result(tmp(p), p), global(pointer_invariant), [arg(w, tmp(n))]),
        let(tmp(at), p, add, [tmp(p), tmp(off)]),
        let(tmp(v), l, load(l), [tmp(at)])
    ], ret(tmp(v)))
]).
run(invariant_load, [0, 0]).
run(invariant_load, [5, 0]).
run(invariant_load, [3, 16]).
run(invariant_load, [2, 18446744073709551615]).
