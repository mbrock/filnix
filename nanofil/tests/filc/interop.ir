% Called from interop.c (clang-built Fil-C); see run-c.sh.

func(sumbytes, export, l, [param(p, tmp(buf)), param(l, tmp(n))], [
    block(start, [], [], goto(loop)),
    block(loop, [
        phi(tmp(i), l, [start-const(0), body-tmp(i1)]),
        phi(tmp(s), l, [start-const(0), body-tmp(s1)])
    ], [
        let(tmp(c), w, cmp(slt, l), [tmp(i), tmp(n)])
    ], branch(tmp(c), body, done)),
    block(body, [], [
        let(tmp(q), p, add, [tmp(buf), tmp(i)]),
        let(tmp(b), l, load(ub), [tmp(q)]),
        let(tmp(s1), l, add, [tmp(s), tmp(b)]),
        let(tmp(i1), l, add, [tmp(i), const(1)])
    ], goto(loop)),
    block(done, [], [], ret(tmp(s)))
]).

func(setslot, export, void, [param(p, tmp(slot)), param(p, tmp(v))], [
    block(start, [], [
        store(p, tmp(v), tmp(slot))
    ], ret)
]).

func(getslot, export, p, [param(p, tmp(slot))], [
    block(start, [], [
        let(tmp(v), p, load(p), [tmp(slot)])
    ], ret(tmp(v)))
]).

func(offset, export, p, [param(p, tmp(p)), param(l, tmp(off))], [
    block(start, [], [
        let(tmp(q), p, add, [tmp(p), tmp(off)])
    ], ret(tmp(q)))
]).

func(poke, export, void, [param(p, tmp(p)), param(w, tmp(v))], [
    block(start, [], [
        store(b, tmp(v), tmp(p))
    ], ret)
]).

% Ten words of arguments: the last pointers go on the stack, and the
% fourth pointer is split between %r9 and the stack.
func(five, export, l, [param(p, tmp(a)), param(p, tmp(b)), param(p, tmp(c)), param(p, tmp(d)), param(p, tmp(e))], [
    block(start, [], [
        let(tmp(va), l, load(ub), [tmp(a)]),
        let(tmp(vb), l, load(ub), [tmp(b)]),
        let(tmp(vc), l, load(ub), [tmp(c)]),
        let(tmp(vd), l, load(ub), [tmp(d)]),
        let(tmp(ve), l, load(ub), [tmp(e)]),
        let(tmp(x1), l, mul, [tmp(vb), const(10)]),
        let(tmp(x2), l, mul, [tmp(vc), const(100)]),
        let(tmp(x3), l, mul, [tmp(vd), const(1000)]),
        let(tmp(x4), l, mul, [tmp(ve), const(10000)]),
        let(tmp(s1), l, add, [tmp(va), tmp(x1)]),
        let(tmp(s2), l, add, [tmp(s1), tmp(x2)]),
        let(tmp(s3), l, add, [tmp(s2), tmp(x3)]),
        let(tmp(s4), l, add, [tmp(s3), tmp(x4)])
    ], ret(tmp(s4)))
]).

% Calls into C, and back into nanofil through C.
func(callc, export, l, [param(p, tmp(s))], [
    block(start, [], [
        call(result(tmp(n), l), global(c_len), [arg(p, tmp(s))]),
        call(result(tmp(m), p), global(c_mid), [arg(p, tmp(s))]),
        let(tmp(v), l, load(ub), [tmp(m)]),
        call(result(tmp(k), l), global(c_five), [arg(p, tmp(s))]),
        let(tmp(a), l, mul, [tmp(n), const(1000)]),
        let(tmp(b), l, add, [tmp(a), tmp(v)]),
        let(tmp(r), l, add, [tmp(b), tmp(k)])
    ], ret(tmp(r)))
]).
