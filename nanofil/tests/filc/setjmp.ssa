# Jump through a site captured before the loop site first executes, then
# through iteration zero's user buffer. That buffer must target the latest
# execution of its site. Repeat without reexecuting either site; collection
# after the outer jump sees the loop pointer only in the saved jmpbuf.
export function w $nloop() {
@start
    %outerbuf =p call $pick(w 2)
    %outer =w _setjmp %outerbuf, 0
    jnz %outer, @back, @begin
@back
    call $collect()
    call $jump_a()
    hlt
@begin
    jmp @loop
@loop
    %i =w phi @begin 0, @next %inc
    %p =p alloc8 16
    storew %i, %p
    %scalar =w add %i, 40
    %buf =p call $pick(w %i)
    %r =w _setjmp %buf, 0
    jnz %r, @resumed, @next
@next
    %inc =w add %i, 1
    %more =w csltw %inc, 2
    jnz %more, @loop, @jump
@jump
    call $collect()
    call $jump_c()
    hlt
@resumed
    call $collect()
    %v =w loadsw %p
    %sum =w add %v, %scalar
    %withphi =w add %sum, %i
    %out =w add %withphi, %r
    %again =w call $again()
    jnz %again, @jump, @done
@done
    ret %out
}

export function w $nbad(p %buf) {
@start
    %r =w setjmp %buf, 0
    ret %r
}

# Before the first dynamic setjmp, the stack walk must see zeroed site
# lowers in this intermediate frame.
export function $nforward() {
@start
    call $jump_a()
    %buf =p call $pick(w 0)
    %r =w sigsetjmp %buf, 0
    ret
}
