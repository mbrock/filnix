data $floats = align 8 { s s_1.5, s s_2.5, d d_3.25 }

export function w $arithmetic() {
@start
    %a =s add s_1.5, s_2.5
    %b =s sub %a, s_1.25
    %c =s mul %b, s_4.0
    %d =s div %c, s_2.0
    %e =s neg %d
    %f =d exts %e
    %g =d add %f, d_10.0
    %h =s truncd %g
    %i =w stosi %h
    ret %i
}

export function w $unordered() {
@start
    %nan =d cast 9221120237041090626
    %a =w ceqd %nan, d_0.0
    %b =w cned %nan, d_0.0
    %c =w cltd %nan, d_0.0
    %d =w cled %nan, d_0.0
    %e =w cgtd %nan, d_0.0
    %f =w cged %nan, d_0.0
    %g =w cod %nan, d_0.0
    %h =w cuod %nan, d_0.0
    %ab =w add %a, %b
    %cd =w add %c, %d
    %ef =w add %e, %f
    %gh =w add %g, %h
    %x =w add %ab, %cd
    %y =w add %ef, %gh
    %r =w add %x, %y
    ret %r
}

export function l $from_unsigned(l %n) {
@start
    %f =d ultof %n
    %r =l cast %f
    ret %r
}
export function w $unsigned_single(l %n) {
@start
    %f =s ultof %n
    %r =w cast %f
    ret %r
}
export function l $back_unsigned() {
@start
    %a =l dtoui d_13835058055282163712.0
    %b =l stoui s_9223372036854775808.0
    %r =l sub %a, %b
    ret %r
}
export function w $memory() {
@start
    %p =l alloc8 16
    stores s_1.5, %p
    %a =s loads %p
    %q =l add %p, 8
    stored d_2.5, %q
    %b =d loadd %q
    %c =d exts %a
    %d =d add %b, %c
    %e =w dtosi %d
    ret %e
}
export function l $phi(w %which) {
@start
    jnz %which, @a, @b
@a
    jmp @end
@b
    jmp @end
@end
    %f =d phi @a d_1.25, @b d_2.5
    %r =l cast %f
    ret %r
}
function d $many(l %i, d %a, d %b, d %c, d %d, d %e, d %f, d %g, d %h, d %j, l %k, l %l, l %m, l %n, l %o, l %p) {
@start
    %x =d add %a, %j
    %y =d sltof %p
    %r =d add %x, %y
    ret %r
}
export function w $spill() {
@start
    %r =d call $many(l 1, d d_2.0, d d_3.0, d d_4.0, d d_5.0, d d_6.0, d d_7.0, d d_8.0, d d_9.0, d d_10.0, l 11, l 12, l 13, l 14, l 15, l 16)
    %i =w dtosi %r
    ret %i
}
export function l $static_data() {
@start
    %a =s loads $floats
    %p =l add $floats, 4
    %b =s loads %p
    %q =l add $floats, 8
    %c =d loadd %q
    %d =s add %a, %b
    %e =d exts %d
    %f =d add %e, %c
    %r =l cast %f
    ret %r
}
export function w $negative_zero() {
@start
    %z =s neg s_0.0
    %r =w cast %z
    ret %r
}
export function l $nan_payload() {
@start
    %a =d cast 9221120237041090626
    %b =d cast 9221120237041090642
    %f =d add %a, %b
    %r =l cast %f
    ret %r
}
