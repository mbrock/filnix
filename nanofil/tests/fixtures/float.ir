func(back_unsigned, export, l, [], [
    block(start, [], [
        let(tmp(a), l, dtoui, [const(4893160995138043904)]),
        let(tmp(b), l, stoui, [const(1593835520)]),
        let(tmp(r), l, sub, [tmp(a), tmp(b)])
    ], ret(tmp(r)))
]).
func(memory, export, w, [], [
    block(start, [], [
        let(tmp(p), l, alloc(8), [const(16)]),
        store(s, const(1069547520), tmp(p)),
        let(tmp(a), s, load(s), [tmp(p)]),
        let(tmp(q), l, add, [tmp(p), const(8)]),
        store(d, const(4612811918334230528), tmp(q)),
        let(tmp(b), d, load(d), [tmp(q)]),
        let(tmp(c), d, ext(s), [tmp(a)]),
        let(tmp(d), d, add, [tmp(b), tmp(c)]),
        let(tmp(e), w, dtosi, [tmp(d)])
    ], ret(tmp(e)))
]).
func(phi, export, l, [param(w, tmp(which))], [
    block(start, [], [], branch(tmp(which), a, b)),
    block(a, [], [], goto(end)),
    block(b, [], [], goto(end)),
    block(end, [
        phi(tmp(f), d, [a-const(4608308318706860032), b-const(4612811918334230528)])
    ], [
        let(tmp(r), l, cast, [tmp(f)])
    ], ret(tmp(r)))
]).
func(many, local, d, [param(l, tmp(i)), param(d, tmp(a)), param(d, tmp(b)), param(d, tmp(c)), param(d, tmp(d)), param(d, tmp(e)), param(d, tmp(f)), param(d, tmp(g)), param(d, tmp(h)), param(d, tmp(j)), param(l, tmp(k)), param(l, tmp(l)), param(l, tmp(m)), param(l, tmp(n)), param(l, tmp(o)), param(l, tmp(p))], [
    block(start, [], [
        let(tmp(x), d, add, [tmp(a), tmp(j)]),
        let(tmp(y), d, sltof, [tmp(p)]),
        let(tmp(r), d, add, [tmp(x), tmp(y)])
    ], ret(tmp(r)))
]).
func(spill, export, w, [], [
    block(start, [], [
        call(result(tmp(r), d), global(many), [arg(l, const(1)), arg(d, const(4611686018427387904)), arg(d, const(4613937818241073152)), arg(d, const(4616189618054758400)), arg(d, const(4617315517961601024)), arg(d, const(4618441417868443648)), arg(d, const(4619567317775286272)), arg(d, const(4620693217682128896)), arg(d, const(4621256167635550208)), arg(d, const(4621819117588971520)), arg(l, const(11)), arg(l, const(12)), arg(l, const(13)), arg(l, const(14)), arg(l, const(15)), arg(l, const(16))]),
        let(tmp(i), w, dtosi, [tmp(r)])
    ], ret(tmp(i)))
]).
func(static_data, export, l, [], [
    block(start, [], [
        let(tmp(a), s, load(s), [global(floats)]),
        let(tmp(p), l, add, [global(floats), const(4)]),
        let(tmp(b), s, load(s), [tmp(p)]),
        let(tmp(q), l, add, [global(floats), const(8)]),
        let(tmp(c), d, load(d), [tmp(q)]),
        let(tmp(d), s, add, [tmp(a), tmp(b)]),
        let(tmp(e), d, ext(s), [tmp(d)]),
        let(tmp(f), d, add, [tmp(e), tmp(c)]),
        let(tmp(r), l, cast, [tmp(f)])
    ], ret(tmp(r)))
]).
