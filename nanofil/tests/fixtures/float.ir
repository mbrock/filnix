% Scalar SSE2, including unordered flags, unsigned high halves and spills.
run(arithmetic, []).
run(unordered, []).
run(from_unsigned, [0]).
run(from_unsigned, [9223372036854775808]).
run(from_unsigned, [9223372036854776833]).
run(from_unsigned, [18446744073709551615]).
run(unsigned_single, [18446744073709551615]).
run(back_unsigned, []).
run(memory, []).
run(phi, [0]).
run(phi, [1]).
run(spill, []).
run(static_data, []).
run(negative_zero, []).
run(nan_payload, []).

data(floats, local, 8, [item(s, c(1069547520)), item(s, c(1075838976)), item(d, c(4614500768194494464))]).

func(arithmetic, export, w, [], [
    blk(start, [], [
        ins(t(a), s, add, [c(1069547520), c(1075838976)]),
        ins(t(b), s, sub, [t(a), c(1067450368)]),
        ins(t(c), s, mul, [t(b), c(1082130432)]),
        ins(t(d), s, div, [t(c), c(1073741824)]),
        ins(t(e), s, neg, [t(d)]),
        ins(t(f), d, ext(s), [t(e)]),
        ins(t(g), d, add, [t(f), c(4621819117588971520)]),
        ins(t(h), s, truncd, [t(g)]),
        ins(t(i), w, stosi, [t(h)])
    ], ret(t(i)))
]).

func(unordered, export, w, [], [
    blk(start, [], [
        ins(t(nan), d, cast, [c(9221120237041090626)]),
        ins(t(a), w, cmp(eq, d), [t(nan), c(0)]),
        ins(t(b), w, cmp(ne, d), [t(nan), c(0)]),
        ins(t(c), w, cmp(lt, d), [t(nan), c(0)]),
        ins(t(d), w, cmp(le, d), [t(nan), c(0)]),
        ins(t(e), w, cmp(gt, d), [t(nan), c(0)]),
        ins(t(f), w, cmp(ge, d), [t(nan), c(0)]),
        ins(t(g), w, cmp(o, d), [t(nan), c(0)]),
        ins(t(h), w, cmp(uo, d), [t(nan), c(0)]),
        ins(t(ab), w, add, [t(a), t(b)]),
        ins(t(cd), w, add, [t(c), t(d)]),
        ins(t(ef), w, add, [t(e), t(f)]),
        ins(t(gh), w, add, [t(g), t(h)]),
        ins(t(x), w, add, [t(ab), t(cd)]),
        ins(t(y), w, add, [t(ef), t(gh)]),
        ins(t(r), w, add, [t(x), t(y)])
    ], ret(t(r)))
]).

func(from_unsigned, export, l, [par(l, t(n))], [
    blk(start, [], [
        ins(t(f), d, ultof, [t(n)]),
        ins(t(r), l, cast, [t(f)])
    ], ret(t(r)))
]).
func(unsigned_single, export, w, [par(l, t(n))], [
    blk(start, [], [
        ins(t(f), s, ultof, [t(n)]),
        ins(t(r), w, cast, [t(f)])
    ], ret(t(r)))
]).
func(back_unsigned, export, l, [], [
    blk(start, [], [
        ins(t(a), l, dtoui, [c(4893160995138043904)]),
        ins(t(b), l, stoui, [c(1593835520)]),
        ins(t(r), l, sub, [t(a), t(b)])
    ], ret(t(r)))
]).
func(memory, export, w, [], [
    blk(start, [], [
        ins(t(p), l, alloc(8), [c(16)]),
        store(s, c(1069547520), t(p)),
        ins(t(a), s, load(s), [t(p)]),
        ins(t(q), l, add, [t(p), c(8)]),
        store(d, c(4612811918334230528), t(q)),
        ins(t(b), d, load(d), [t(q)]),
        ins(t(c), d, ext(s), [t(a)]),
        ins(t(d), d, add, [t(b), t(c)]),
        ins(t(e), w, dtosi, [t(d)])
    ], ret(t(e)))
]).
func(phi, export, l, [par(w, t(which))], [
    blk(start, [], [], jnz(t(which), a, b)),
    blk(a, [], [], jmp(end)),
    blk(b, [], [], jmp(end)),
    blk(end, [
        phi(t(f), d, [a-c(4608308318706860032), b-c(4612811918334230528)])
    ], [
        ins(t(r), l, cast, [t(f)])
    ], ret(t(r)))
]).
func(many, local, d, [par(l, t(i)), par(d, t(a)), par(d, t(b)), par(d, t(c)), par(d, t(d)), par(d, t(e)), par(d, t(f)), par(d, t(g)), par(d, t(h)), par(d, t(j)), par(l, t(k)), par(l, t(l)), par(l, t(m)), par(l, t(n)), par(l, t(o)), par(l, t(p))], [
    blk(start, [], [
        ins(t(x), d, add, [t(a), t(j)]),
        ins(t(y), d, sltof, [t(p)]),
        ins(t(r), d, add, [t(x), t(y)])
    ], ret(t(r)))
]).
func(spill, export, w, [], [
    blk(start, [], [
        call(to(t(r), d), glo(many), [arg(l, c(1)), arg(d, c(4611686018427387904)), arg(d, c(4613937818241073152)), arg(d, c(4616189618054758400)), arg(d, c(4617315517961601024)), arg(d, c(4618441417868443648)), arg(d, c(4619567317775286272)), arg(d, c(4620693217682128896)), arg(d, c(4621256167635550208)), arg(d, c(4621819117588971520)), arg(l, c(11)), arg(l, c(12)), arg(l, c(13)), arg(l, c(14)), arg(l, c(15)), arg(l, c(16))]),
        ins(t(i), w, dtosi, [t(r)])
    ], ret(t(i)))
]).
func(static_data, export, l, [], [
    blk(start, [], [
        ins(t(a), s, load(s), [glo(floats)]),
        ins(t(p), l, add, [glo(floats), c(4)]),
        ins(t(b), s, load(s), [t(p)]),
        ins(t(q), l, add, [glo(floats), c(8)]),
        ins(t(c), d, load(d), [t(q)]),
        ins(t(d), s, add, [t(a), t(b)]),
        ins(t(e), d, ext(s), [t(d)]),
        ins(t(f), d, add, [t(e), t(c)]),
        ins(t(r), l, cast, [t(f)])
    ], ret(t(r)))
]).
func(negative_zero, export, w, [], [
    blk(start, [], [
        ins(t(z), s, neg, [c(0)]),
        ins(t(r), w, cast, [t(z)])
    ], ret(t(r)))
]).
func(nan_payload, export, l, [], [
    blk(start, [], [
        ins(t(a), d, cast, [c(9221120237041090626)]),
        ins(t(b), d, cast, [c(9221120237041090642)]),
        ins(t(f), d, add, [t(a), t(b)]),
        ins(t(r), l, cast, [t(f)])
    ], ret(t(r)))
]).
