run(nan_payload, []).

data(floats, local, 8, [item(s, const(1069547520)), item(s, const(1075838976)), item(d, const(4614500768194494464))]).

func(arithmetic, export, w, [], [
    block(start, [], [
        let(tmp(a), s, add, [const(1069547520), const(1075838976)]),
        let(tmp(b), s, sub, [tmp(a), const(1067450368)]),
        let(tmp(c), s, mul, [tmp(b), const(1082130432)]),
        let(tmp(d), s, div, [tmp(c), const(1073741824)]),
        let(tmp(e), s, neg, [tmp(d)]),
        let(tmp(f), d, ext(s), [tmp(e)]),
        let(tmp(g), d, add, [tmp(f), const(4621819117588971520)]),
        let(tmp(h), s, truncd, [tmp(g)]),
        let(tmp(i), w, stosi, [tmp(h)])
    ], ret(tmp(i)))
]).

func(unordered, export, w, [], [
    block(start, [], [
        let(tmp(nan), d, cast, [const(9221120237041090626)]),
        let(tmp(a), w, cmp(eq, d), [tmp(nan), const(0)]),
        let(tmp(b), w, cmp(ne, d), [tmp(nan), const(0)]),
        let(tmp(c), w, cmp(lt, d), [tmp(nan), const(0)]),
        let(tmp(d), w, cmp(le, d), [tmp(nan), const(0)]),
        let(tmp(e), w, cmp(gt, d), [tmp(nan), const(0)]),
        let(tmp(f), w, cmp(ge, d), [tmp(nan), const(0)]),
        let(tmp(g), w, cmp(o, d), [tmp(nan), const(0)]),
        let(tmp(h), w, cmp(uo, d), [tmp(nan), const(0)]),
        let(tmp(ab), w, add, [tmp(a), tmp(b)]),
        let(tmp(cd), w, add, [tmp(c), tmp(d)]),
        let(tmp(ef), w, add, [tmp(e), tmp(f)]),
        let(tmp(gh), w, add, [tmp(g), tmp(h)]),
        let(tmp(x), w, add, [tmp(ab), tmp(cd)]),
        let(tmp(y), w, add, [tmp(ef), tmp(gh)]),
        let(tmp(r), w, add, [tmp(x), tmp(y)])
    ], ret(tmp(r)))
]).

func(from_unsigned, export, l, [param(l, tmp(n))], [
    block(start, [], [
        let(tmp(f), d, ultof, [tmp(n)]),
        let(tmp(r), l, cast, [tmp(f)])
    ], ret(tmp(r)))
]).
func(unsigned_single, export, w, [param(l, tmp(n))], [
