# Memory, control flow, calls and data.

data $msg = align 1 { b "hi\n\001", b 0 }
data $tab = { w 10 20 30, w -1, l $tab + 4, z 4 }

# Little-endian stores and sign/zero-extending loads.
# run: $bytes 0
# run: $bytes 1
# run: $bytes 2
# run: $bytes 3
# run: $bytes 4
export function l $bytes(w %k) {
@start
	%p =l alloc8 16
	storel -2, %p
	%q =l add %p, 8
	storew 305419896, %q
	%q1 =l add %p, 9
	storeb 255, %q1
	%a =l loadsb %p
	%b =l loadub %q1
	%c =l loaduh %q
	%d =l loadsw %p
	%e =l loadl %q
	jnz %k, @n1, @r0
@r0
	ret %a
@n1
	%k1 =w sub %k, 1
	jnz %k1, @n2, @r1
@r1
	ret %b
@n2
	%k2 =w sub %k1, 1
	jnz %k2, @n3, @r2
@r2
	ret %c
@n3
	%k3 =w sub %k2, 1
	jnz %k3, @r4, @r3
@r3
	ret %d
@r4
	%w =l loaduw %q
	ret %w
}

# A counted loop with phis.
# run: $sum 0
# run: $sum 10
# run: $sum 1000
export function l $sum(l %n) {
@start
	jmp @loop
@loop
	%i =l phi @start 0, @body %i1
	%s =l phi @start 0, @body %s1
	%c =w csltl %i, %n
	jnz %c, @body, @done
@body
	%sq =l mul %i, %i
	%s1 =l add %s, %sq
	%i1 =l add %i, 1
	jmp @loop
@done
	ret %s
}

# Phis read their inputs simultaneously: a swap.
# run: $swap 5 3
# run: $swap 1 8
export function w $swap(w %a, w %b) {
@start
	jmp @loop
@loop
	%x =w phi @start %a, @loop %y
	%y =w phi @start %b, @loop %x
	%i =w phi @start 0, @loop %i1
	%i1 =w add %i, 1
	%c =w csltw %i1, 3
	jnz %c, @loop, @out
@out
	%r =w mul %x, 100
	%t =w add %r, %y
	ret %t
}

# Non-SSA input: a temp assigned twice.
# run: $twice 6
export function w $twice(w %a) {
@start
	%t =w add %a, 1
	%t =w mul %t, 2
	ret %t
}

function w $fib(w %n) {
@start
	%c =w csltw %n, 2
	jnz %c, @base, @rec
@base
	ret %n
@rec
	%n1 =w sub %n, 1
	%n2 =w sub %n, 2
	%a =w call $fib(w %n1)
	%b =w call $fib(w %n2)
	%r =w add %a, %b
	ret %r
}

# run: $fibs 0
# run: $fibs 1
# run: $fibs 15
export function w $fibs(w %n) {
@start
	%r =w call $fib(w %n)
	ret %r
}

function $poke(l %p, w %v) {
@start
	storew %v, %p
	ret
}

# A callee stores through a pointer into the caller's frame.
# run: $viacall 41
export function w $viacall(w %v) {
@start
	%p =l alloc4 4
	%v1 =w add %v, 1
	call $poke(l %p, w %v1)
	%r =w loadw %p
	ret %r
}

# Reading data: string bytes, words, a symbol plus offset.
# run: $data 0
# run: $data 1
# run: $data 2
# run: $data 3
export function l $data(w %k) {
@start
	%m =l copy $msg
	%m2 =l add %m, 2
	%c =l loadub %m2
	%m3 =l add %m, 3
	%d =l loadub %m3
	%t =l add $tab, 12
	%w =l loadsw %t
	%pp =l add $tab, 16
	%p =l loadl %pp
	%v =l loadsw %p
	jnz %k, @n1, @r0
@r0
	%cd =l mul %c, 1000
	%r0 =l add %cd, %d
	ret %r0
@n1
	%k1 =w sub %k, 1
	jnz %k1, @n2, @r1
@r1
	ret %w
@n2
	%k2 =w sub %k1, 1
	jnz %k2, @r3, @r2
@r2
	ret %v
@r3
	%z =l add $tab, 24
	%zv =l loadsw %z
	ret %zv
}

# Void return through the harness.
# run: $nothing 3
export function $nothing(w %a) {
@start
	ret
}
