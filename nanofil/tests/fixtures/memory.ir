% Memory, control flow, calls and data.

data(msg, local, 1, [item(b, str("hi\n\x1\")), item(b, const(0))]).
data(tab, local, 8, [item(w, const(10)), item(w, const(20)), item(w, const(30)), item(w, const(-1)), item(l, sym(tab, 4)), zero(4)]).

% Little-endian stores and sign/zero-extending loads.
run(bytes, [0]).
run(bytes, [1]).
run(bytes, [2]).
run(bytes, [3]).
run(bytes, [4]).
func(bytes, export, l, [param(w, tmp(k))], [
    block(start, [], [
        let(tmp(p), l, alloc(8), [const(16)]),
        store(l, const(-2), tmp(p)),
        let(tmp(q), l, add, [tmp(p), const(8)]),
        store(w, const(305419896), tmp(q)),
        let(tmp(q1), l, add, [tmp(p), const(9)]),
        store(b, const(255), tmp(q1)),
        let(tmp(a), l, load(sb), [tmp(p)]),
        let(tmp(b), l, load(ub), [tmp(q1)]),
        let(tmp(c), l, load(uh), [tmp(q)]),
        let(tmp(d), l, load(sw), [tmp(p)]),
        let(tmp(e), l, load(l), [tmp(q)])
    ], branch(tmp(k), n1, r0)),
    block(r0, [], [], ret(tmp(a))),
    block(n1, [], [
        let(tmp(k1), w, sub, [tmp(k), const(1)])
    ], branch(tmp(k1), n2, r1)),
    block(r1, [], [], ret(tmp(b))),
    block(n2, [], [
        let(tmp(k2), w, sub, [tmp(k1), const(1)])
    ], branch(tmp(k2), n3, r2)),
    block(r2, [], [], ret(tmp(c))),
    block(n3, [], [
        let(tmp(k3), w, sub, [tmp(k2), const(1)])
    ], branch(tmp(k3), r4, r3)),
    block(r3, [], [], ret(tmp(d))),
    block(r4, [], [
        let(tmp(w), l, load(uw), [tmp(q)])
    ], ret(tmp(w)))
]).

% A counted loop with phis.
run(sum, [0]).
run(sum, [10]).
run(sum, [1000]).
func(sum, export, l, [param(l, tmp(n))], [
    block(start, [], [], goto(loop)),
    block(loop, [
        phi(tmp(i), l, [start-const(0), body-tmp(i1)]),
        phi(tmp(s), l, [start-const(0), body-tmp(s1)])
    ], [
        let(tmp(c), w, cmp(slt, l), [tmp(i), tmp(n)])
    ], branch(tmp(c), body, done)),
    block(body, [], [
        let(tmp(sq), l, mul, [tmp(i), tmp(i)]),
        let(tmp(s1), l, add, [tmp(s), tmp(sq)]),
        let(tmp(i1), l, add, [tmp(i), const(1)])
    ], goto(loop)),
    block(done, [], [], ret(tmp(s)))
]).

% Phis read their inputs simultaneously: a swap.
run(swap, [5, 3]).
run(swap, [1, 8]).
func(swap, export, w, [param(w, tmp(a)), param(w, tmp(b))], [
    block(start, [], [], goto(loop)),
    block(loop, [
        phi(tmp(x), w, [start-tmp(a), loop-tmp(y)]),
        phi(tmp(y), w, [start-tmp(b), loop-tmp(x)]),
        phi(tmp(i), w, [start-const(0), loop-tmp(i1)])
    ], [
        let(tmp(i1), w, add, [tmp(i), const(1)]),
        let(tmp(c), w, cmp(slt, w), [tmp(i1), const(3)])
    ], branch(tmp(c), loop, out)),
    block(out, [], [
        let(tmp(r), w, mul, [tmp(x), const(100)]),
        let(tmp(t), w, add, [tmp(r), tmp(y)])
    ], ret(tmp(t)))
]).

% Non-SSA input: a temp assigned twice.
run(twice, [6]).
func(twice, export, w, [param(w, tmp(a))], [
    block(start, [], [
        let(tmp(t), w, add, [tmp(a), const(1)]),
        let(tmp(t), w, mul, [tmp(t), const(2)])
    ], ret(tmp(t)))
]).

func(fib, local, w, [param(w, tmp(n))], [
    block(start, [], [
        let(tmp(c), w, cmp(slt, w), [tmp(n), const(2)])
    ], branch(tmp(c), base, rec)),
    block(base, [], [], ret(tmp(n))),
    block(rec, [], [
        let(tmp(n1), w, sub, [tmp(n), const(1)]),
        let(tmp(n2), w, sub, [tmp(n), const(2)]),
        call(result(tmp(a), w), global(fib), [arg(w, tmp(n1))]),
        call(result(tmp(b), w), global(fib), [arg(w, tmp(n2))]),
        let(tmp(r), w, add, [tmp(a), tmp(b)])
    ], ret(tmp(r)))
]).

run(fibs, [0]).
run(fibs, [1]).
run(fibs, [15]).
func(fibs, export, w, [param(w, tmp(n))], [
    block(start, [], [
        call(result(tmp(r), w), global(fib), [arg(w, tmp(n))])
    ], ret(tmp(r)))
]).

func(poke, local, void, [param(l, tmp(p)), param(w, tmp(v))], [
    block(start, [], [
        store(w, tmp(v), tmp(p))
    ], ret)
]).

% A callee stores through a pointer into the caller's frame.
run(viacall, [41]).
func(viacall, export, w, [param(w, tmp(v))], [
    block(start, [], [
        let(tmp(p), l, alloc(4), [const(4)]),
        let(tmp(v1), w, add, [tmp(v), const(1)]),
        call(void, global(poke), [arg(l, tmp(p)), arg(w, tmp(v1))]),
        let(tmp(r), w, load(sw), [tmp(p)])
    ], ret(tmp(r)))
]).

% Reading data: string bytes, words, a symbol plus offset.
run(data, [0]).
run(data, [1]).
run(data, [2]).
run(data, [3]).
func(data, export, l, [param(w, tmp(k))], [
    block(start, [], [
        let(tmp(m), l, copy, [global(msg)]),
        let(tmp(m2), l, add, [tmp(m), const(2)]),
        let(tmp(c), l, load(ub), [tmp(m2)]),
        let(tmp(m3), l, add, [tmp(m), const(3)]),
        let(tmp(d), l, load(ub), [tmp(m3)]),
        let(tmp(t), l, add, [global(tab), const(12)]),
        let(tmp(w), l, load(sw), [tmp(t)]),
        let(tmp(pp), l, add, [global(tab), const(16)]),
        let(tmp(p), l, load(l), [tmp(pp)]),
        let(tmp(v), l, load(sw), [tmp(p)])
    ], branch(tmp(k), n1, r0)),
    block(r0, [], [
        let(tmp(cd), l, mul, [tmp(c), const(1000)]),
        let(tmp(r0), l, add, [tmp(cd), tmp(d)])
    ], ret(tmp(r0))),
    block(n1, [], [
        let(tmp(k1), w, sub, [tmp(k), const(1)])
    ], branch(tmp(k1), n2, r1)),
    block(r1, [], [], ret(tmp(w))),
    block(n2, [], [
        let(tmp(k2), w, sub, [tmp(k1), const(1)])
    ], branch(tmp(k2), r3, r2)),
    block(r2, [], [], ret(tmp(v))),
    block(r3, [], [
        let(tmp(z), l, add, [global(tab), const(24)]),
        let(tmp(zv), l, load(sw), [tmp(z)])
    ], ret(tmp(zv)))
]).

% Void return through the harness.
run(nothing, [3]).
func(nothing, export, void, [param(w, tmp(a))], [
    block(start, [], [], ret)
]).
