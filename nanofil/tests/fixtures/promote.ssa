# Stack slots in the shapes promote handles (docs/m5.md) and the ones it
# must leave alone, in plain mode so qbe compiles both versions.

# A counter and an accumulator in slots, across a loop.
export function l $loop(w %n) {
@start
	%i =l alloc4 4
	%acc =l alloc8 8
	storew 0, %i
	storel 1, %acc
	jmp @head
@head
	%iv =w loadsw %i
	%c =w csltw %iv, %n
	jnz %c, @body, @done
@body
	%a =l loadl %acc
	%iv2 =w loadsw %i
	%x =l extsw %iv2
	%a2 =l add %a, %x
	%a3 =l mul %a2, 3
	storel %a3, %acc
	%iv3 =w add %iv2, 1
	storew %iv3, %i
	jmp @head
@done
	%r =l loadl %acc
	ret %r
}
# run: $loop 0
# run: $loop 5
# run: $loop 40

# A diamond that stores on one side only, so the join needs a phi.
export function w $diamond(w %a, w %b) {
@start
	%s =l alloc4 4
	storew %a, %s
	jnz %b, @then, @join
@then
	%v =w loadsw %s
	%v2 =w mul %v, %b
	storew %v2, %s
	jmp @join
@join
	%r =w loaduw %s
	ret %r
}
# run: $diamond 7 0
# run: $diamond 7 6
# run: $diamond 4294967295 2

# Narrow slots: the load extends the stored value again. (Reading a w
# slot at l both ways is tests/qbe-bugs/load-ext-l.ssa: qbe gets it wrong.)
export function l $narrow(w %a) {
@start
	%b =l alloc4 1
	%h =l alloc4 2
	%w =l alloc4 4
	storeb %a, %b
	storeh %a, %h
	storew %a, %w
	%x =w loadsb %b
	%y =w loadub %b
	%z =l loadsh %h
	%u =l loaduh %h
	%s =w loadsw %w
	%t =w loaduw %w
	%x1 =l extsw %x
	%y1 =l extsw %y
	%p =l add %x1, %y1
	%q =l xor %z, %u
	%r0 =l add %p, %q
	%r1w =w sub %s, %t
	%r1 =l extsw %r1w
	%r =l add %r0, %r1
	ret %r
}
# run: $narrow 0
# run: $narrow 127
# run: $narrow 128
# run: $narrow 65535
# run: $narrow 4294967295
# run: $narrow 2147516544

# A two-field struct at constant offsets: two slots of one alloc.
export function l $fields(l %a, w %b) {
@start
	%s =l alloc8 16
	%f =l add %s, 8
	%g =l add %f, 4
	storel %a, %s
	storew %b, %f
	storew 5, %g
	jnz %b, @swap, @out
@swap
	%x =l loadl %s
	%y =w loadsw %f
	%y1 =l extsw %y
	storel %y1, %s
	storew %x, %f
	jmp @out
@out
	%p =l loadl %s
	%q =w loaduw %f
	%q1 =l extuw %q
	%k =w loaduw %g
	%k1 =l extuw %k
	%r0 =l mul %p, 1000
	%r1 =l add %r0, %q1
	%r =l add %r1, %k1
	ret %r
}
# run: $fields 3 0
# run: $fields 3 9
# run: $fields 18446744073709551615 4294967295

# Not promoted: the address is passed to a call (escapes), an alloc
# outside the entry block (fresh every time round the loop), two widths
# at one offset, and a word stored into the high half of a long (both
# overlaps). The results must not change either.
function l $peek(l %p) {
@start
	%v =l loadl %p
	ret %v
}
export function l $kept(l %a) {
@start
	%e =l alloc8 8
	%o =l alloc8 8
	storel %a, %e
	storel %a, %o
	%lo =w loaduw %o
	%lo1 =l extuw %lo
	%h =l alloc8 8
	storel %a, %h
	%h4 =l add %h, 4
	storew 7, %h4
	%hv =l loadl %h
	%v =l call $peek(l %e)
	jmp @loop
@loop
	%i =w phi @start 0, @loop %i1
	%acc =l phi @start 0, @loop %acc1
	%n =l alloc4 4
	storew %i, %n
	%nv =w loadsw %n
	%nv1 =l extsw %nv
	%acc1 =l add %acc, %nv1
	%i1 =w add %i, 1
	%c =w csltw %i1, 3
	jnz %c, @loop, @done
@done
	%r0 =l add %v, %lo1
	%r1 =l add %r0, %acc1
	%r =l add %r1, %hv
	ret %r
}
# a + (a mod 2^32) + (0 + 1 + 2) + (a mod 2^32 + 7 * 2^32):
# run: $kept 10
# run: $kept 4294967297

# Early return from a block the slot is stored in, and a store in a
# block nothing reaches.
export function w $early(w %a) {
@start
	%s =l alloc4 4
	storew 1, %s
	%c =w ceqw %a, 0
	jnz %c, @zero, @more
@zero
	%z =w loadsw %s
	ret %z
@dead
	storew 99, %s
	jmp @more
@more
	%v =w loadsw %s
	%v2 =w add %v, %a
	storew %v2, %s
	%r =w loadsw %s
	ret %r
}
# run: $early 0
# run: $early 41
