# Copy chains, including a block listed before its defining predecessor.
function l $weighted(l %a, l %b) {
@start
	%x =l mul %a, 7
	%r =l sub %x, %b
	ret %r
}
export function l $chain(l %x) {
@start
	%a =l copy %x
	%one =l copy 1
	jmp @first
@last
	%c =l copy %b
	%r =l call $weighted(l %c, l %one)
	%out =l copy %r
	ret %out
@first
	%b =l copy %a
	jmp @last
}
# run: $chain 0
# run: $chain 13
# run: $chain 18446744073709551615

# Copy constants are class-width bit patterns, not unbounded integers.
# Keep the l -> w copy and both signed/unsigned extensions.
export function l $narrow(l %x) {
@start
	%a =l copy %x
	%b =w copy %a
	%c =w copy %b
	%s =l extsw %c
	%u =l extuw %c
	%neg =w copy -1
	%n =l extuw %neg
	%big =w copy 4294967297
	%bigl =l extuw %big
	%d =l sub %s, %u
	%e =l add %d, %n
	%r =l add %e, %bigl
	ret %r
}
# run: $narrow 4294967296
# run: $narrow 6442450944
# run: $narrow 18446744073709551615

# Long constants must not be truncated as though the copy were a word.
export function l $constants() {
@start
	%a =l copy 4294967297
	%b =l copy -2
	%c =l copy %a
	%r =l sub %c, %b
	ret %r
}
# run: $constants

# Back-edge copies feed simultaneous phis; a sequential phi update is wrong.
export function l $swap(w %n) {
@start
	%a0 =l copy 3
	%b0 =l copy 11
	%i0 =w copy 0
	jmp @head
@head
	%a =l phi @start %a0, @body %nexta
	%b =l phi @start %b0, @body %nextb
	%i =w phi @start %i0, @body %nexti
	%test =w csltw %i, %n
	%cond =w copy %test
	jnz %cond, @body, @done
@body
	%nexta =l copy %b
	%nextb =l copy %a
	%i1 =w add %i, 1
	%nexti =w copy %i1
	jmp @head
@done
	%aa =l copy %a
	%bb =l copy %b
	%r =l call $weighted(l %aa, l %bb)
	ret %r
}
# run: $swap 0
# run: $swap 1
# run: $swap 2
# run: $swap 7

# Loads, stores and calls remain in order, even when their results alias.
function l $bump(l %p) {
@start
	%x =l loadl %p
	%y =l add %x, 5
	storel %y, %p
	ret %y
}
export function l $effects(l %x) {
@start
	%p =l alloc8 8
	%q =l copy %p
	%v =l copy %x
	storel %v, %q
	%before =l loadl %q
	%a =l copy %before
	%b =l call $bump(l %q)
	%c =l copy %b
	%after =l loadl %p
	%d =l copy %after
	%r0 =l call $weighted(l %a, l %c)
	%r =l sub %r0, %d
	ret %r
}
# run: $effects 9
# run: $effects 18446744073709551615

# Non-SSA: copying the old value is not an alias of the new definition.
export function l $redefined(l %x) {
@start
	%a =l copy %x
	%old =l copy %a
	%a =l add %a, 17
	%r =l sub %old, %a
	ret %r
}
# run: $redefined 4

# Dead cycles must not be chased. Dead uses still need definitions after
# live copies disappear; dead predecessors must stay on successor phis.
export function l $unreachable(l %x) {
@start
	%a =l copy %x
	jmp @join
@dead
	%cycle1 =l copy %cycle2
	%cycle2 =l copy %cycle1
	%deaduse =l copy %a
	jmp @join
@join
	%p =l phi @start %a, @dead %deaduse
	%r =l copy %p
	ret %r
}
# run: $unreachable 29

# Plain global addresses also remain materialized, not treated as integers.
data $cell = { l 37 }
export function l $global() {
@start
	%p =l copy $cell
	%q =l copy %p
	%v =l loadl %q
	ret %v
}
# run: $global
