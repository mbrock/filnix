% Copy chains, including a block listed before its defining predecessor.
func(weighted, local, l, [par(l, t(a)), par(l, t(b))], [
    blk(start, [], [
        ins(t(x), l, mul, [t(a), c(7)]),
        ins(t(r), l, sub, [t(x), t(b)])
    ], ret(t(r)))
]).
func(chain, export, l, [par(l, t(x))], [
    blk(start, [], [
        ins(t(a), l, copy, [t(x)]),
        ins(t(one), l, copy, [c(1)])
    ], jmp(first)),
    blk(last, [], [
        ins(t(c), l, copy, [t(b)]),
        call(to(t(r), l), glo(weighted), [arg(l, t(c)), arg(l, t(one))]),
        ins(t(out), l, copy, [t(r)])
    ], ret(t(out))),
    blk(first, [], [
        ins(t(b), l, copy, [t(a)])
    ], jmp(last))
]).
run(chain, [0]).
run(chain, [13]).
run(chain, [18446744073709551615]).

% Copy constants are class-width bit patterns, not unbounded integers.
% Keep the l -> w copy and both signed/unsigned extensions.
func(narrow, export, l, [par(l, t(x))], [
    blk(start, [], [
        ins(t(a), l, copy, [t(x)]),
        ins(t(b), w, copy, [t(a)]),
        ins(t(c), w, copy, [t(b)]),
        ins(t(s), l, ext(sw), [t(c)]),
        ins(t(u), l, ext(uw), [t(c)]),
        ins(t(neg), w, copy, [c(-1)]),
        ins(t(n), l, ext(uw), [t(neg)]),
        ins(t(big), w, copy, [c(4294967297)]),
        ins(t(bigl), l, ext(uw), [t(big)]),
        ins(t(d), l, sub, [t(s), t(u)]),
        ins(t(e), l, add, [t(d), t(n)]),
        ins(t(r), l, add, [t(e), t(bigl)])
    ], ret(t(r)))
]).
run(narrow, [4294967296]).
run(narrow, [6442450944]).
run(narrow, [18446744073709551615]).

% Long constants must not be truncated as though the copy were a word.
func(constants, export, l, [], [
    blk(start, [], [
        ins(t(a), l, copy, [c(4294967297)]),
        ins(t(b), l, copy, [c(-2)]),
        ins(t(c), l, copy, [t(a)]),
        ins(t(r), l, sub, [t(c), t(b)])
    ], ret(t(r)))
]).
run(constants, []).

% Back-edge copies feed simultaneous phis; a sequential phi update is wrong.
func(swap, export, l, [par(w, t(n))], [
    blk(start, [], [
        ins(t(a0), l, copy, [c(3)]),
        ins(t(b0), l, copy, [c(11)]),
        ins(t(i0), w, copy, [c(0)])
    ], jmp(head)),
    blk(head, [
        phi(t(a), l, [start-t(a0), body-t(nexta)]),
        phi(t(b), l, [start-t(b0), body-t(nextb)]),
        phi(t(i), w, [start-t(i0), body-t(nexti)])
    ], [
        ins(t(test), w, cmp(slt, w), [t(i), t(n)]),
        ins(t(cond), w, copy, [t(test)])
    ], jnz(t(cond), body, done)),
    blk(body, [], [
        ins(t(nexta), l, copy, [t(b)]),
        ins(t(nextb), l, copy, [t(a)]),
        ins(t(i1), w, add, [t(i), c(1)]),
        ins(t(nexti), w, copy, [t(i1)])
    ], jmp(head)),
    blk(done, [], [
        ins(t(aa), l, copy, [t(a)]),
        ins(t(bb), l, copy, [t(b)]),
        call(to(t(r), l), glo(weighted), [arg(l, t(aa)), arg(l, t(bb))])
    ], ret(t(r)))
]).
run(swap, [0]).
run(swap, [1]).
run(swap, [2]).
run(swap, [7]).

% Loads, stores and calls remain in order, even when their results alias.
func(bump, local, l, [par(l, t(p))], [
    blk(start, [], [
        ins(t(x), l, load(l), [t(p)]),
        ins(t(y), l, add, [t(x), c(5)]),
        store(l, t(y), t(p))
    ], ret(t(y)))
]).
func(effects, export, l, [par(l, t(x))], [
    blk(start, [], [
        ins(t(p), l, alloc(8), [c(8)]),
        ins(t(q), l, copy, [t(p)]),
        ins(t(v), l, copy, [t(x)]),
        store(l, t(v), t(q)),
        ins(t(before), l, load(l), [t(q)]),
        ins(t(a), l, copy, [t(before)]),
        call(to(t(b), l), glo(bump), [arg(l, t(q))]),
        ins(t(c), l, copy, [t(b)]),
        ins(t(after), l, load(l), [t(p)]),
        ins(t(d), l, copy, [t(after)]),
        call(to(t(r0), l), glo(weighted), [arg(l, t(a)), arg(l, t(c))]),
        ins(t(r), l, sub, [t(r0), t(d)])
    ], ret(t(r)))
]).
run(effects, [9]).
run(effects, [18446744073709551615]).

% Non-SSA: copying the old value is not an alias of the new definition.
func(redefined, export, l, [par(l, t(x))], [
    blk(start, [], [
        ins(t(a), l, copy, [t(x)]),
        ins(t(old), l, copy, [t(a)]),
        ins(t(a), l, add, [t(a), c(17)]),
        ins(t(r), l, sub, [t(old), t(a)])
    ], ret(t(r)))
]).
run(redefined, [4]).

% Dead cycles must not be chased. Dead uses still need definitions after
% live copies disappear; dead predecessors must stay on successor phis.
func(unreachable, export, l, [par(l, t(x))], [
    blk(start, [], [
        ins(t(a), l, copy, [t(x)])
    ], jmp(join)),
    blk(dead, [], [
        ins(t(cycle1), l, copy, [t(cycle2)]),
        ins(t(cycle2), l, copy, [t(cycle1)]),
        ins(t(deaduse), l, copy, [t(a)])
    ], jmp(join)),
    blk(join, [
        phi(t(p), l, [start-t(a), dead-t(deaduse)])
    ], [
        ins(t(r), l, copy, [t(p)])
    ], ret(t(r)))
]).
run(unreachable, [29]).

% Plain global addresses also remain materialized, not treated as integers.
data(cell, local, 8, [item(l, c(37))]).
func(global, export, l, [], [
    blk(start, [], [
        ins(t(p), l, copy, [glo(cell)]),
        ins(t(q), l, copy, [t(p)]),
        ins(t(v), l, load(l), [t(q)])
    ], ret(t(v)))
]).
run(global, []).

% a first aliases z, then z becomes x; b must be revisited after both.
% Block order is not dominance order, and the loop has self inputs.
func(invariant, export, l, [par(l, t(x)), par(w, t(n))], [
    blk(start, [], [
        ins(t(seed), l, copy, [t(x)])
    ], jmp(head)),
    blk(body, [
        phi(t(a), l, [head-t(z)])
    ], [
        ins(t(back), l, copy, [t(a)]),
        ins(t(i1), w, add, [t(i), c(1)])
    ], jmp(head)),
    blk(head, [
        phi(t(b), l, [start-t(seed), body-t(back)]),
        phi(t(z), l, [start-t(seed), body-t(z)]),
        phi(t(i), w, [start-c(0), body-t(i1)])
    ], [
        ins(t(c), w, cmp(slt, w), [t(i), t(n)])
    ], jnz(t(c), body, done)),
    blk(done, [], [
        ins(t(r), l, sub, [t(b), t(z)]),
        ins(t(out), l, add, [t(r), t(x)])
    ], ret(t(out)))
]).
run(invariant, [23, 0]).
run(invariant, [31, 5]).
run(invariant, [18446744073709551615, 3]).

% Equal bit patterns normalize at the phi's width before comparison.
func(phi_constants, export, l, [par(w, t(which))], [
    blk(start, [], [], jnz(t(which), left, right)),
    blk(left, [], [], jmp(join)),
    blk(right, [], [], jmp(join)),
    blk(join, [
        phi(t(w), w, [left-c(-1), right-c(4294967295)]),
        phi(t(l), l, [left-c(4294967297), right-c(4294967297)])
    ], [
        ins(t(u), l, ext(uw), [t(w)]),
        ins(t(r), l, sub, [t(l), t(u)])
    ], ret(t(r)))
]).
run(phi_constants, [0]).
run(phi_constants, [1]).

% A w phi of l temps narrows: it cannot simply alias the input.
func(phi_narrow, export, l, [par(l, t(x)), par(w, t(which))], [
    blk(start, [], [], jnz(t(which), left, right)),
    blk(left, [], [], jmp(join)),
    blk(right, [], [], jmp(join)),
    blk(join, [
        phi(t(w), w, [left-t(x), right-t(x)])
    ], [
        ins(t(u), l, ext(uw), [t(w)])
    ], ret(t(u)))
]).
run(phi_narrow, [4294967303, 0]).
run(phi_narrow, [18446744073709551615, 1]).

% All incoming edges count, even dead ones. Dead uses of a removed phi
% still need rewriting; the all-self dead phi must not be eliminated.
func(phi_dead_edges, export, l, [par(l, t(x))], [
    blk(start, [], [], jmp(join)),
    blk(dead, [
        phi(t(self), l, [dead-t(self)])
    ], [
        ins(t(use), l, add, [t(same), c(1)])
    ], jnz(c(0), dead, join)),
    blk(join, [
        phi(t(same), l, [start-t(x), dead-t(x)]),
        phi(t(different), l, [start-t(x), dead-t(use)])
    ], [
        ins(t(r), l, add, [t(same), t(different)])
    ], ret(t(r)))
]).
run(phi_dead_edges, [19]).
