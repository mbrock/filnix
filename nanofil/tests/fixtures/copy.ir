% Copy chains, including a block listed before its defining predecessor.
func(weighted, local, l, [param(l, tmp(a)), param(l, tmp(b))], [
    block(start, [], [
        let(tmp(x), l, mul, [tmp(a), const(7)]),
        let(tmp(r), l, sub, [tmp(x), tmp(b)])
    ], ret(tmp(r)))
]).
func(chain, export, l, [param(l, tmp(x))], [
    block(start, [], [
        let(tmp(a), l, copy, [tmp(x)]),
        let(tmp(one), l, copy, [const(1)])
    ], goto(first)),
    block(last, [], [
        let(tmp(c), l, copy, [tmp(b)]),
        call(result(tmp(r), l), global(weighted), [arg(l, tmp(c)), arg(l, tmp(one))]),
        let(tmp(out), l, copy, [tmp(r)])
    ], ret(tmp(out))),
    block(first, [], [
        let(tmp(b), l, copy, [tmp(a)])
    ], goto(last))
]).
run(chain, [0]).
run(chain, [13]).
run(chain, [18446744073709551615]).

% Copy constants are class-width bit patterns, not unbounded integers.
% Keep the l -> w copy and both signed/unsigned extensions.
func(narrow, export, l, [param(l, tmp(x))], [
    block(start, [], [
        let(tmp(a), l, copy, [tmp(x)]),
        let(tmp(b), w, copy, [tmp(a)]),
        let(tmp(c), w, copy, [tmp(b)]),
        let(tmp(s), l, ext(sw), [tmp(c)]),
        let(tmp(u), l, ext(uw), [tmp(c)]),
        let(tmp(neg), w, copy, [const(-1)]),
        let(tmp(n), l, ext(uw), [tmp(neg)]),
        let(tmp(big), w, copy, [const(4294967297)]),
        let(tmp(bigl), l, ext(uw), [tmp(big)]),
        let(tmp(d), l, sub, [tmp(s), tmp(u)]),
        let(tmp(e), l, add, [tmp(d), tmp(n)]),
        let(tmp(r), l, add, [tmp(e), tmp(bigl)])
    ], ret(tmp(r)))
]).
run(narrow, [4294967296]).
run(narrow, [6442450944]).
run(narrow, [18446744073709551615]).

% Long constants must not be truncated as though the copy were a word.
func(constants, export, l, [], [
    block(start, [], [
        let(tmp(a), l, copy, [const(4294967297)]),
        let(tmp(b), l, copy, [const(-2)]),
        let(tmp(c), l, copy, [tmp(a)]),
        let(tmp(r), l, sub, [tmp(c), tmp(b)])
    ], ret(tmp(r)))
]).
run(constants, []).

% Back-edge copies feed simultaneous phis; a sequential phi update is wrong.
func(swap, export, l, [param(w, tmp(n))], [
    block(start, [], [
        let(tmp(a0), l, copy, [const(3)]),
        let(tmp(b0), l, copy, [const(11)]),
        let(tmp(i0), w, copy, [const(0)])
    ], goto(head)),
    block(head, [
        phi(tmp(a), l, [start-tmp(a0), body-tmp(nexta)]),
        phi(tmp(b), l, [start-tmp(b0), body-tmp(nextb)]),
        phi(tmp(i), w, [start-tmp(i0), body-tmp(nexti)])
    ], [
        let(tmp(test), w, cmp(slt, w), [tmp(i), tmp(n)]),
        let(tmp(cond), w, copy, [tmp(test)])
    ], branch(tmp(cond), body, done)),
    block(body, [], [
        let(tmp(nexta), l, copy, [tmp(b)]),
        let(tmp(nextb), l, copy, [tmp(a)]),
        let(tmp(i1), w, add, [tmp(i), const(1)]),
        let(tmp(nexti), w, copy, [tmp(i1)])
    ], goto(head)),
    block(done, [], [
        let(tmp(aa), l, copy, [tmp(a)]),
        let(tmp(bb), l, copy, [tmp(b)]),
        call(result(tmp(r), l), global(weighted), [arg(l, tmp(aa)), arg(l, tmp(bb))])
    ], ret(tmp(r)))
]).
run(swap, [0]).
run(swap, [1]).
run(swap, [2]).
run(swap, [7]).

% Loads, stores and calls remain in order, even when their results alias.
func(bump, local, l, [param(l, tmp(p))], [
    block(start, [], [
        let(tmp(x), l, load(l), [tmp(p)]),
        let(tmp(y), l, add, [tmp(x), const(5)]),
        store(l, tmp(y), tmp(p))
    ], ret(tmp(y)))
]).
func(effects, export, l, [param(l, tmp(x))], [
    block(start, [], [
        let(tmp(p), l, alloc(8), [const(8)]),
        let(tmp(q), l, copy, [tmp(p)]),
        let(tmp(v), l, copy, [tmp(x)]),
        store(l, tmp(v), tmp(q)),
        let(tmp(before), l, load(l), [tmp(q)]),
        let(tmp(a), l, copy, [tmp(before)]),
        call(result(tmp(b), l), global(bump), [arg(l, tmp(q))]),
        let(tmp(c), l, copy, [tmp(b)]),
        let(tmp(after), l, load(l), [tmp(p)]),
        let(tmp(d), l, copy, [tmp(after)]),
        call(result(tmp(r0), l), global(weighted), [arg(l, tmp(a)), arg(l, tmp(c))]),
        let(tmp(r), l, sub, [tmp(r0), tmp(d)])
    ], ret(tmp(r)))
]).
run(effects, [9]).
run(effects, [18446744073709551615]).

% Non-SSA: copying the old value is not an alias of the new definition.
func(redefined, export, l, [param(l, tmp(x))], [
    block(start, [], [
        let(tmp(a), l, copy, [tmp(x)]),
        let(tmp(old), l, copy, [tmp(a)]),
        let(tmp(a), l, add, [tmp(a), const(17)]),
        let(tmp(r), l, sub, [tmp(old), tmp(a)])
    ], ret(tmp(r)))
]).
run(redefined, [4]).

% Dead cycles must not be chased. Dead uses still need definitions after
% live copies disappear; dead predecessors must stay on successor phis.
func(unreachable, export, l, [param(l, tmp(x))], [
    block(start, [], [
        let(tmp(a), l, copy, [tmp(x)])
    ], goto(join)),
    block(dead, [], [
        let(tmp(cycle1), l, copy, [tmp(cycle2)]),
        let(tmp(cycle2), l, copy, [tmp(cycle1)]),
        let(tmp(deaduse), l, copy, [tmp(a)])
    ], goto(join)),
    block(join, [
        phi(tmp(p), l, [start-tmp(a), dead-tmp(deaduse)])
    ], [
        let(tmp(r), l, copy, [tmp(p)])
    ], ret(tmp(r)))
]).
run(unreachable, [29]).

% Plain global addresses also remain materialized, not treated as integers.
data(cell, local, 8, [item(l, const(37))]).
func(global, export, l, [], [
    block(start, [], [
        let(tmp(p), l, copy, [global(cell)]),
        let(tmp(q), l, copy, [tmp(p)]),
        let(tmp(v), l, load(l), [tmp(q)])
    ], ret(tmp(v)))
]).
run(global, []).

% a first aliases z, then z becomes x; b must be revisited after both.
% Block order is not dominance order, and the loop has self inputs.
func(invariant, export, l, [param(l, tmp(x)), param(w, tmp(n))], [
    block(start, [], [
        let(tmp(seed), l, copy, [tmp(x)])
    ], goto(head)),
    block(body, [
        phi(tmp(a), l, [head-tmp(z)])
    ], [
        let(tmp(back), l, copy, [tmp(a)]),
        let(tmp(i1), w, add, [tmp(i), const(1)])
    ], goto(head)),
    block(head, [
        phi(tmp(b), l, [start-tmp(seed), body-tmp(back)]),
        phi(tmp(z), l, [start-tmp(seed), body-tmp(z)]),
        phi(tmp(i), w, [start-const(0), body-tmp(i1)])
    ], [
        let(tmp(c), w, cmp(slt, w), [tmp(i), tmp(n)])
    ], branch(tmp(c), body, done)),
    block(done, [], [
        let(tmp(r), l, sub, [tmp(b), tmp(z)]),
        let(tmp(out), l, add, [tmp(r), tmp(x)])
    ], ret(tmp(out)))
]).
run(invariant, [23, 0]).
run(invariant, [31, 5]).
run(invariant, [18446744073709551615, 3]).

% Equal bit patterns normalize at the phi's width before comparison.
func(phi_constants, export, l, [param(w, tmp(which))], [
    block(start, [], [], branch(tmp(which), left, right)),
    block(left, [], [], goto(join)),
    block(right, [], [], goto(join)),
    block(join, [
        phi(tmp(w), w, [left-const(-1), right-const(4294967295)]),
        phi(tmp(l), l, [left-const(4294967297), right-const(4294967297)])
    ], [
        let(tmp(u), l, ext(uw), [tmp(w)]),
        let(tmp(r), l, sub, [tmp(l), tmp(u)])
    ], ret(tmp(r)))
]).
run(phi_constants, [0]).
run(phi_constants, [1]).

% A w phi of l temps narrows: it cannot simply alias the input.
func(phi_narrow, export, l, [param(l, tmp(x)), param(w, tmp(which))], [
    block(start, [], [], branch(tmp(which), left, right)),
    block(left, [], [], goto(join)),
    block(right, [], [], goto(join)),
    block(join, [
        phi(tmp(w), w, [left-tmp(x), right-tmp(x)])
    ], [
        let(tmp(u), l, ext(uw), [tmp(w)])
    ], ret(tmp(u)))
]).
run(phi_narrow, [4294967303, 0]).
run(phi_narrow, [18446744073709551615, 1]).

% All incoming edges count, even dead ones. Dead uses of a removed phi
% still need rewriting; the all-self dead phi must not be eliminated.
func(phi_dead_edges, export, l, [param(l, tmp(x))], [
    block(start, [], [], goto(join)),
    block(dead, [
        phi(tmp(self), l, [dead-tmp(self)])
    ], [
        let(tmp(use), l, add, [tmp(same), const(1)])
    ], branch(const(0), dead, join)),
    block(join, [
        phi(tmp(same), l, [start-tmp(x), dead-tmp(x)]),
        phi(tmp(different), l, [start-tmp(x), dead-tmp(use)])
    ], [
        let(tmp(r), l, add, [tmp(same), tmp(different)])
    ], ret(tmp(r)))
]).
run(phi_dead_edges, [19]).
