% Calls using all six argument registers, mixed classes, and results
% consumed at a narrower class.

% Weights make every argument's position visible in the result.
func(six, local, l, [param(w, tmp(a)), param(l, tmp(b)), param(w, tmp(c)), param(l, tmp(d)), param(w, tmp(e)), param(l, tmp(f))], [
    block(start, [], [
        let(tmp(x), l, ext(uw), [tmp(a)]),
        let(tmp(y), l, mul, [tmp(b), const(10)]),
        let(tmp(s1), l, add, [tmp(x), tmp(y)]),
        let(tmp(c1), l, ext(uw), [tmp(c)]),
        let(tmp(c2), l, mul, [tmp(c1), const(100)]),
        let(tmp(s2), l, add, [tmp(s1), tmp(c2)]),
        let(tmp(d1), l, mul, [tmp(d), const(1000)]),
        let(tmp(s3), l, add, [tmp(s2), tmp(d1)]),
        let(tmp(e1), l, ext(uw), [tmp(e)]),
        let(tmp(e2), l, mul, [tmp(e1), const(10000)]),
        let(tmp(s4), l, add, [tmp(s3), tmp(e2)]),
        let(tmp(f1), l, mul, [tmp(f), const(100000)]),
        let(tmp(s5), l, add, [tmp(s4), tmp(f1)])
    ], ret(tmp(s5)))
]).

run(calls6, [1, 2, 3, 4, 5, 6]).
run(calls6, [0, 0, 0, 0, 0, 1]).
run(calls6, [4294967295, -1, 4294967295, -1, 4294967295, -1]).
func(calls6, export, l, [param(w, tmp(a)), param(l, tmp(b)), param(w, tmp(c)), param(l, tmp(d)), param(w, tmp(e)), param(l, tmp(f))], [
    block(start, [], [
        call(result(tmp(r), l), global(six), [arg(w, tmp(a)), arg(l, tmp(b)), arg(w, tmp(c)), arg(l, tmp(d)), arg(w, tmp(e)), arg(l, tmp(f))])
    ], ret(tmp(r)))
]).

% The callee returns l; the caller reads its low word.
run(narrow, [1, 2, 3, 4, 5, 6]).
func(narrow, export, w, [param(w, tmp(a)), param(l, tmp(b)), param(w, tmp(c)), param(l, tmp(d)), param(w, tmp(e)), param(l, tmp(f))], [
    block(start, [], [
        call(result(tmp(r), w), global(six), [arg(w, tmp(e)), arg(l, tmp(f)), arg(w, tmp(a)), arg(l, tmp(b)), arg(w, tmp(c)), arg(l, tmp(d))])
    ], ret(tmp(r)))
]).

% Arguments that are constants, a global address, and values that must
% survive a call in their slots.
data(k, local, 8, [item(l, const(7))]).

func(deref, local, l, [param(l, tmp(p)), param(w, tmp(n))], [
    block(start, [], [
        let(tmp(v), l, load(l), [tmp(p)]),
        let(tmp(m), l, ext(uw), [tmp(n)]),
        let(tmp(r), l, add, [tmp(v), tmp(m)])
    ], ret(tmp(r)))
]).

run(around, [5]).
func(around, export, l, [param(l, tmp(x))], [
    block(start, [], [
        let(tmp(a), l, add, [tmp(x), const(1)]),
        call(result(tmp(r1), l), global(deref), [arg(l, global(k)), arg(w, const(4294967295))]),
        call(result(tmp(r2), l), global(six), [arg(w, const(1)), arg(l, tmp(a)), arg(w, const(0)), arg(l, const(0)), arg(w, const(0)), arg(l, const(-1))]),
        let(tmp(s), l, add, [tmp(r1), tmp(r2)]),
        let(tmp(t), l, add, [tmp(s), tmp(a)])
    ], ret(tmp(t)))
]).
