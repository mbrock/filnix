% Stack slots in the shapes promote handles (docs/m5.md) and the ones it
% must leave alone, in plain mode so the plain backend compiles both versions.

% A counter and an accumulator in slots, across a loop.
func(loop, export, l, [param(w, tmp(n))], [
    block(start, [], [
        let(tmp(i), l, alloc(4), [const(4)]),
        let(tmp(acc), l, alloc(8), [const(8)]),
        store(w, const(0), tmp(i)),
        store(l, const(1), tmp(acc))
    ], goto(head)),
    block(head, [], [
        let(tmp(iv), w, load(sw), [tmp(i)]),
        let(tmp(c), w, cmp(slt, w), [tmp(iv), tmp(n)])
    ], branch(tmp(c), body, done)),
    block(body, [], [
        let(tmp(a), l, load(l), [tmp(acc)]),
        let(tmp(iv2), w, load(sw), [tmp(i)]),
        let(tmp(x), l, ext(sw), [tmp(iv2)]),
        let(tmp(a2), l, add, [tmp(a), tmp(x)]),
        let(tmp(a3), l, mul, [tmp(a2), const(3)]),
        store(l, tmp(a3), tmp(acc)),
        let(tmp(iv3), w, add, [tmp(iv2), const(1)]),
        store(w, tmp(iv3), tmp(i))
    ], goto(head)),
    block(done, [], [
        let(tmp(r), l, load(l), [tmp(acc)])
    ], ret(tmp(r)))
]).
run(loop, [0]).
run(loop, [5]).
run(loop, [40]).

% A diamond that stores on one side only, so the join needs a phi.
func(diamond, export, w, [param(w, tmp(a)), param(w, tmp(b))], [
    block(start, [], [
        let(tmp(s), l, alloc(4), [const(4)]),
        store(w, tmp(a), tmp(s))
    ], branch(tmp(b), then, join)),
    block(then, [], [
        let(tmp(v), w, load(sw), [tmp(s)]),
        let(tmp(v2), w, mul, [tmp(v), tmp(b)]),
        store(w, tmp(v2), tmp(s))
    ], goto(join)),
    block(join, [], [
        let(tmp(r), w, load(uw), [tmp(s)])
    ], ret(tmp(r)))
]).
run(diamond, [7, 0]).
run(diamond, [7, 6]).
run(diamond, [4294967295, 2]).

% Narrow slots: the load extends the stored value again. (Reading a w
% slot at l both ways is tests/backend/load-ext-l.ir: qbe gets it wrong.)
func(narrow, export, l, [param(w, tmp(a))], [
    block(start, [], [
        let(tmp(b), l, alloc(4), [const(1)]),
        let(tmp(h), l, alloc(4), [const(2)]),
        let(tmp(w), l, alloc(4), [const(4)]),
        store(b, tmp(a), tmp(b)),
        store(h, tmp(a), tmp(h)),
        store(w, tmp(a), tmp(w)),
        let(tmp(x), w, load(sb), [tmp(b)]),
        let(tmp(y), w, load(ub), [tmp(b)]),
        let(tmp(z), l, load(sh), [tmp(h)]),
        let(tmp(u), l, load(uh), [tmp(h)]),
        let(tmp(s), w, load(sw), [tmp(w)]),
        let(tmp(t), w, load(uw), [tmp(w)]),
        let(tmp(x1), l, ext(sw), [tmp(x)]),
        let(tmp(y1), l, ext(sw), [tmp(y)]),
        let(tmp(p), l, add, [tmp(x1), tmp(y1)]),
        let(tmp(q), l, xor, [tmp(z), tmp(u)]),
        let(tmp(r0), l, add, [tmp(p), tmp(q)]),
        let(tmp(r1w), w, sub, [tmp(s), tmp(t)]),
        let(tmp(r1), l, ext(sw), [tmp(r1w)]),
        let(tmp(r), l, add, [tmp(r0), tmp(r1)])
    ], ret(tmp(r)))
]).
run(narrow, [0]).
run(narrow, [127]).
run(narrow, [128]).
run(narrow, [65535]).
run(narrow, [4294967295]).
run(narrow, [2147516544]).

% A two-field struct at constant offsets: two slots of one alloc.
func(fields, export, l, [param(l, tmp(a)), param(w, tmp(b))], [
    block(start, [], [
        let(tmp(s), l, alloc(8), [const(16)]),
        let(tmp(f), l, add, [tmp(s), const(8)]),
        let(tmp(g), l, add, [tmp(f), const(4)]),
        store(l, tmp(a), tmp(s)),
        store(w, tmp(b), tmp(f)),
        store(w, const(5), tmp(g))
    ], branch(tmp(b), swap, out)),
    block(swap, [], [
        let(tmp(x), l, load(l), [tmp(s)]),
        let(tmp(y), w, load(sw), [tmp(f)]),
        let(tmp(y1), l, ext(sw), [tmp(y)]),
        store(l, tmp(y1), tmp(s)),
        store(w, tmp(x), tmp(f))
    ], goto(out)),
    block(out, [], [
        let(tmp(p), l, load(l), [tmp(s)]),
        let(tmp(q), w, load(uw), [tmp(f)]),
        let(tmp(q1), l, ext(uw), [tmp(q)]),
        let(tmp(k), w, load(uw), [tmp(g)]),
        let(tmp(k1), l, ext(uw), [tmp(k)]),
        let(tmp(r0), l, mul, [tmp(p), const(1000)]),
        let(tmp(r1), l, add, [tmp(r0), tmp(q1)]),
        let(tmp(r), l, add, [tmp(r1), tmp(k1)])
    ], ret(tmp(r)))
]).
run(fields, [3, 0]).
run(fields, [3, 9]).
run(fields, [18446744073709551615, 4294967295]).

% Not promoted: the address is passed to a call (escapes), an alloc
% outside the entry block (fresh every time round the loop), two widths
% at one offset, and a word stored into the high half of a long (both
% overlaps). The results must not change either.
func(peek, local, l, [param(l, tmp(p))], [
    block(start, [], [
        let(tmp(v), l, load(l), [tmp(p)])
    ], ret(tmp(v)))
]).
func(kept, export, l, [param(l, tmp(a))], [
    block(start, [], [
        let(tmp(e), l, alloc(8), [const(8)]),
        let(tmp(o), l, alloc(8), [const(8)]),
        store(l, tmp(a), tmp(e)),
        store(l, tmp(a), tmp(o)),
        let(tmp(lo), w, load(uw), [tmp(o)]),
        let(tmp(lo1), l, ext(uw), [tmp(lo)]),
        let(tmp(h), l, alloc(8), [const(8)]),
        store(l, tmp(a), tmp(h)),
        let(tmp(h4), l, add, [tmp(h), const(4)]),
        store(w, const(7), tmp(h4)),
        let(tmp(hv), l, load(l), [tmp(h)]),
        call(result(tmp(v), l), global(peek), [arg(l, tmp(e))])
    ], goto(loop)),
    block(loop, [
        phi(tmp(i), w, [start-const(0), loop-tmp(i1)]),
        phi(tmp(acc), l, [start-const(0), loop-tmp(acc1)])
    ], [
        let(tmp(n), l, alloc(4), [const(4)]),
        store(w, tmp(i), tmp(n)),
        let(tmp(nv), w, load(sw), [tmp(n)]),
        let(tmp(nv1), l, ext(sw), [tmp(nv)]),
        let(tmp(acc1), l, add, [tmp(acc), tmp(nv1)]),
        let(tmp(i1), w, add, [tmp(i), const(1)]),
        let(tmp(c), w, cmp(slt, w), [tmp(i1), const(3)])
    ], branch(tmp(c), loop, done)),
    block(done, [], [
        let(tmp(r0), l, add, [tmp(v), tmp(lo1)]),
        let(tmp(r1), l, add, [tmp(r0), tmp(acc1)]),
        let(tmp(r), l, add, [tmp(r1), tmp(hv)])
    ], ret(tmp(r)))
]).
% a + (a mod 2^32) + (0 + 1 + 2) + (a mod 2^32 + 7 * 2^32):
run(kept, [10]).
run(kept, [4294967297]).

% Early return from a block the slot is stored in, and a store in a
% block nothing reaches.
func(early, export, w, [param(w, tmp(a))], [
    block(start, [], [
        let(tmp(s), l, alloc(4), [const(4)]),
        store(w, const(1), tmp(s)),
        let(tmp(c), w, cmp(eq, w), [tmp(a), const(0)])
    ], branch(tmp(c), zero, more)),
    block(zero, [], [
        let(tmp(z), w, load(sw), [tmp(s)])
    ], ret(tmp(z))),
    block(dead, [], [
        store(w, const(99), tmp(s))
    ], goto(more)),
    block(more, [], [
        let(tmp(v), w, load(sw), [tmp(s)]),
        let(tmp(v2), w, add, [tmp(v), tmp(a)]),
        store(w, tmp(v2), tmp(s)),
        let(tmp(r), w, load(sw), [tmp(s)])
    ], ret(tmp(r)))
]).
run(early, [0]).
run(early, [41]).
