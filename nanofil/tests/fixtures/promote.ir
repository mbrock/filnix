% Stack slots in the shapes promote handles (docs/m5.md) and the ones it
% must leave alone, in plain mode so the plain backend compiles both versions.

% A counter and an accumulator in slots, across a loop.
func(loop, export, l, [par(w, t(n))], [
    blk(start, [], [
        ins(t(i), l, alloc(4), [c(4)]),
        ins(t(acc), l, alloc(8), [c(8)]),
        store(w, c(0), t(i)),
        store(l, c(1), t(acc))
    ], jmp(head)),
    blk(head, [], [
        ins(t(iv), w, load(sw), [t(i)]),
        ins(t(c), w, cmp(slt, w), [t(iv), t(n)])
    ], jnz(t(c), body, done)),
    blk(body, [], [
        ins(t(a), l, load(l), [t(acc)]),
        ins(t(iv2), w, load(sw), [t(i)]),
        ins(t(x), l, ext(sw), [t(iv2)]),
        ins(t(a2), l, add, [t(a), t(x)]),
        ins(t(a3), l, mul, [t(a2), c(3)]),
        store(l, t(a3), t(acc)),
        ins(t(iv3), w, add, [t(iv2), c(1)]),
        store(w, t(iv3), t(i))
    ], jmp(head)),
    blk(done, [], [
        ins(t(r), l, load(l), [t(acc)])
    ], ret(t(r)))
]).
run(loop, [0]).
run(loop, [5]).
run(loop, [40]).

% A diamond that stores on one side only, so the join needs a phi.
func(diamond, export, w, [par(w, t(a)), par(w, t(b))], [
    blk(start, [], [
        ins(t(s), l, alloc(4), [c(4)]),
        store(w, t(a), t(s))
    ], jnz(t(b), then, join)),
    blk(then, [], [
        ins(t(v), w, load(sw), [t(s)]),
        ins(t(v2), w, mul, [t(v), t(b)]),
        store(w, t(v2), t(s))
    ], jmp(join)),
    blk(join, [], [
        ins(t(r), w, load(uw), [t(s)])
    ], ret(t(r)))
]).
run(diamond, [7, 0]).
run(diamond, [7, 6]).
run(diamond, [4294967295, 2]).

% Narrow slots: the load extends the stored value again. (Reading a w
% slot at l both ways is tests/backend/load-ext-l.ir: qbe gets it wrong.)
func(narrow, export, l, [par(w, t(a))], [
    blk(start, [], [
        ins(t(b), l, alloc(4), [c(1)]),
        ins(t(h), l, alloc(4), [c(2)]),
        ins(t(w), l, alloc(4), [c(4)]),
        store(b, t(a), t(b)),
        store(h, t(a), t(h)),
        store(w, t(a), t(w)),
        ins(t(x), w, load(sb), [t(b)]),
        ins(t(y), w, load(ub), [t(b)]),
        ins(t(z), l, load(sh), [t(h)]),
        ins(t(u), l, load(uh), [t(h)]),
        ins(t(s), w, load(sw), [t(w)]),
        ins(t(t), w, load(uw), [t(w)]),
        ins(t(x1), l, ext(sw), [t(x)]),
        ins(t(y1), l, ext(sw), [t(y)]),
        ins(t(p), l, add, [t(x1), t(y1)]),
        ins(t(q), l, xor, [t(z), t(u)]),
        ins(t(r0), l, add, [t(p), t(q)]),
        ins(t(r1w), w, sub, [t(s), t(t)]),
        ins(t(r1), l, ext(sw), [t(r1w)]),
        ins(t(r), l, add, [t(r0), t(r1)])
    ], ret(t(r)))
]).
run(narrow, [0]).
run(narrow, [127]).
run(narrow, [128]).
run(narrow, [65535]).
run(narrow, [4294967295]).
run(narrow, [2147516544]).

% A two-field struct at constant offsets: two slots of one alloc.
func(fields, export, l, [par(l, t(a)), par(w, t(b))], [
    blk(start, [], [
        ins(t(s), l, alloc(8), [c(16)]),
        ins(t(f), l, add, [t(s), c(8)]),
        ins(t(g), l, add, [t(f), c(4)]),
        store(l, t(a), t(s)),
        store(w, t(b), t(f)),
        store(w, c(5), t(g))
    ], jnz(t(b), swap, out)),
    blk(swap, [], [
        ins(t(x), l, load(l), [t(s)]),
        ins(t(y), w, load(sw), [t(f)]),
        ins(t(y1), l, ext(sw), [t(y)]),
        store(l, t(y1), t(s)),
        store(w, t(x), t(f))
    ], jmp(out)),
    blk(out, [], [
        ins(t(p), l, load(l), [t(s)]),
        ins(t(q), w, load(uw), [t(f)]),
        ins(t(q1), l, ext(uw), [t(q)]),
        ins(t(k), w, load(uw), [t(g)]),
        ins(t(k1), l, ext(uw), [t(k)]),
        ins(t(r0), l, mul, [t(p), c(1000)]),
        ins(t(r1), l, add, [t(r0), t(q1)]),
        ins(t(r), l, add, [t(r1), t(k1)])
    ], ret(t(r)))
]).
run(fields, [3, 0]).
run(fields, [3, 9]).
run(fields, [18446744073709551615, 4294967295]).

% Not promoted: the address is passed to a call (escapes), an alloc
% outside the entry block (fresh every time round the loop), two widths
% at one offset, and a word stored into the high half of a long (both
% overlaps). The results must not change either.
func(peek, local, l, [par(l, t(p))], [
    blk(start, [], [
        ins(t(v), l, load(l), [t(p)])
    ], ret(t(v)))
]).
func(kept, export, l, [par(l, t(a))], [
    blk(start, [], [
        ins(t(e), l, alloc(8), [c(8)]),
        ins(t(o), l, alloc(8), [c(8)]),
        store(l, t(a), t(e)),
        store(l, t(a), t(o)),
        ins(t(lo), w, load(uw), [t(o)]),
        ins(t(lo1), l, ext(uw), [t(lo)]),
        ins(t(h), l, alloc(8), [c(8)]),
        store(l, t(a), t(h)),
        ins(t(h4), l, add, [t(h), c(4)]),
        store(w, c(7), t(h4)),
        ins(t(hv), l, load(l), [t(h)]),
        call(to(t(v), l), glo(peek), [arg(l, t(e))])
    ], jmp(loop)),
    blk(loop, [
        phi(t(i), w, [start-c(0), loop-t(i1)]),
        phi(t(acc), l, [start-c(0), loop-t(acc1)])
    ], [
        ins(t(n), l, alloc(4), [c(4)]),
        store(w, t(i), t(n)),
        ins(t(nv), w, load(sw), [t(n)]),
        ins(t(nv1), l, ext(sw), [t(nv)]),
        ins(t(acc1), l, add, [t(acc), t(nv1)]),
        ins(t(i1), w, add, [t(i), c(1)]),
        ins(t(c), w, cmp(slt, w), [t(i1), c(3)])
    ], jnz(t(c), loop, done)),
    blk(done, [], [
        ins(t(r0), l, add, [t(v), t(lo1)]),
        ins(t(r1), l, add, [t(r0), t(acc1)]),
        ins(t(r), l, add, [t(r1), t(hv)])
    ], ret(t(r)))
]).
% a + (a mod 2^32) + (0 + 1 + 2) + (a mod 2^32 + 7 * 2^32):
run(kept, [10]).
run(kept, [4294967297]).

% Early return from a block the slot is stored in, and a store in a
% block nothing reaches.
func(early, export, w, [par(w, t(a))], [
    blk(start, [], [
        ins(t(s), l, alloc(4), [c(4)]),
        store(w, c(1), t(s)),
        ins(t(c), w, cmp(eq, w), [t(a), c(0)])
    ], jnz(t(c), zero, more)),
    blk(zero, [], [
        ins(t(z), w, load(sw), [t(s)])
    ], ret(t(z))),
    blk(dead, [], [
        store(w, c(99), t(s))
    ], jmp(more)),
    blk(more, [], [
        ins(t(v), w, load(sw), [t(s)]),
        ins(t(v2), w, add, [t(v), t(a)]),
        store(w, t(v2), t(s)),
        ins(t(r), w, load(sw), [t(s)])
    ], ret(t(r)))
]).
run(early, [0]).
run(early, [41]).
