% qbe c081897 (with filnix's patches) miscompiles this. A w slot read
% back at class l with loadsw and with loaduw must sign- and zero-extend
% the stored word, but qbe's promote turns both loads into the same copy
% of %a, so the difference is 0. Found by nanofil's promote fixture
% (tests/fixtures/promote.ir), whose own promote emits extsw and extuw.
%
%   a = 0xffffffff:  -1 - 4294967295 = -2^32 -> 18446744069414584320
%   qbe:             0
%
run(f, [4294967295]).
func(f, export, l, [par(w, t(a))], [
    blk(start, [], [
        ins(t(w), l, alloc(4), [c(4)]),
        store(w, t(a), t(w)),
        ins(t(s), l, load(sw), [t(w)]),
        ins(t(t), l, load(uw), [t(w)]),
        ins(t(r), l, sub, [t(s), t(t)])
    ], ret(t(r)))
]).
