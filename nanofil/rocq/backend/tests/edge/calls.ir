% Calls and returns the corpus lacks (docs/gallina-backend.md, M3),
% for rocq/backend/tests/emit.sh. Each function makes one call that
% needs a weak thunk: arguments that end at cell 16, 17, 32 and 33; a
% pointer and a float cell at and past cell 32; results in a buffer;
% and float tuples, where a third float word has no xmm register
% left and takes an integer one (result_registers/4). No function
% here returns such a tuple: nanofil takes a tuple return of two
% words only.
func(call_buf_few, export, void, [param(s, tmp(fs)), param(d, tmp(fd)), param(p, tmp(pp)), param(w, tmp(iw)), param(l, tmp(il))], [
    block(start, [], [
        call(tuple([result(tmp(a3), l), result(tmp(b3), p)]), global(buf_few), [arg(p, tmp(pp)), arg(s, tmp(fs)), arg(l, tmp(il)), arg(w, tmp(iw)), arg(l, tmp(il)), arg(s, tmp(fs))])
    ], ret)
]).
func(call_buf_many, export, void, [param(s, tmp(fs)), param(d, tmp(fd)), param(p, tmp(pp)), param(w, tmp(iw)), param(l, tmp(il))], [
    block(start, [], [
        call(tuple([result(tmp(a3), p), result(tmp(b3), p)]), global(buf_many), [arg(p, tmp(pp)), arg(s, tmp(fs)), arg(d, tmp(fd)), arg(w, tmp(iw)), arg(l, tmp(il)), arg(p, tmp(pp)), arg(p, tmp(pp)), arg(s, tmp(fs)), arg(d, tmp(fd)), arg(w, tmp(iw)), arg(l, tmp(il)), arg(p, tmp(pp)), arg(p, tmp(pp)), arg(s, tmp(fs)), arg(d, tmp(fd)), arg(w, tmp(iw)), arg(l, tmp(il)), arg(p, tmp(pp)), arg(p, tmp(pp)), arg(s, tmp(fs)), arg(d, tmp(fd)), arg(w, tmp(iw)), arg(l, tmp(il)), arg(p, tmp(pp)), arg(p, tmp(pp)), arg(s, tmp(fs)), arg(d, tmp(fd)), arg(w, tmp(iw)), arg(l, tmp(il)), arg(p, tmp(pp)), arg(p, tmp(pp)), arg(s, tmp(fs)), arg(d, tmp(fd)), arg(w, tmp(iw)), arg(l, tmp(il)), arg(p, tmp(pp)), arg(p, tmp(pp)), arg(s, tmp(fs)), arg(d, tmp(fd)), arg(w, tmp(iw)), arg(l, tmp(il)), arg(p, tmp(pp))])
    ], ret)
]).
